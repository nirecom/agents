#!/usr/bin/env bash
# Post-merge hook: re-assembles ~/.claude/settings.json when settings.json or
# settings-extension.json changed in the merge.
#
# Repo guard: core.hooksPath is globally set to agents/hooks/, so this hook fires
# in EVERY git repo on this machine. _cfg_dir is derived from $0's location under
# the globally-set core.hooksPath, so it always resolves to the agents main worktree
# root — not a linked worktree, not another repo. We exit silently for all non-agents repos.

set -u

# Use git rev-parse for both sides so path format is consistent (avoids POSIX vs Windows path mismatch)
_cfg_dir="$(cd "$(dirname "$0")/.." && git rev-parse --show-toplevel 2>/dev/null || echo '')"
_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"

# --- BEGIN codegraph sync ---
# Independent of the settings-assembly guard below, and deliberately placed BEFORE it:
# that guard exits for every repo except the agents main worktree, while a CodeGraph
# index must be refreshed wherever it exists — most importantly in linked worktrees.
# This -s test is only a cheap gate that decides whether starting Node is worth it.
# Whether the file is a real CodeGraph index is decided in the wrapper, which reads
# the schema. Repos without one pay a single stat here, never a Node startup.
if [ -n "$_repo_top" ] && [ -s "$_repo_top/.codegraph/codegraph.db" ]; then
  _cg_wrapper="$(dirname "$0")/../bin/codegraph-lifecycle.js"
  _cg_node="$(command -v node 2>/dev/null || true)"
  if [ -f "$_cg_wrapper" ] && [ -n "$_cg_node" ]; then
    "$_cg_node" "$_cg_wrapper" sync --path "$_repo_top" --quiet || true
  fi
  unset _cg_wrapper _cg_node
fi
# --- END codegraph sync ---

[ -n "$_cfg_dir" ] && [ "$_repo_top" = "$_cfg_dir" ] || exit 0

_changed="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null | tr -d '\r' || true)"
printf '%s\n' "$_changed" | grep -qE '^(settings\.json|settings-extension\.json)$' || exit 0

_node="$(command -v node 2>/dev/null || true)"
if [ -z "$_node" ]; then
  printf 'post-merge: node not found — run install.ps1 / install.sh to re-assemble settings\n' >&2
  exit 0
fi
if "$_node" "$_cfg_dir/install/assemble-settings.js" 2>/dev/null; then
  printf 'post-merge: re-assembled ~/.claude/settings.json (settings.json changed in merge)\n'
else
  printf 'post-merge: assembler failed — run install.ps1 / install.sh manually\n' >&2
fi
exit 0
