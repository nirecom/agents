#!/bin/bash
# Pre-commit hook: scan staged files for private information
# Skips scanning for private repos (detected dynamically via GitHub API)

set -euo pipefail

_cfg_dir="$(cd "$(dirname "$0")/.." && pwd)"
SCANNER="$_cfg_dir/bin/scan-outbound.sh"

# Load $AGENTS_CONFIG_DIR/.env (existing env wins). Mirrors hooks/lib/load-env.js.
# _load_env_file lives in hooks/lib/load-env.sh so it can be exercised without
# also executing this hook's guards (rules/test/fixture-isolation.md).
# shellcheck source=hooks/lib/load-env.sh
. "$_cfg_dir/hooks/lib/load-env.sh"
_load_env_file

# ENFORCE_WORKTREE defense-in-depth: block commit from main worktree or on default branch.
# Mirrors hooks/enforce-worktree.js logic. Bash-side because git hooks run outside Node.
_is_enforce_worktree_on() {
    local v
    if printenv ENFORCE_WORKTREE >/dev/null 2>&1; then
        v="$(printf %s "${ENFORCE_WORKTREE}" | tr '[:upper:]' '[:lower:]')"
    else
        v=""
    fi
    case "$v" in
        off|0|false|no|disabled) return 1 ;;
        *) return 0 ;;
    esac
}

# WORKFLOW_OFF / WORKTREE_OFF session-marker probe: mirrors enforce-worktree.js.
# Resolves the session id via hooks/workflow-state.js#resolveSessionId() and checks
# both .workflow-off and .worktree-off markers via hooks/lib/session-markers.js.
# rc=0 -> bypass granted; rc=2 -> no bypass (sid unresolved OR no marker);
# any other rc -> unexpected error (caller decides how to surface it).
# Shared by the worktree-isolation gate and the prompt-extraction backstop (CPR-SSOT).
_session_marker_off() {
    AGENTS_CONFIG_DIR="${AGENTS_CONFIG_DIR:-$_cfg_dir}" \
    node -e '
      try {
        const cfg = process.env.AGENTS_CONFIG_DIR;
        if (!cfg) process.exit(2);
        const { resolveSessionId } = require(cfg + "/hooks/workflow-state");
        const { isWorkflowOff, isWorktreeOff } = require(cfg + "/hooks/lib/session-markers");
        const sid = resolveSessionId();
        if (!sid) process.exit(2);
        if (isWorkflowOff(sid) || isWorktreeOff(sid)) process.exit(0);
        process.exit(2);
      } catch (_e) {
        process.exit(3);
      }
    ' 2>/dev/null
}

# Repo-identity probe: does the repo rooted at $1 share the agents repo's git
# common dir? A linked worktree of the agents repo therefore counts as the same
# repo, while a foreign repo routed here by a global core.hooksPath does not.
# Absolute paths are compared, so a relative spelling, a symlink or a case
# difference cannot decide identity. rc=0 -> same repo; rc!=0 -> different.
_is_agents_session_repo() {
    _isr_repo_top="$1"
    [ -n "$_isr_repo_top" ] || return 1
    _isr_cfg_dir="${AGENTS_CONFIG_DIR:-$_cfg_dir}"
    _isr_agents_common="$(git -C "$_isr_cfg_dir" rev-parse --git-common-dir 2>/dev/null || true)"
    _isr_repo_common="$(git -C "$_isr_repo_top" rev-parse --git-common-dir 2>/dev/null || true)"
    [ -n "$_isr_agents_common" ] && [ -n "$_isr_repo_common" ] || return 1
    _isr_agents_abs="$(cd "$_isr_cfg_dir" 2>/dev/null && cd "$_isr_agents_common" 2>/dev/null && pwd -P || printf '%s' "$_isr_agents_common")"
    _isr_repo_abs="$(cd "$_isr_repo_top" 2>/dev/null && cd "$_isr_repo_common" 2>/dev/null && pwd -P || printf '%s' "$_isr_repo_common")"
    [ "$_isr_agents_abs" = "$_isr_repo_abs" ]
}

if _is_enforce_worktree_on; then
    # ENFORCE_WORKTREE_EXCLUDE: unified path-coverage check via a committed Node
    # helper. Exit 0 → all staged files covered → skip the enforcement gate below.
    # Exit 2 → not all covered → run the gate. Env vars only (no shell path
    # interpolation). stderr from the helper (deprecation warnings) is preserved
    # intentionally — do NOT add 2>/dev/null here.
    _enforce_skip=0
    _staged="$(git diff --cached --name-only 2>/dev/null || true)"
    _repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$_staged" ] && [ -n "$_repo_top" ]; then
        _node_rc=0
        ENFORCE_WORKTREE_EXCLUDE="${ENFORCE_WORKTREE_EXCLUDE:-}" \
        ENFORCE_WORKTREE_EXCLUDE_REPOS="${ENFORCE_WORKTREE_EXCLUDE_REPOS:-}" \
        AGENTS_CONFIG_DIR="${AGENTS_CONFIG_DIR:-$_cfg_dir}" \
        _PRECOMMIT_REPO_TOP="$_repo_top" \
        _PRECOMMIT_STAGED="$_staged" \
        node "${AGENTS_CONFIG_DIR:-$_cfg_dir}/hooks/lib/precommit-exclude-check.js" || _node_rc=$?
        if [ "$_node_rc" = "0" ]; then
            _enforce_skip=1
        elif [ "$_node_rc" != "2" ]; then
            # rc=2 is the normal "not all covered" path. Other non-zero rc means a
            # problem (missing node, broken module, etc.) — surface it.
            echo "pre-commit: exclude-check failed (rc=$_node_rc); falling back to enforce-worktree gate." >&2
        fi
    fi

    # WORKFLOW_OFF / WORKTREE_OFF session-marker bypass (see _session_marker_off).
    # rc=0 → bypass granted; rc=2 → no bypass; any other rc → unexpected error,
    # surface a warning and fall through to enforcement.
    if [ "$_enforce_skip" = "0" ]; then
        _node_rc=0
        _session_marker_off || _node_rc=$?
        if [ "$_node_rc" = "0" ]; then
            _enforce_skip=1
        elif [ "$_node_rc" != "2" ]; then
            echo "pre-commit: session-marker bypass check failed (rc=$_node_rc); falling back to enforce-worktree gate." >&2
        fi
    fi

    # Human terminal bypass: TTY = interactive shell (not CC Bash tool pipe).
    # CC's Bash tool is always non-TTY, so this cannot be bypassed by unsetting CLAUDECODE.
    if [ -t 1 ] && [ -z "${CLAUDECODE:-}" ]; then
        _enforce_skip=1
    fi

    if [ "$_enforce_skip" = "0" ]; then
        # Block commits from main worktree (--git-common-dir == --git-dir)
        _git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
        _git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
        # Resolve to absolute paths before comparing (handles relative paths, symlinks,
        # and case differences on case-insensitive filesystems such as macOS/Windows).
        _git_common_dir_abs="$(cd "$_git_common_dir" 2>/dev/null && pwd -P || printf '%s' "$_git_common_dir" | tr '[:upper:]' '[:lower:]')"
        _git_dir_abs="$(cd "$_git_dir" 2>/dev/null && pwd -P || printf '%s' "$_git_dir" | tr '[:upper:]' '[:lower:]')"
        if [ -n "$_git_common_dir_abs" ] && [ -n "$_git_dir_abs" ] && [ "$_git_common_dir_abs" = "$_git_dir_abs" ]; then
            echo "ENFORCE_WORKTREE: commits from main worktree are blocked." >&2
            echo "Work from a linked worktree. Run: /worktree-start" >&2
            echo "Or set ENFORCE_WORKTREE=off in agents config to allow direct main work." >&2
            exit 1
        fi

        cur_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
        if [ -n "$cur_branch" ]; then
            # Build protected branches list
            protected=""
            _default_branches_var="${DEFAULT_BRANCHES:-}"
            if [ -n "$_default_branches_var" ]; then
                protected="$(printf %s "$_default_branches_var" | tr ',' ' ')"
            else
                origin_head="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#.*/##' || true)"
                [ -n "$origin_head" ] && protected="$protected $origin_head"
                for cand in main master; do
                    git show-ref --verify --quiet "refs/heads/$cand" 2>/dev/null && protected="$protected $cand"
                done
                init_default="$(git config init.defaultBranch 2>/dev/null || true)"
                [ -n "$init_default" ] && protected="$protected $init_default"
                [ -z "$(printf %s "$protected" | tr -d ' ')" ] && protected="main"
            fi
            for b in $protected; do
                if [ "$cur_branch" = "$b" ]; then
                    echo "ENFORCE_WORKTREE: commits to protected branch '$cur_branch' are blocked." >&2
                    echo "Switch to a feature branch. Run: git switch -c feature/<name>" >&2
                    echo "Or set ENFORCE_WORKTREE=off in agents config to disable." >&2
                    exit 1
                fi
            done
        fi
    fi
fi

# Auto-unstage settings.json if the only change is effortLevel
SETTINGS="settings.json"
if git diff --cached --name-only | grep -qx "$SETTINGS"; then
    # Compare HEAD vs staged after stripping effortLevel from both
    STRIP_EFFORT='let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>{const j=JSON.parse(d);delete j.effortLevel;console.log(JSON.stringify(j))})'
    HEAD_CLEAN="$(git show "HEAD:$SETTINGS" 2>/dev/null | node -e "$STRIP_EFFORT" 2>/dev/null || true)"
    STAGED_CLEAN="$(git show ":$SETTINGS" 2>/dev/null | node -e "$STRIP_EFFORT" 2>/dev/null || true)"
    if [ -n "$HEAD_CLEAN" ] && [ "$HEAD_CLEAN" = "$STAGED_CLEAN" ]; then
        git reset HEAD -- "$SETTINGS" >/dev/null 2>&1
        echo "pre-commit: auto-unstaged $SETTINGS (effortLevel-only change)"
    fi
fi

# Language check: block commits with non-permitted language (CODE_LANG).
# Off by default: skip entirely when CODE_LANG is unset/empty so the common case
# spawns no node process and emits no output. classifyPolicy() in
# hooks/lib/lang-config.js remains the SSOT for what each non-empty value means;
# this guard only short-circuits the trivially-unset case.
# Repo-level exclusion is evaluated inside the node module via CODE_LANG_EXCLUDE;
# a matched exclusion prints a one-line audit trace (below) rather than skipping
# silently. If the repo root cannot be determined it throws, and the catch below
# fails open ("lint-commit-lang skipped").
if [ -n "${CODE_LANG:-}" ]; then
    _lang_cfg_dir="${AGENTS_CONFIG_DIR:-$_cfg_dir}"
    if command -v cygpath >/dev/null 2>&1; then
        _lang_cfg_dir="$(cygpath -m "$_lang_cfg_dir")"
    fi
    _lang_node_rc=0
    AGENTS_CONFIG_DIR="$_lang_cfg_dir" \
    node -e '
      try {
        var cfg = process.env.AGENTS_CONFIG_DIR;
        var m = require(cfg + "/hooks/lib/lint-commit-lang");
        var r = m.check();
        if (r.excluded) {
          process.stderr.write("lint-commit-lang: skipped (CODE_LANG_EXCLUDE match)\n");
        }
        if (r.violations && r.violations.length > 0) {
          r.violations.slice(0, 10).forEach(function(v) {
            process.stderr.write("  " + v.file + ":" + v.lineNumber + ": " + v.line.slice(0,80) + "\n");
          });
          process.exit(1);
        }
        if (r.hints && r.hints.length > 0) {
          r.hints.slice(0, 5).forEach(function(h) {
            process.stderr.write("  hint: " + h.file + ":" + h.lineNumber + ": " + h.line.slice(0,80) + "\n");
          });
        }
      } catch (e) {
        // Fail open: a missing module or runtime error must never block a commit;
        // the language policy is advisory infrastructure, not a hard gate.
        process.stderr.write("pre-commit: lint-commit-lang skipped (" + e.message + ")\n");
        process.exit(0);
      }
    ' 2>&1 || _lang_node_rc=$?
    if [ "$_lang_node_rc" != "0" ]; then
        echo ""
        echo "Commit blocked: CODE_LANG policy violation in staged files."
        echo "Fix the issues above, or add 'lang-check: ignore' anywhere in the file to bypass."
        exit 1
    fi
fi

# Check execute permission on staged .sh files
SH_NO_EXEC=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    mode=$(git ls-files -s "$f" | awk '{print $1}')
    if [ "$mode" = "100644" ]; then
        SH_NO_EXEC="$SH_NO_EXEC\n  $f"
    fi
done <<< "$(git diff --cached --name-only -- '*.sh')"
if [ -n "$SH_NO_EXEC" ]; then
    echo "pre-commit: .sh files lacking execute permission:$SH_NO_EXEC"
    echo "Run: git update-index --chmod=+x <file>"
    exit 1
fi

# ---------- prompt-extraction backstop (issue #1642) ----------
# Defense-in-depth for workflow-gate.js Gate 3: catches commits that never pass
# through the Claude Code Bash tool (terminal, editor, script).
#
# Two-condition AND guard:
#   (a) the repo under commit IS the agents session repo (git common-dir match)
#   (b) .prompt-extraction-allowlist exists at that repo root
# Both must hold. Allowlist presence alone must never arm the backstop in a
# foreign repo, even when a global core.hooksPath routes that repo here
# (install/linux/dotfileslink.sh) — CPR-UNV: no implicit environment branching.
#
# Exit-code mapping: 1 -> block; anything else -> warn on stderr and continue.
# The backstop is a safety net, not an availability dependency.
_pe_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$_pe_repo_top" ] && [ -f "$_pe_repo_top/.prompt-extraction-allowlist" ]; then
    _pe_cfg_dir="${AGENTS_CONFIG_DIR:-$_cfg_dir}"
    _pe_is_agents_repo=0
    if _is_agents_session_repo "$_pe_repo_top"; then
        _pe_is_agents_repo=1
    fi

    if [ "$_pe_is_agents_repo" = "1" ]; then
        _pe_skip=0
        _pe_marker_rc=0
        _session_marker_off || _pe_marker_rc=$?
        if [ "$_pe_marker_rc" = "0" ]; then
            _pe_skip=1
        elif [ "$_pe_marker_rc" != "2" ]; then
            echo "pre-commit: _session_marker_off rc=$_pe_marker_rc — prompt-extraction backstop check continues" >&2
        fi

        if [ "$_pe_skip" = "0" ]; then
            _pe_rc=0
            _pe_out="$("$_pe_cfg_dir/bin/check-prompt-extraction" --staged 2>&1)" || _pe_rc=$?
            case "$_pe_rc" in
                0) : ;;
                1)
                    printf '%s\n' "$_pe_out"
                    echo ""
                    echo "Commit blocked: prompt extraction violations in staged files."
                    echo "Extract the content (rules/prompt.md §1.3 / §1.5), or unstage the file."
                    exit 1
                    ;;
                2)
                    # Broken install, not an environment hiccup: the workflow-gate
                    # fails closed on the same condition, so the backstop must too.
                    printf '%s\n' "$_pe_out" >&2
                    echo "" >&2
                    echo "Commit blocked: check-prompt-extraction usage error (rc=2)." >&2
                    echo "The prompt-extraction backstop is misinstalled — fix the invocation before committing." >&2
                    exit 1
                    ;;
                126|127)
                    echo "Commit blocked: check-prompt-extraction not found or not executable (rc=$_pe_rc)." >&2
                    echo "Expected at: $_pe_cfg_dir/bin/check-prompt-extraction" >&2
                    exit 1
                    ;;
                *)
                    # rc=3 and anything else: genuine infrastructure error — fail open.
                    echo "pre-commit: check-prompt-extraction rc=$_pe_rc — prompt-extraction backstop skipped" >&2
                    ;;
            esac
        fi
    fi
fi

# Check scope tag on staged tests/*.sh files
_staged_tests=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    tests/_archive/*) continue ;;
    tests/*.sh) _staged_tests="$_staged_tests $f" ;;
  esac
done <<< "$(git diff --cached --name-only -- 'tests/*.sh')"
if [ -n "$_staged_tests" ]; then
  # shellcheck disable=SC2086
  if ! "$_cfg_dir/bin/check-test-frontmatter.sh" --staged $_staged_tests; then
    echo ""
    echo "Commit blocked: staged tests/*.sh file(s) fail frontmatter validation."
    echo "Each file must have '# Tests: <path>' (comma-separated tokens) and '# Tags: ... scope:...'."
    exit 1
  fi
fi

# --- on-demand rules-injection notation gate (detail plan S2-7) -------------------
# Why here: a rule that disables auto-injection does so with a reserved `paths:` glob
# plus a marker comment. Nothing in the host loader validates that pairing, so the only
# moment the drift can still be stopped cheaply is before the commit lands.
#
# Own agents-repo guard, deliberately independent of the prompt-extraction block above:
# that one is additionally gated on .prompt-extraction-allowlist, and reusing its
# variables would silently couple this gate to a file it has nothing to do with.
#
# Exit-code mapping (asserted by tests/cc-pre-commit-on-demand-rules.sh):
#   1 (violations) and 2 (usage / broken invocation) -> block
#   anything else, including a missing or non-executable checker -> warn and continue.
# The fail-open half differs from the prompt-extraction backstop on purpose: this gate
# guards a notation convention, not an outbound-content leak, so a checkout that
# predates the checker must still be able to commit — but never silently.
_od_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$_od_repo_top" ]; then
    _od_cfg_dir="${AGENTS_CONFIG_DIR:-$_cfg_dir}"
    _od_is_agents_repo=0
    # -u GIT_DIR/GIT_WORK_TREE/GIT_PREFIX: git invokes this hook with those set for the
    # repo being committed to, and an inherited GIT_DIR silently overrides -C's target
    # directory for repo discovery -- without the unset, both calls below resolve to the
    # committing repo regardless of $_od_cfg_dir, producing a false agents-repo match for
    # every repo.
    _od_agents_common="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX git -C "$_od_cfg_dir" rev-parse --git-common-dir 2>/dev/null || true)"
    _od_repo_common="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX git -C "$_od_repo_top" rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$_od_agents_common" ] && [ -n "$_od_repo_common" ]; then
        _od_agents_abs="$(cd "$_od_cfg_dir" 2>/dev/null && cd "$_od_agents_common" 2>/dev/null && pwd -P || printf '%s' "$_od_agents_common")"
        _od_repo_abs="$(cd "$_od_repo_top" 2>/dev/null && cd "$_od_repo_common" 2>/dev/null && pwd -P || printf '%s' "$_od_repo_common")"
        [ "$_od_agents_abs" = "$_od_repo_abs" ] && _od_is_agents_repo=1
    fi

    if [ "$_od_is_agents_repo" = "1" ]; then
        # NUL-delimited: without -z git applies quotePath to a name containing a
        # newline or a non-ASCII byte, and the filename identity is destroyed before
        # the checker ever sees it. mapfile -d '' keeps one name = one array element.
        _od_staged=()
        while IFS= read -r -d '' _od_f; do
            case "$_od_f" in
                rules/*.md|hooks/lib/rules-injection-policy.js) _od_staged+=("$_od_f") ;;
            esac
        done < <(git diff --cached --name-only -z 2>/dev/null || true)

        # The checker runs on every agents-repo commit, not only when a rules file is
        # staged: the notation contract is a property of the whole tree (a policy-only
        # edit can break a rule it never touched, and some filenames git cannot even
        # stage on this platform). The staged list is still passed so out-of-root paths
        # are surfaced; an empty list is a valid invocation.
        _od_checker="$_od_cfg_dir/bin/check-on-demand-rules.sh"
        if [ ! -x "$_od_checker" ]; then
            echo "pre-commit: check-on-demand-rules.sh missing or not executable at $_od_checker — on-demand rules notation gate skipped" >&2
        else
            _od_rc=0
            _od_out="$("$_od_checker" --staged ${_od_staged[@]+"${_od_staged[@]}"} 2>&1)" || _od_rc=$?
            case "$_od_rc" in
                0) : ;;
                1|2)
                    printf '%s\n' "$_od_out"
                    echo ""
                    echo "Commit blocked: on-demand rules-injection notation violations (checker rc=$_od_rc)."
                    echo "See docs/architecture/claude-code/rules-injection.md."
                    exit 1
                    ;;
                *)
                    echo "pre-commit: check-on-demand-rules.sh rc=$_od_rc — on-demand rules notation gate skipped" >&2
                    ;;
            esac
        fi
    fi
fi

# settings.json allow-rule drift gate (#2119): catches install/settings-allow-commands.txt
# and settings.json diverging, fail-closed (missing/non-executable reviewer blocks; only
# rc 0 passes). Arms only when this repo IS the agents session repo AND carries the gate's
# own inputs, so an unrelated repo stays untouched. Details: docs/architecture/claude-code/settings.md.
_sa_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_sa_armed=0
if [ -n "$_sa_repo_top" ]; then
    if [ -f "$_sa_repo_top/install/settings-allow-commands.txt" ] || [ -f "$_sa_repo_top/install/gen-settings-allow.js" ]; then
        _sa_armed=1
    fi
fi
if [ "$_sa_armed" = "1" ] && (unset AGENTS_CONFIG_DIR; _is_agents_session_repo "$_sa_repo_top"); then
    _sa_cfg_dir="${AGENTS_CONFIG_DIR:-$_cfg_dir}"
    _sa_reviewer="$_sa_cfg_dir/bin/review-settings-allow"
    if [ ! -x "$_sa_reviewer" ]; then
        echo "Commit blocked: review-settings-allow is missing or not executable." >&2
        echo "Expected at: $_sa_reviewer" >&2
        echo "The settings.json allow-rule gate fails closed — restore the reviewer before committing." >&2
        exit 1
    fi
    _sa_rc=0
    _sa_out="$("$_sa_reviewer" 2>&1)" || _sa_rc=$?
    if [ "$_sa_rc" != "0" ]; then
        printf '%s\n' "$_sa_out"
        echo ""
        echo "Commit blocked: review-settings-allow reported a finding or an outage (rc=$_sa_rc)."
        echo "Run: node install/gen-settings-allow.js --write"
        exit 1
    fi
fi

# ---------- comment-block size gate (issue #1894) ----------
# Blocking, but only on the scanner's rc 1 — that value is the verdict "staged
# code grew an over-threshold comment run". Every other non-zero rc is an
# outage, not a violation, and must leave the commit alone with a diagnostic
# (CPR-SC). Two-condition AND guard, same shape as the issue #1642 backstop
# above: a global core.hooksPath routes every repo on this machine through this
# hook, so both repo identity and scanner availability are checked (CPR-UNV).
#
# Deliberately not suspendable: this gate consults no per-session escape state,
# by omission (outline plan accepted tradeoff).
_cb_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_cb_script="$_cfg_dir/bin/review-comment-block-size"
if (unset AGENTS_CONFIG_DIR; _is_agents_session_repo "$_cb_repo_top") && [ -x "$_cb_script" ]; then
    # Resolve strictly from $_cfg_dir (this hook's real installed location,
    # from $0 — not settable by the invoker). The generic _load_env_only_value
    # honours ambient AGENTS_CONFIG_DIR via _load_env_cfg_dir, which would let
    # `AGENTS_CONFIG_DIR=<elsewhere> git commit` repoint COMMENT_BLOCK_ENFORCE
    # at an attacker-controlled .env even after (a)/(b) above stop trusting it
    # for identity and the scanner path.
    _cb_envfile="$_cfg_dir/.env"
    _cb_filter="$_cfg_dir/bin/env-os-filter"
    _cb_env_value() {
        local spec="$1" key def out=""
        key="${spec%%:-*}"
        if [ "$key" = "$spec" ]; then def=""; else def="${spec#*:-}"; fi
        [ -r "$_cb_envfile" ] && out="$(_load_env_only_scan "$_cb_envfile" "$key" "$_cb_filter")"
        [ -n "$out" ] || out="$def"
        printf '%s' "$out"
    }
    # Read from the config dir's .env ONLY. Consulting the ambient value would
    # make `COMMENT_BLOCK_ENFORCE=off git commit` a one-word bypass of the gate.
    _cb_enforce="$(_cb_env_value "COMMENT_BLOCK_ENFORCE:-on")"
    # --- BEGIN temporary: COMMENT_BLOCK_WARN* → COMMENT_BLOCK_MAX_LINES/ENFORCE migration ---
    # The old names are INERT, not dual-read: honouring a stale COMMENT_BLOCK_WARN=off
    # would let a setting written to silence a warning switch a block off.
    _cb_obsolete="$(_cb_env_value "COMMENT_BLOCK_WARN")$(_cb_env_value "COMMENT_BLOCK_WARN_LINES")"
    if [ -n "$_cb_obsolete" ]; then
        echo "NOTE: COMMENT_BLOCK_WARN* is obsolete — use COMMENT_BLOCK_MAX_LINES / COMMENT_BLOCK_ENFORCE" >&2
    fi
    # --- END temporary: COMMENT_BLOCK_WARN* → COMMENT_BLOCK_MAX_LINES/ENFORCE migration ---
    if [ "$_cb_enforce" = "off" ]; then
        # A disabled blocking check that says nothing is indistinguishable from a
        # check that keeps passing, which is how a gate quietly stops existing.
        echo "pre-commit: comment-block size gate disabled by COMMENT_BLOCK_ENFORCE=off" >&2
    else
        # Pre-initialised: `|| _cb_rc=$?` leaves them unset on the success path,
        # and `set -u` would then abort an otherwise clean commit.
        _cb_out=""
        _cb_rc=0
        _cb_out="$("$_cb_script" --staged 2>&1)" || _cb_rc=$?
        if [ "$_cb_rc" = "1" ]; then
            printf '%s\n' "$_cb_out"
            echo ""
            echo "Commit blocked: staged code carries over-threshold comment blocks."
            echo "Compress them, or see rules/coding/file-split.md (Pattern A)."
            exit 1
        elif [ "$_cb_rc" != "0" ]; then
            echo "pre-commit: review-comment-block-size rc=$_cb_rc — comment-block check incomplete (commit continues)" >&2
            if [ -n "$_cb_out" ]; then
                printf '%s\n' "$_cb_out" >&2
            fi
        elif printf '%s\n' "$_cb_out" | grep -q ': SKIPPED'; then
            echo "pre-commit: comment-block size check SKIPPED — scanner did not run (commit continues)" >&2
        fi
    fi
fi

# Check if this repo is private via GitHub API (skip scanning if private)
REMOTE_URL="$(git remote get-url origin 2>/dev/null || true)"
if [ -n "$REMOTE_URL" ]; then
    # Extract hostname — non-GitHub hosts are treated as private (skip scanning)
    REMOTE_HOST="$(echo "$REMOTE_URL" | sed -E 's#^(ssh|https?)://([^@]+@)?([^/:]+).*#\3#' | sed -E 's#^[^@]+@([^:]+):.*#\1#')"
    if [ -n "$REMOTE_HOST" ] && [ "$REMOTE_HOST" != "github.com" ]; then
        exit 0
    fi
    REPO_ID="$(echo "$REMOTE_URL" | sed 's/\.git$//' | sed -E 's#.*[:/]([^/]+/[^/]+)$#\1#')"
    if [ -n "$REPO_ID" ] && command -v gh >/dev/null 2>&1; then
        IS_PRIVATE="$(gh api "repos/$REPO_ID" --jq .private 2>/dev/null || true)"
        if [ "$IS_PRIVATE" = "true" ]; then
            exit 0
        fi
    fi
fi

# Block direct commits of .env files (use .env.example / .env.sample / .env.template instead)
ENV_FILES="$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)\.env$' || true)"
if [ -n "$ENV_FILES" ]; then
    echo "pre-commit: .env file(s) staged for commit:"
    echo "$ENV_FILES" | sed 's/^/  /'
    echo "Use .env.example / .env.sample / .env.template instead."
    exit 1
fi

# Get staged files (added, copied, modified)
STAGED_FILES="$(git diff-index --cached --name-only --diff-filter=ACM HEAD 2>/dev/null || true)"
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Files to skip
SKIP_PATTERNS="bin/scan-outbound.sh|\.private-info-allowlist|\.offensive-content-blocklist\.example"

HARD_HITS=0
WARN_HITS=0
HARD_OUT=""
WARN_OUT=""

while IFS= read -r file; do
    # Skip scanner-related files
    if echo "$file" | grep -qE "$SKIP_PATTERNS"; then
        continue
    fi

    # Skip binary files
    if git show ":$file" 2>/dev/null | file --mime - 2>/dev/null | grep -q "binary"; then
        continue
    fi

    # Scan staged content. IMPORTANT: capture rc with `|| rc=$?` — under
    # `set -euo pipefail` the assignment would otherwise abort the hook on
    # non-zero scanner exit before the case below could branch.
    SCAN_OUT=""
    rc=0
    SCAN_OUT="$(git show ":$file" 2>/dev/null | "$SCANNER" --stdin "$file" 2>&1)" || rc=$?
    case "$rc" in
        0) : ;;
        1) HARD_HITS=$((HARD_HITS + 1)); HARD_OUT="$HARD_OUT"$'\n'"$SCAN_OUT" ;;
        2) WARN_HITS=$((WARN_HITS + 1)); WARN_OUT="$WARN_OUT"$'\n'"$SCAN_OUT" ;;
        3) echo "pre-commit: scanner usage error (rc=3)" >&2; exit 1 ;;
        *) echo "pre-commit: scanner unexpected rc=$rc" >&2; exit 1 ;;
    esac
done <<< "$STAGED_FILES"

# Hard wins: any hard violation blocks immediately.
if [ "$HARD_HITS" -gt 0 ]; then
    [ -n "$HARD_OUT" ] && printf '%s\n' "$HARD_OUT"
    [ -n "$WARN_OUT" ] && printf '%s\n' "$WARN_OUT"
    echo ""
    echo "Commit blocked: private information detected in staged files."
    echo "Fix the issues above, or add exceptions to .private-info-allowlist"
    exit 1
fi

# Warn-only path: re-display matches, then prompt or auto-block.
if [ "$WARN_HITS" -gt 0 ]; then
    printf '%s\n' "$WARN_OUT"
    echo ""
    if { : <>/dev/tty; } 2>/dev/null; then
        printf "Possible private info above. Proceed with commit? [y/N] " > /dev/tty
        REPLY=""
        read -r REPLY < /dev/tty || REPLY=""
        case "$REPLY" in
            y|Y|yes|YES) echo "pre-commit: warn-only confirmed by user"; exit 0 ;;
            *) echo "pre-commit: aborted by user"; exit 1 ;;
        esac
    else
        echo "Commit blocked: warn-only patterns detected (no TTY available — auto-blocked)."
        echo "Re-run interactively or add an exception to .private-info-allowlist."
        exit 1
    fi
fi
exit 0
