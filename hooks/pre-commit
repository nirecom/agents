#!/bin/bash
# Pre-commit hook entry (#2507, D1): runs the Node body hooks/pre-commit.d/main.js and keeps
# only the /dev/tty y/N confirmation of a warn-only outbound-scan hit, which Node on Windows
# cannot open. Check order and contracts: hooks/pre-commit.d/registry.js.

set -uo pipefail

_cfg_dir="$(cd "$(dirname "$0")/.." && pwd)"
# Mirrors CONFIRM_WARN of hooks/pre-commit.d/main.js.
_confirm_warn=10

if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found on PATH — the pre-commit checks cannot run, so the commit is blocked." >&2
    echo "Install Node.js (see rules/coding/nodejs.md). Emergency bypass: git commit --no-verify" >&2
    exit 1
fi

_rc=0
node "$_cfg_dir/hooks/pre-commit.d/main.js" || _rc=$?
[ "$_rc" = "$_confirm_warn" ] || exit "$_rc"

# Warn-only path: main.js has printed the matches; prompt on the terminal or auto-block.
if { : <>/dev/tty; } 2>/dev/null; then
    printf "Possible private info above. Proceed with commit? [y/N] " > /dev/tty
    REPLY=""
    read -r REPLY < /dev/tty || REPLY=""
    case "$REPLY" in
        y|Y|yes|YES) echo "pre-commit: warn-only confirmed by user"; exit 0 ;;
        *) echo "pre-commit: aborted by user"; exit 1 ;;
    esac
fi
echo "Commit blocked: warn-only patterns detected (no TTY available — auto-blocked)."
echo "Re-run interactively or add an exception to .private-info-allowlist."
exit 1
