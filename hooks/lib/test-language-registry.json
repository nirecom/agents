{
  "schema": 1,
  "headerMaxLines": 10,
  "tableDrivenFallbackEntry": "bash",
  "entries": [
    {
      "id": "bash",
      "status": "supported",
      "patterns": ["*.sh"],
      "selfIdentifying": false,
      "nameStrip": { "prefix": "", "suffix": ".sh" },
      "siblingSuiteDir": true,
      "header": { "commentPrefix": "#" },
      "launch": { "unit": "file", "requires": null, "prepare": null, "command": ["bash", "{path}"], "timeoutSeconds": null, "suiteRootMarker": null },
      "caseMarkerReader": { "file": "bin/lib/test-retire-predicate/case-parser.sh", "function": "trp_parse_case_markers" },
      "caseEmbedRules": { "file": "bin/lib/test-language-parts/bash-case-embed.sh", "function": "bash_case_embed" },
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/bash.sh", "function": "has_table_driven_sh" },
      "helperLibrary": { "path": "tests/lib/harness.sh", "sourceRegex": "^[[:space:]]*(source|\\.)[[:space:]]+([^#]*/)?tests/lib/harness\\.sh" },
      "diagnostics": { "nameLabel": ".sh", "flatRejectCode": "FLAT_TEST_SH_REJECTED" },
      "note": "Only entry with a case-marker reader and a helper library, so the case-marker gate, dup groups and the harness check stay bash-only. A same-name sibling directory holds a split test's sub-files and retires with it. bash's own exit 77 is a test result, so the launcher runs it unwrapped."
    },
    {
      "id": "pester",
      "status": "supported",
      "patterns": ["*.Tests.ps1"],
      "selfIdentifying": true,
      "nameStrip": { "prefix": "", "suffix": ".Tests.ps1" },
      "siblingSuiteDir": false,
      "header": { "commentPrefix": "#" },
      "launch": {
        "unit": "file",
        "requires": "pwsh",
        "prepare": null,
        "command": ["pwsh", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{wrapper}", "-Path", "{nativePath}", "-MinVersion", "{minVersion}"],
        "wrapper": "bin/lib/test-wrappers/pester.ps1",
        "minVersion": { "runtime": "Pester", "version": "5.0" },
        "timeoutSeconds": 180,
        "suiteRootMarker": null
      },
      "caseMarkerReader": null,
      "caseEmbedRules": null,
      "tableDrivenDetector": null,
      "helperLibrary": null,
      "diagnostics": { "nameLabel": ".Tests.ps1" },
      "note": "The wrapper takes the path as a -File argument, so nothing in the name is evaluated; it writes testResults.xml into the result directory, never the working directory. -ExecutionPolicy Bypass applies to this process only."
    },
    {
      "id": "pytest",
      "status": "supported",
      "patterns": ["test_*.py"],
      "selfIdentifying": true,
      "nameStrip": { "prefix": "", "suffix": ".py" },
      "siblingSuiteDir": false,
      "header": { "commentPrefix": "#" },
      "launch": {
        "unit": "file",
        "requires": "uv",
        "prepare": null,
        "command": ["uv", "run", "--no-project", "--with", "pytest>={minVersion}", "python", "{wrapper}", "{nativePath}", "{minVersion}"],
        "wrapper": "bin/lib/test-wrappers/pytest.py",
        "minVersion": { "runtime": "pytest", "version": "7.0" },
        "timeoutSeconds": 180,
        "suiteRootMarker": null
      },
      "caseMarkerReader": null,
      "caseEmbedRules": null,
      "tableDrivenDetector": null,
      "helperLibrary": null,
      "diagnostics": { "nameLabel": "test_*.py" },
      "note": "uv supplies pytest per run, so no project environment is needed. The agents installer pre-fetches pytest into uv's cache, so a uv that cannot supply it fails the run as FAIL."
    },
    {
      "id": "js",
      "status": "supported",
      "patterns": ["*.js"],
      "selfIdentifying": false,
      "nameStrip": { "prefix": "", "suffix": ".js" },
      "siblingSuiteDir": false,
      "header": { "commentPrefix": "//" },
      "launch": {
        "unit": "file",
        "requires": "node",
        "prepare": null,
        "command": ["node", "{wrapper}", "{nativePath}", "{minVersion}"],
        "wrapper": "bin/lib/test-wrappers/node.js",
        "minVersion": { "runtime": "node", "version": "20.0" },
        "timeoutSeconds": 180,
        "suiteRootMarker": null
      },
      "caseMarkerReader": null,
      "caseEmbedRules": null,
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/js.sh", "function": "has_table_driven_js" },
      "helperLibrary": null,
      "diagnostics": { "nameLabel": ".js" },
      "note": "Not selfIdentifying: a .js file is a test only directly under a tests/<category>/ directory. The wrapper runs a node:test file under node --test with a case reporter, and any other file as a plain node script."
    },
    {
      "id": "test-naming-convention",
      "status": "recognized-only",
      "patterns": ["*.test.*", "*.spec.*", "*_test.*", "test_*"],
      "selfIdentifying": true,
      "nameStrip": { "prefix": "", "suffix": "" },
      "siblingSuiteDir": false,
      "header": null,
      "launch": null,
      "caseMarkerReader": null,
      "caseEmbedRules": null,
      "tableDrivenDetector": null,
      "helperLibrary": null,
      "diagnostics": {},
      "note": "Naming conventions that mark a file as a test by name alone in any language. Never launched."
    }
  ]
}
