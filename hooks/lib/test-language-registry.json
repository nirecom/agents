    {
      "id": "bash",
      "status": "supported",
      "patterns": ["*.sh"],
      "selfIdentifying": false,
      "nameStrip": { "prefix": "", "suffix": ".sh" },
      "issueNamePrefix": "",
      "siblingSuiteDir": true,
      "header": { "commentPrefix": "#" },
      "launch": { "unit": "file", "requires": null, "prepare": null, "command": ["bash", "{path}"], "timeoutSeconds": null, "suiteRootMarker": null },
      "caseMarkerReader": { "file": "bin/lib/test-retire-predicate/case-parser.sh", "function": "trp_parse_case_markers", "node": { "file": "hooks/lib/test-gates/parts/bash-case-reader.js", "function": "read" } },
      "caseEmbedRules": { "file": "bin/lib/test-language-parts/bash-case-embed.sh", "function": "bash_case_embed", "node": { "file": "hooks/lib/test-gates/parts/bash-case-embed.js", "function": "run" } },
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/bash.sh", "function": "has_table_driven_sh" },
      "envClearLine": { "file": "hooks/lib/test-gates/parts/env-clear/bash.js", "function": "envClearLine" },
      "helperLibrary": { "path": "tests/lib/harness.sh", "sourceRegex": "^[[:space:]]*(source|\\.)[[:space:]]+([^#]*/)?tests/lib/harness\\.sh" },
      "codeLanguage": { "sourcePatterns": ["*.sh"], "shebangInterpreters": ["bash", "sh"] },
      "newFileNameShape": "<name>.sh",
      "notationDoc": "skills/_shared/test-design/case-markers/bash.md",
      "diagnostics": {
        "nameLabel": ".sh",
        "flatRejectCode": "FLAT_TEST_SH_REJECTED",
        "markerName": "case_begin/case_end",
        "markerWrapHint": "Wrap each case in column-0 case_begin/case_end at depth 0",
        "markerMissingHint": "Wrap each case in case_begin/case_end (tests/lib/harness.sh)",
        "markerUncertainHint": "multi-line quoted string before the marker; use a heredoc so retire can split cases",
        "markerDoc": "skills/_shared/test-design/case-markers.md"
      },
      "note": "A same-name sibling directory holds a split test's sub-files and retires with it. bash's own exit 77 is a test result, so the launcher runs it unwrapped. diagnostics.markerDoc is the document the gate messages name; an entry without it names its notationDoc."
    },
    {
      "id": "pester",
      "status": "supported",
      "patterns": ["*.Tests.ps1"],
      "selfIdentifying": true,
      "nameStrip": { "prefix": "", "suffix": ".Tests.ps1" },
      "issueNamePrefix": "",
      "siblingSuiteDir": false,
      "header": { "commentPrefix": "#" },
      "launch": {
        "unit": "file",
        "requires": "pwsh",
        "prepare": null,
        "command": ["pwsh", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{wrapper}", "-Path", "{nativePath}", "-MinVersion", "{minVersion}"],
        "wrapper": "bin/lib/test-wrappers/pester.ps1",
        "minVersion": { "runtime": "Pester", "version": "5.0" },
        "timeoutSeconds": 180,
        "suiteRootMarker": null
      },
      "caseMarkerReader": { "file": "bin/lib/test-language-parts/pester.sh", "function": "pester_case_markers", "node": { "file": "hooks/lib/test-gates/parts/external-runtime.js", "function": "reader" } },
      "caseEmbedRules": { "file": "bin/lib/test-language-parts/pester-case-embed.sh", "function": "pester_case_embed", "node": { "file": "hooks/lib/test-gates/parts/external-runtime.js", "function": "analyzer" } },
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/pester.sh", "function": "has_table_driven_pester" },
      "envClearLine": { "file": "hooks/lib/test-gates/parts/env-clear/pester.js", "function": "envClearLine" },
      "helperLibrary": { "path": "tests/lib/harness.ps1", "sourceRegex": "^[[:space:]]*\\.[[:space:]]+[^#]*lib['\"]?[[:space:]/\\\\]+['\"]?harness\\.ps1" },
      "codeLanguage": { "sourcePatterns": ["*.ps1", "*.psm1"], "shebangInterpreters": ["pwsh"] },
      "newFileNameShape": "<name>.Tests.ps1",
      "notationDoc": "skills/_shared/test-design/case-markers/pester.md",
      "diagnostics": {
        "nameLabel": ".Tests.ps1",
        "markerName": "Describe -Tag 'target:<path>'",
        "markerWrapHint": "Give every top-level Describe a -Tag 'target:<path>' naming the file it tests"
      },
      "note": "The wrapper takes the path as a -File argument, so nothing in the name is evaluated; it writes testResults.xml into the result directory, never the working directory. -ExecutionPolicy Bypass applies to this process only."
    },
    {
      "id": "pytest",
      "status": "supported",
      "patterns": ["test_*.py"],
      "selfIdentifying": true,
      "nameStrip": { "prefix": "", "suffix": ".py" },
      "issueNamePrefix": "test_",
      "siblingSuiteDir": false,
      "header": { "commentPrefix": "#" },
      "launch": {
        "unit": "file",
        "requires": "uv",
        "prepare": null,
        "command": ["uv", "run", "--no-project", "--with", "pytest>={minVersion}", "python", "{wrapper}", "{nativePath}", "{minVersion}"],
        "wrapper": "bin/lib/test-wrappers/pytest.py",
        "minVersion": { "runtime": "pytest", "version": "7.0" },
        "timeoutSeconds": 180,
        "suiteRootMarker": null
      },
      "caseMarkerReader": { "file": "bin/lib/test-language-parts/pytest.sh", "function": "pytest_case_markers", "node": { "file": "hooks/lib/test-gates/parts/external-runtime.js", "function": "reader" } },
      "caseEmbedRules": { "file": "bin/lib/test-language-parts/pytest-case-embed.sh", "function": "pytest_case_embed", "node": { "file": "hooks/lib/test-gates/parts/external-runtime.js", "function": "analyzer" } },
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/pytest.sh", "function": "has_table_driven_pytest" },
      "envClearLine": { "file": "hooks/lib/test-gates/parts/env-clear/pytest.js", "function": "envClearLine" },
      "helperLibrary": { "path": "tests/lib/harness.py", "sourceRegex": "^(import harness([[:space:]]|$)|from harness import[[:space:]])" },
      "codeLanguage": { "sourcePatterns": ["*.py"], "shebangInterpreters": ["python3", "python"] },
      "newFileNameShape": "test_<name>.py",
      "notationDoc": "skills/_shared/test-design/case-markers/pytest.md",
      "diagnostics": {
        "nameLabel": "test_*.py",
        "markerName": "@pytest.mark.target",
        "markerWrapHint": "Decorate every top-level test with @pytest.mark.target(\"<path>\") naming the file it tests"
      },
      "note": "uv supplies pytest per run, so no project environment is needed. The agents installer pre-fetches pytest into uv's cache, so a uv that cannot supply it fails the run as FAIL."
    },
    {
