      "caseEmbedRules": { "file": "bin/lib/test-language-parts/js-case-embed.sh", "function": "js_case_embed", "node": { "file": "bin/lib/test-language-parts/js-case-analyzer.js", "function": "analyze" } },
      "tableDrivenDetector": { "file": "bin/lib/test-language-parts/js.sh", "function": "has_table_driven_js" },
      "envClearLine": { "file": "hooks/lib/test-gates/parts/env-clear/js.js", "function": "envClearLine" },
      "helperLibrary": { "path": "tests/lib/harness.js", "sourceRegex": "^[^/]*require\\([\"']\\.\\./lib/harness(\\.js)?[\"']\\)" },
      "codeLanguage": { "sourcePatterns": ["*.js", "*.cjs", "*.mjs"], "shebangInterpreters": ["node"] },
      "newFileNameShape": "<name>.js",
      "notationDoc": "skills/_shared/test-design/case-markers/js.md",
      "diagnostics": {
        "nameLabel": ".js",
        "markerName": "caseBegin/caseEnd",
        "markerWrapHint": "Wrap each case in column-0 caseBegin(\"<name>\", \"<target>\") and caseEnd() calls",
        "markerUncertainHint": "a caseBegin/caseEnd-looking line sits inside a block comment or a multi-line template string; move it out so the cases can be read line by line"
      },
      "newEntrypointRunner": {
        "rejectSkipReason": "custom-runner",
        "hint": "Require node:test and write each case as test(...): const { test } = require(\"node:test\"); keep the shared helpers from require(\"../lib/harness\")"
      },
      "note": "Not selfIdentifying: a .js file is a test only directly under a tests/<category>/ directory. The wrapper runs each file once, without --test, under a guard and a case reporter; a run that loaded node:test is settled by the node:test exit table. Every placed test file must load node:test (newEntrypointRunner; the name predates its widening to existing files)."
    },
