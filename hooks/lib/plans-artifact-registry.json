{
  "formatTokens": ["outline-plan", "detail-plan", "test-review", "security-code", "security-plan", "review-security-shared"],
  "fragments": {
    "STAGE": "(?:outline|detail|security-plan|security-code|test-review)",
    "WORKER": "worker-[a-z0-9]+(?:-[a-z0-9]+)*"
  },
  "controlKinds": [
    { "kind": "review-round-state", "source": "%FORMAT%-(?:round-number|last-round|terminal)\\.txt", "retention": "non-plan" },
    { "kind": "unresolved-concerns", "source": "%FORMAT%-unresolved-concerns\\.json", "retention": "non-plan" },
    { "kind": "concern-ledger", "source": "%FORMAT%-concern-ledger(?:-cycle[0-9]+|-cap-snapshot)?\\.txt", "retention": "non-plan" },
    { "kind": "concern-carrier", "source": "%FORMAT%-concern-carrier\\.md", "retention": "non-plan" },
    { "kind": "round-delta", "source": "%FORMAT%-round-[0-9]+-delta-[a-z0-9]+(?:-[a-z0-9]+)*\\.txt", "retention": "non-plan" },
    { "kind": "exit6-accepted", "source": "(?:security-code|review-plan-security|review-tests)-exit6-accepted\\.txt", "retention": "non-plan" },
    { "kind": "risk-signal", "source": "(?:outline|detail)-risk-signal\\.txt", "retention": "non-plan" },
    { "kind": "worker-payload", "source": "%WORKER%\\.json", "retention": "non-plan" },
    { "kind": "worker-dispatched", "source": "%WORKER%\\.dispatched", "retention": "non-plan" },
    { "kind": "worker-outcome", "source": "%WORKER%\\.outcome\\.json", "retention": "non-plan" },
    { "kind": "worker-ingested", "source": "%WORKER%\\.ingested", "retention": "non-plan" },
    { "kind": "codex-context", "source": "codex-context\\.md", "retention": "non-plan" },
    { "kind": "codex-context-built", "source": "codex-context\\.%FORMAT%\\.built", "retention": "non-plan" },
    { "kind": "plan-log", "source": "plan\\.jsonl", "retention": "non-plan" },
    { "kind": "changed-files", "source": "changed-files\\.txt", "retention": "non-plan" },
    { "kind": "judge-signals", "source": "(?:complexity|outline|detail|write-tests|write-code)-signals\\.txt", "retention": "non-plan" },
    { "kind": "finalize-state", "source": "finalize-state-[0-9]+\\.json", "retention": "non-plan" },
    { "kind": "finalize-binding", "source": "finalize-binding-[0-9]+\\.json", "retention": "non-plan" },
    { "kind": "issue-close-outcome", "source": "issue-close-outcome\\.json", "retention": "non-plan" },
    { "kind": "session-close-gate", "source": "session-close-gate\\.json", "retention": "non-plan" },
    { "kind": "final-report-env", "source": "final-report-env\\.json", "retention": "non-plan" },
    { "kind": "supervisor-state", "source": "supervisor-state\\.json", "retention": "non-plan" },
    { "kind": "wi-checkpoint", "source": "wi-checkpoint\\.json", "retention": "non-plan" },
    { "kind": "handoff", "source": "handoff\\.md", "retention": "non-plan" },
    { "kind": "handoff-sidecar", "source": "handoff-(?:risk|pressure|flush-mark)\\.json", "retention": "non-plan", "note": "pressure / flush-mark stay registered so a leftover file never reads as unregistered (#2594; removed by #2652)." },
    { "kind": "progress-pressure", "source": "progress-pressure\\.json", "retention": "non-plan" },
    { "kind": "wt-cleanup-active", "source": "wt-cleanup-active", "retention": "non-plan" },
    { "kind": "workflow-init-aborted", "source": "workflow-init-aborted-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\.md", "retention": "non-plan" },
    { "kind": "companion-precheck", "source": "companion-precheck\\.json", "retention": "non-plan" },
    { "kind": "intent-scan-block", "source": "intent-scan-block\\.txt", "retention": "non-plan" },
    { "kind": "guard-attempt", "source": "guard-attempt\\.tmp", "retention": "non-plan" }
  ],
  "artifactKinds": [
    { "kind": "plan-artifact", "source": "(?:intent|outline|detail|context)\\.md", "retention": "plan" },
    { "kind": "progress", "source": "session-progress\\.md", "retention": "plan", "note": "Named by the first generation's sid and written across every handed-off generation (#2594). \"session-\" keeps it apart from topic names ending in -progress.md (user-requested-x-progress.md)." },
    { "kind": "survey", "source": "survey-[a-z0-9]+(?:-[a-z0-9]+)*\\.md", "retention": "non-plan" },
    { "kind": "issue-prefill", "source": "issue-prefill\\.md", "retention": "non-plan" },
    { "kind": "test-review", "source": "test-review\\.md", "retention": "non-plan" },
    { "kind": "test-review-fallback-raw", "source": "test-review-fallback-raw\\.md", "retention": "non-plan" },
    { "kind": "concerns-log", "source": "(?:%STAGE%-)?concerns-log\\.md", "retention": "non-plan" },
    { "kind": "codex-round-raw", "source": "(?:%STAGE%-)?codex-round-[0-9]+-raw\\.md", "retention": "non-plan" },
    { "kind": "debug-log", "source": "%STAGE%-debug\\.log", "retention": "non-plan" },
    { "kind": "judge-raw", "source": "(?:complexity|outline|detail|write-tests|write-code)-judge-raw\\.txt", "retention": "non-plan" },
    { "kind": "write-code-files", "source": "write-code-files\\.txt", "retention": "non-plan" },
    { "kind": "finalize-diagnostic", "source": "%FORMAT%-finalize-diagnostic\\.txt", "retention": "non-plan" },
    { "kind": "worker-draft", "source": "%WORKER%\\.draft\\.json", "retention": "non-plan" },
    { "kind": "notes-backup", "source": "notes-backup", "retention": "non-plan" },
    { "kind": "issue-create-dispatch", "source": "issue-create-dispatch\\.txt", "retention": "non-plan" },
    { "kind": "issue-create-survey", "source": "issue-create-survey\\.json", "retention": "non-plan" },
    { "kind": "sweep-issues", "source": "sweep-issues-(?:survivors|decisions)\\.tsv", "retention": "non-plan" },
    { "kind": "refactor-prompts-scan", "source": "refactor-prompts-scan\\.json", "retention": "non-plan" },
    { "kind": "note", "source": "note-[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:md|txt|json|tsv)", "retention": "non-plan" },
    { "kind": "user-requested", "source": "user-requested-[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:md|txt|json|tsv)", "retention": "user-requested", "note": "Usage rule (only when the user explicitly asks for a separate file): docs/architecture/claude-code/state-dirs.md, Artifacts table." },
    { "kind": "sweep-plans-approved-sessions", "source": "sweep-plans-approved-sessions\\.txt", "retention": "non-plan" }
  ],
  "sourceLintExceptions": [
    { "file": "bin/review-plan-codex", "pattern": "\\{EFF_SESSION_ID\\}-plan\\.jsonl$", "reason": "caller-supplied --log-dir outside the session control dir (standalone runs); the control-dir branch uses plan.jsonl" },
    { "file": "hooks/lib/supervisor-codex-input/assemble.js", "pattern": "\\$\\{wsid\\}-\\$\\{k\\}\\.md$", "reason": "${k} iterates the registered plan artifacts intent/outline/detail only; the template is statically unresolvable" }
  ]
}
