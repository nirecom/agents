# --- Session sync ---

# What you can do: enable automatic session sync (startup fetch, codes() push).
#   Manual push/pull/status/reset always run regardless.
# What you can't do: does NOT affect the remote URL used (see SESSION_SYNC_REMOTE_URL).
# Format: off (default) | on — case-insensitive; no other value is accepted.
SESSION_SYNC=off

# What you can do: set your own remote URL for Claude Code session sync.
# What you can't do: does NOT enable sync if the remote is unreachable.
# Format: git remote URL. Default: git@github.com:nirecom/agent-sessions.git
SESSION_SYNC_REMOTE_URL=git@github.com:YOUR_USERNAME/agent-sessions.git

# --- Worktree enforcement ---

# What you can do: block edits and commits from the main worktree so work must
#   happen in a linked worktree. Set off to allow direct main work for trivial
#   changes.
# What you can't do: does NOT change which branch is protected (see DEFAULT_BRANCHES).
# Format: on (default) | off.
ENFORCE_WORKTREE=on

#@if windows
# What you can do: add extra repo roots considered "in session" for write
#   commands that modify or destroy repo content (CWD repo always included).
# What you can't do: does NOT relax the coordination-command allowlist.
# Format: semicolon-separated absolute Windows paths. Example: C:\git\repo-a;C:\git\repo-b.
ENFORCE_WORKTREE_ADDITIONAL_REPOS=
#@endif
#@if posix
ENFORCE_WORKTREE_ADDITIONAL_REPOS=
#@endif

#@if windows
# What you can do: set sibling repo targets for label sync propagation; a direct
#   git repo syncs as-is, a non-repo directory is scanned depth-1 for git repos.
#   Also propagates sync-labels.sh and shared .github templates/workflows.
# What you can't do: does NOT scan deeper than one level when a directory is given.
# Format: semicolon-separated absolute paths. Example: C:\git\dotfiles;C:\git\my-private-repo
PROPAGATE_LABELS_REPOS=
#@endif
#@if posix
PROPAGATE_LABELS_REPOS=
#@endif

# What you can do: suppress all DELETE actions when propagating labels to sibling repos.
# What you can't do: has no effect unless PROPAGATE_LABELS_REPOS is also set.
# Format: any non-empty value enables no-delete mode; unset or empty applies DELETEs (default).
PROPAGATE_LABELS_NO_DELETE=

#@if windows
# What you can do: exempt paths from enforcement. Glob entries (*, **) match
#   file paths; plain path entries cover the path and its subtree.
# What you can't do: cannot disable the built-in .worktree-backup/** exclusion.
# Format: semicolon-separated Windows paths or globs.
#   Examples: C:\git\**\todo.md or C:\git\repo-a (exempts whole repo).
ENFORCE_WORKTREE_EXCLUDE=
#@endif
#@if posix
ENFORCE_WORKTREE_EXCLUDE=
#@endif

# What you can do: override default-branch detection with an explicit list of
#   branch names treated as protected.
# What you can't do: does NOT change what "protected" means (write block scope).
# Format: comma-separated branch names. Default (unset): auto-detected, falls
#   back to main. Example: DEFAULT_BRANCHES=develop,trunk,main
DEFAULT_BRANCHES=

# What you can do: auto-merge the PR after the push step (with confirmation).
# What you can't do: does NOT skip the confirmation prompt itself.
# Format: on (default) | off. When off, the PR is left for manual merge.
AUTO_MERGE_PR=on

# --- Workflow confirmation gates ---

# What you can do: skip the outline-plan approval prompt and inline preview.
# What you can't do: does NOT skip generation of the outline artifact.
# Format: on (default, fail-safe) | off.
CONFIRM_OUTLINE=on

# What you can do: skip the detail-plan approval prompt and inline preview.
# What you can't do: does NOT skip generation of the detail artifact.
# Format: on (default, fail-safe) | off.
CONFIRM_DETAIL=on

# What you can do: skip the gitignored-file copy approval inside worktree setup.
# What you can't do: does NOT change how the worktree name and branch type are chosen — both are always derived automatically.
# Format: on (default) | off.
CONFIRM_WORKTREE=on

# What you can do: skip the planned test-cases approval prompt and auto-approve
#   the WORKFLOW_WRITE_TESTS_NOT_NEEDED sentinel echo.
# What you can't do: does NOT bypass test-write permission dialogs.
# Format: on (default) | off.
CONFIRM_TESTS=on

# What you can do: skip the planned-edits approval prompt and auto-continue.
# What you can't do: does NOT skip lint/typecheck loop or bypass edit dialogs.
# Format: on (default) | off.
CONFIRM_CODE=on

# What you can do: skip the docs-update approval prompt (gather, propose, apply).
# What you can't do: does NOT suppress proposed bullets from appearing in chat.
# Format: on (default) | off.
CONFIRM_DOCS=on

# What you can do: opt out of editor workspace-targeted file-open for plan
#   artifacts for all users (including VS Code extension host). Set to 1 to suppress.
# What you can't do: does NOT suppress inline diff preview or approval prompts.
# Format: 1 = opt out; unset or empty = default (open enabled when VS Code detected).
SHOW_PLAN_LINK_NO_AUTO_OPEN=

#@if windows
# What you can do: relocate session planning artifacts to any absolute path.
# What you can't do: does NOT enable a fallback search path; tilde is NOT expanded.
# Format: absolute Windows path. Default (unset): C:\Users\<user>\.workflow-plans.
WORKFLOW_PLANS_DIR=
#@endif
#@if posix
WORKFLOW_PLANS_DIR=
#@endif

#@if windows
# What you can do: change the base directory under which parallel-session
#   worktrees are created.
# What you can't do: does NOT change per-worktree naming (task-name/<repo>).
# Format: absolute Windows path. Default: C:\Users\<user>\git\worktrees.
WORKTREE_BASE_DIR=
#@endif
#@if posix
WORKTREE_BASE_DIR=
#@endif

#@if windows
# What you can do: set to off to restore the confirmation dialog for Monitor
#   and EnterWorktree tool calls.
# What you can't do: does NOT affect other tools or permission rules.
# Format: off | on (default, auto-approves allowed tools). Case-insensitive.
AUTO_APPROVE_TOOLS=
#@endif
#@if posix
AUTO_APPROVE_TOOLS=
#@endif

# What you can do: set the minimum age (in days) before sweep skills treat
#   session artifacts and no-PR branches as reclaim candidates.
# What you can't do: cannot configure each sweep target independently (shared);
#   does NOT affect the merged-branch min-age-hours gate.
# Format: positive integer (days). 0 and non-integers are rejected. Default: 30.
SWEEP_AGE_DAYS=30

# --- Language policy ---

# What you can do: pick the language enforced for docs/history.md and the
#   History Notes section in public repos.
# What you can't do: does NOT affect CHANGELOG.md (see DOCS_LANG_CHANGELOG_*).
# Format: english / japanese (strict, blocks on mismatch) | any (off) |
#   other tokens such as french (advisory hint only).
DOCS_LANG_HISTORY_PUBLIC=english

# What you can do: pick the language enforced for docs/history.md in private repos.
# What you can't do: does NOT affect CHANGELOG.md.
# Format: english / japanese (strict, blocks on mismatch) | any (off) |
#   other tokens such as french (advisory hint only).
DOCS_LANG_HISTORY_PRIVATE=english

# What you can do: pick the language enforced for CHANGELOG.md in public repos.
# What you can't do: does NOT affect docs/history.md.
# Format: english / japanese (strict) | any (off) | other tokens (advisory).
DOCS_LANG_CHANGELOG_PUBLIC=english

# What you can do: pick the language enforced for CHANGELOG.md in private repos.
# What you can't do: does NOT affect docs/history.md.
# Format: english / japanese (strict) | any (off) | other tokens (advisory).
DOCS_LANG_CHANGELOG_PRIVATE=any

# What you can do: pick the language enforced for session planning artifacts.
# What you can't do: does NOT affect drafts or conversation text.
# Format: english / japanese (strict, blocks on violation) | any (off) |
#   other tokens (advisory hint only).
PLAN_LANG=any

# What you can do: pick the language Claude replies in throughout the session,
#   including planning confirmation dialogs.
# What you can't do: does NOT override PLAN_LANG or DOCS_LANG_* for written artifacts.
# Format: lowercase language name (e.g. japanese, french, traditional-chinese).
#   Set to english or leave unset to disable injection.
CONV_LANG=japanese

# What you can do: pick the language enforced for all staged text files at commit time.
# What you can't do: does NOT affect plan artifacts, history.md, conversation text, or binary blobs.
# Format: english / japanese (strict, blocks on violation) | any or unset (off, default) | other tokens (advisory hint only).
CODE_LANG=

#@if windows
# What you can do: repos matching an entry skip the whole commit-time language check.
# What you can't do: does NOT change what CODE_LANG itself means, and does NOT
#   skip any other commit check.
# Format: semicolon-separated absolute paths or globs, in OS-native path form.
#   Examples: C:\path\to\repo or C:\git\worktrees\**
CODE_LANG_EXCLUDE=
#@endif
#@if posix
CODE_LANG_EXCLUDE=
#@endif

# What you can do: add file extensions checked by the code-size review tool.
# What you can't do: does NOT affect skill-size review (SKILL.md scope only).
# Format: bare extensions without leading dot, semicolon-separated.
#   Default: js;sh;py. Example: CODE_FILE_EXTENSIONS=js;sh;py;tf;java;ts
CODE_FILE_EXTENSIONS=

# What you can do: set how many comment lines a comment block may have before
#   an Edit and a commit are blocked. A blank line or a lone punctuation token
#   does not split a block, so both sides still count toward the same block.
# What you can't do: does NOT change the file-size review; cannot be set from the shell.
# Format: a positive integer. Invalid/empty falls back to the default (10).
COMMENT_BLOCK_MAX_LINES=

# What you can do: turn the comment-block size gate off, for both the Edit-time
#   hook and the commit-time check.
# What you can't do: does NOT affect any other check; cannot be set from the shell.
# Format: off (disabled) | on or unset (enforced, default). Only "off" disables it.
COMMENT_BLOCK_ENFORCE=

# --- Model-conditional prompt ---

# What you can do: add one line of procedure-hardening guidance at session start
#   and right after compaction, only when the detected model matches a keyword.
# What you can't do: does NOT change workflow rules or what the guards enforce.
# Format: lowercase keywords, semicolon-separated, substring match. Empty = off.
VERBOSE_PROMPT_MODELS=

# --- TL3 testing ---

# What you can do: enable claude -p TL3 tests (see rules/test.md for TL3 definition) that may bill your Anthropic account.
# What you can't do: does not affect static grep tests, other non-billable tests, or the verification confirmation prompt shown before commit or merge.
# Format: off (default) | on.
RUN_TL3=off

# --- TL4 verification gate ---

# What you can do: enable the verification-gate confirmation shown before commit or merge when the staged files match a risk category.
# What you can't do: runs no tests — automated TL4 tests do not exist yet, so turning this on only restores the manual confirmation prompt.
# Format: off (default) | on.
RUN_TL4=off

# --- MCP servers ---

# What you can do: set the timeout for every codex CLI invocation in one place — outline,
#   detail-plan, security-plan, test-coverage and issue-dedupe reviews all read this key.
# What you can't do: does NOT lift the 600 s ceiling on a blocking Bash-tool call, which
#   kills a longer round leaving no FAILED header; past 600 needs run_in_background.
# Format: integer seconds. Default: 900. 0 = no limit. A non-integer falls back to the default.
CODEX_TIMEOUT_SECS=

# What you can do: let the issue-dedupe verdict reviewer use web search as
#   supplementary evidence when deciding whether a proposal is worth filing.
# What you can't do: does NOT change what evidence can justify worth_filing:false
#   — only a matching existing issue can, never a web search result alone.
# Format: off (default) | on.
ISSUE_VERDICT_WEB_SEARCH=off

# What you can do: disable the MCP filesystem server used by the codex reviewer
#   during plan review by setting the value to off.
# What you can't do: does NOT affect other MCP servers or codex behavior.
# Format: off to disable; any other value (or unset) means enabled.
CODEX_MCP_FS=

# What you can do: enable debug logging from the MCP filesystem server.
# What you can't do: does NOT affect which files are served or blocked.
# Format: 1 to enable; unset or any other value means disabled.
MCP_FS_DEBUG=

# --- CodeGraph ---

# What you can do: install the CodeGraph code-intelligence tool and let the workflow
#   build, refresh, and release its per-worktree index.
# What you can't do: takes effect only when re-run; the tool and index are never removed.
#   Upstream telemetry (https://telemetry.getcodegraph.com/v1/events) is opted out by default.
# Format: off (default) | on.
CODEGRAPH=off

# --- Codex review scope ---

# What you can do: raise or lower the diff-line budget above which the adversarial code
#   review truncates the diff it sends.
# What you can't do: does NOT change which changes are collected -- only how much of the
#   collected diff is reviewed; unrelated to MERGE_BASE_MAX_DIFF_LINES below.
# Format: integer (lines). Default: 5000.
CODEX_REVIEW_MAX_DIFF_LINES=

# What you can do: raise or lower the line-count budget above which a submitted plan is
#   truncated before adversarial codex review.
# What you can't do: does NOT change which plan content is generated -- only how much of it
#   is sent to review; unrelated to CODEX_REVIEW_MAX_DIFF_LINES above.
# Format: integer (lines). Default: 20000.
CODEX_REVIEW_PLAN_MAX_LINES=

# --- merge-base anomaly detection ---

# What you can do: raise or lower the diff size above which a freshly computed merge-base
#   is treated as implausible, so consumers narrow to uncommitted changes instead.
# What you can't do: has no effect once a base is already trusted for the session (already
#   confirmed, or a same-parent fallback) -- only a freshly computed base is checked.
# Format: integer (added + deleted lines). Default: 20000.
MERGE_BASE_MAX_DIFF_LINES=

# What you can do: same check on the other axis -- a freshly computed merge-base whose
#   range touches more files than this is treated as implausible.
# What you can't do: only decides whether the base is trusted; it never removes or adds
#   files to the comparison itself.
# Format: integer (changed paths). Default: 500.
MERGE_BASE_MAX_DIFF_FILES=

# --- Claude Code session ---

# What you can do: set a repo-wide default for Claude Code's auto-compact token
#   window, applied to every session started from this environment.
# What you can't do: does NOT override a value your shell or a launcher script
#   already set for that specific session.
# Format: positive integer (tokens). Unset (default): Claude Code's built-in default.
CLAUDE_CODE_AUTO_COMPACT_WINDOW=
