# --- Session sync ---

# Turn on automatic Claude Code session sync — a fetch at startup and a push when a session ends.
# You can't do: does not change the remote URL used, which comes from SESSION_SYNC_REMOTE_URL.
# Format: off (default) | on, case-insensitive; no other value is accepted. Manual push, pull, status and reset work either way.
SESSION_SYNC=off

# Point session sync at your own remote repository instead of the shared default.
# Format: git remote URL. Default: git@github.com:nirecom/agent-sessions.git.
SESSION_SYNC_REMOTE_URL=git@github.com:YOUR_USERNAME/agent-sessions.git

# --- Worktree enforcement ---

# Block edits and commits made from the main worktree, so work happens in a linked worktree.
# You can't do: does not change which branches count as protected, which DEFAULT_BRANCHES decides.
# Format: on (default) | off. Set off to allow direct main-worktree work for trivial changes.
ENFORCE_WORKTREE=on

#@if windows
# Add extra repository roots treated as in-session for write commands that modify or destroy repository content.
# You can't do: does not relax the coordination-command allowlist.
# Format: semicolon-separated absolute Windows paths, such as C:\git\repo-a;C:\git\repo-b. The current repository is always included, so list only the extras.
ENFORCE_WORKTREE_ADDITIONAL_REPOS=
#@endif
#@if posix
ENFORCE_WORKTREE_ADDITIONAL_REPOS=
#@endif

#@if windows
# Set sibling repository targets for label sync, which also carries shared .github templates and workflows to each target.
# Format: semicolon-separated absolute Windows paths, such as C:\git\dotfiles;C:\git\my-private-repo. A git repository syncs as is; a plain directory is scanned one level deep for repositories, never deeper.
PROPAGATE_LABELS_REPOS=
#@endif
#@if posix
PROPAGATE_LABELS_REPOS=
#@endif

# Keep labels that exist only in a sibling repository by suppressing every delete during label propagation.
# You can't do: has no effect unless PROPAGATE_LABELS_REPOS is also set.
# Format: any non-empty value turns no-delete mode on; unset or empty applies deletes (default).
PROPAGATE_LABELS_NO_DELETE=

#@if windows
# Exempt paths from worktree enforcement so they stay editable from the main worktree.
# You can't do: cannot lift the built-in .worktree-backup/** exemption.
# Format: semicolon-separated Windows paths or globs; a glob entry (*, **) matches file paths and a plain path entry covers that path and its subtree, such as C:\git\**\todo.md or C:\git\repo-a.
ENFORCE_WORKTREE_EXCLUDE=
#@endif
#@if posix
ENFORCE_WORKTREE_EXCLUDE=
#@endif

# Name the branches treated as protected instead of letting detection choose them, without changing what protected means for the write block itself.
# Format: comma-separated branch names such as develop,trunk,main. Unset (default): auto-detected, falling back to main.
DEFAULT_BRANCHES=

# Merge the pull request automatically once the push step finishes, still asking for confirmation first.
# Format: on (default) | off. Set off to leave every pull request for a manual merge.
AUTO_MERGE_PR=on

# --- Workflow confirmation gates ---

# Skip the outline-plan approval prompt and its inline preview.
# You can't do: does not skip generation of the outline artifact itself.
# Format: on (default, fail-safe) | off.
CONFIRM_OUTLINE=on

# Skip the detail-plan approval prompt and its inline preview, while the detail artifact is still generated.
# Format: on (default, fail-safe) | off.
CONFIRM_DETAIL=on

# Skip the approval prompt for copying gitignored files into a new worktree; the worktree name and branch type stay automatic either way.
# Format: on (default) | off.
CONFIRM_WORKTREE=on

# Skip the planned test-cases approval prompt and auto-approve the WORKFLOW_WRITE_TESTS_NOT_NEEDED sentinel echo.
# You can't do: does not bypass the permission dialogs raised when test files are written.
# Format: on (default) | off.
CONFIRM_TESTS=on

# Skip the planned-edits approval prompt so implementation continues on its own.
# You can't do: does not skip the lint and typecheck loop, nor the per-edit permission dialogs.
# Format: on (default) | off.
CONFIRM_CODE=on

# Skip the docs-update approval prompt covering gather, propose and apply, while the proposed bullets still appear in the conversation.
# Format: on (default) | off.
CONFIRM_DOCS=on

# Keep plan artifacts from opening automatically in your editor workspace, for every user including the VS Code extension host.
# Format: 1 opts out; unset or empty keeps the default, which opens plans when VS Code is detected. The inline diff preview and the approval prompts appear either way.
SHOW_PLAN_LINK_NO_AUTO_OPEN=

#@if windows
# Relocate session planning artifacts to an absolute path of your choosing.
# Format: absolute Windows path, with no fallback search path and no tilde expansion. Default (unset): C:\Users\<user>\.workflow-plans.
WORKFLOW_PLANS_DIR=
#@endif
#@if posix
WORKFLOW_PLANS_DIR=
#@endif

#@if windows
# Change the base directory under which parallel-session worktrees are created.
# Format: absolute Windows path. Default: C:\Users\<user>\git\worktrees. Per-worktree naming below it stays task-name/<repo>.
WORKTREE_BASE_DIR=
#@endif
#@if posix
WORKTREE_BASE_DIR=
#@endif

#@if windows
# Bring back the confirmation dialog for Monitor and EnterWorktree tool calls, leaving every other tool and permission rule alone.
# Format: off restores the dialog; on (default) auto-approves those tools. Case-insensitive.
AUTO_APPROVE_TOOLS=
#@endif
#@if posix
AUTO_APPROVE_TOOLS=
#@endif

# Set the minimum age in days before sweep skills treat session artifacts and no-PR branches as reclaim candidates.
# You can't do: one shared value covers every sweep target, and the merged-branch minimum-age-in-hours gate is untouched.
# Format: positive integer (days); 0 and non-integers are rejected. Default: 30. Raise it to hold artifacts longer, lower it to reclaim sooner.
SWEEP_AGE_DAYS=30

# --- Language policy ---

# Language expected in the History Notes and Changelog Notes sections of WORKTREE_NOTES.md in public repositories.
# You can't do: does NOT change the separate rule that keeps public-repo history entries free of Japanese.
# Format: english / japanese (strict, blocks on mismatch) | any (off) | any other token such as french (advisory hint only).
DOCS_LANG_PUBLIC=english

# The same policy for private repositories.
# Format: english / japanese (strict, blocks on mismatch) | any (off) | any other token such as french (advisory hint only).
DOCS_LANG_PRIVATE=any

# Choose the language enforced for session planning artifacts, leaving drafts and conversation text alone.
# Format: english / japanese (strict, blocks on mismatch) | any (off) | any other token such as french (advisory hint only).
PLAN_LANG=any

# Choose the language Claude replies in throughout the session, including planning confirmation dialogs.
# You can't do: does not override PLAN_LANG or the DOCS_LANG keys for written artifacts.
# Format: lowercase language name such as japanese, french or traditional-chinese; english or unset turns the injection off.
CONV_LANG=japanese

# Choose the language enforced for every staged text file at commit time.
# You can't do: does not affect plan artifacts, history entries, conversation text or binary blobs.
# Format: english / japanese (strict, blocks on mismatch) | any or unset (off, default) | any other token (advisory hint only).
CODE_LANG=

#@if windows
# Skip the whole commit-time language check in repositories matching an entry, without changing what CODE_LANG means or skipping any other commit check.
# Format: semicolon-separated absolute paths or globs in OS-native form, such as C:\path\to\repo or C:\git\worktrees\**.
CODE_LANG_EXCLUDE=
#@endif
#@if posix
CODE_LANG_EXCLUDE=
#@endif

# Add file extensions to the set the code-size review tool measures, leaving skill-size review scoped to SKILL.md.
# Format: bare extensions without a leading dot, semicolon-separated, such as js;sh;py;tf;java;ts. Default: js;sh;py.
CODE_FILE_EXTENSIONS=

# Set how many comment lines one comment block may hold before an edit and a commit are blocked.
# You can't do: does not change the file-size review, and the value cannot come from your shell.
# Format: positive integer; invalid or empty falls back to the default of 10. A blank line or a lone punctuation token does not split a block, so both sides count toward one block.
COMMENT_BLOCK_MAX_LINES=

# Turn the comment-block size gate off for both the edit-time check and the commit-time check.
# Format: off (disabled) | on or unset (enforced, default). Only off disables it, and the value cannot come from your shell.
COMMENT_BLOCK_ENFORCE=

# --- Model-conditional prompt ---

# Add one line of procedure-hardening guidance at session start and right after compaction, only when the detected model matches a keyword.
# Format: lowercase keywords, semicolon-separated, matched as substrings. Empty turns it off.
VERBOSE_PROMPT_MODELS=

# --- TL3 testing ---

# Turn on the TL3 tests that drive a real Claude session and may bill your Anthropic account.
# Format: off (default) | on. Static grep tests, other non-billable tests, and the verification confirmation shown before a commit or merge are unaffected.
RUN_TL3=off

# --- TL4 verification gate ---

# Turn on the verification-gate confirmation shown before a commit or merge when the staged files match a risk category.
# You can't do: runs no tests — automated TL4 tests do not exist yet, so this only restores the manual confirmation.
# Format: off (default) | on.
RUN_TL4=off

# --- MCP servers ---

# Set the timeout for every codex CLI invocation in one place, covering outline, detail-plan, security-plan, test-coverage and issue-dedupe reviews.
# You can't do: does not lift the 600-second ceiling on a blocking tool call, which kills a longer round leaving no result header.
# Format: integer seconds. Default: 900. 0 means no limit, and a non-integer falls back to the default.
CODEX_TIMEOUT_SECS=

# Let the issue-dedupe verdict reviewer use web search as supplementary evidence when judging whether a proposal is worth filing.
# You can't do: does not widen what may justify a not-worth-filing verdict — only a matching existing issue can, never a web search result alone.
# Format: off (default) | on.
ISSUE_VERDICT_WEB_SEARCH=off

# Turn off the MCP filesystem server that the codex reviewer uses during plan review, leaving other MCP servers alone.
# Format: off disables it; any other value or unset leaves it enabled.
CODEX_MCP_FS=

# Turn on debug logging from the MCP filesystem server, without changing which files are served or blocked.
# Format: 1 enables it; unset or any other value leaves it disabled.
MCP_FS_DEBUG=

# --- Codex review scope ---

# Line budget above which the adversarial code review truncates the diff it sends; what is collected is unchanged, only how much is reviewed.
# You can't do: this is the diff axis only — the plan axis is CODEX_REVIEW_MAX_PLAN_LINES below.
# Format: integer (lines). Default: 5000.
CODEX_REVIEW_MAX_DIFF_LINES=

# Line budget above which a submitted plan is truncated before adversarial codex review; what the plan contains is unchanged, only how much is sent.
# You can't do: this is the plan axis only — the diff axis is CODEX_REVIEW_MAX_DIFF_LINES above.
# Format: integer (lines). Default: 20000.
CODEX_REVIEW_MAX_PLAN_LINES=

# --- merge-base anomaly detection ---

# A freshly computed merge-base is treated as implausible when its diff exceeds either threshold below, and consumers narrow to uncommitted changes instead. A base already trusted for the session is never re-checked.
# Format: integer (added + deleted lines). Default: 20000.
MERGE_BASE_MAX_DIFF_LINES=

# The file-count axis of the same check: a range that touches more paths than this is implausible even when its line count is small.
# Format: integer (changed paths). Default: 500.
MERGE_BASE_MAX_DIFF_FILES=

# --- Claude Code session ---

# Set a repository-wide default for Claude Code's auto-compact token window, applied to every session started from this environment.
# You can't do: does not override a value your shell or a launcher script already set for that specific session.
# Format: positive integer (tokens). Unset (default): Claude Code's built-in default.
CLAUDE_CODE_AUTO_COMPACT_WINDOW=
