#!/bin/bash
# Restore the mtime of Claude Code session JSONL files from their last timestamp entry.
# The rule lives in `session-sync-engine restore-mtime` (#2658), shared with cc-session-mtime.ps1.
set -euo pipefail

if [ -L "${BASH_SOURCE[0]}" ] && _real="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)" && [ -n "$_real" ]; then
    exec bash "$_real" "$@"
fi
SCRIPT_CHECKOUT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

CLAUDE_DIR="${HOME}/.claude"
DRY_RUN=0

usage() {
    echo "Usage: $(basename "$0") [--dry-run] [--claude-dir <dir>]" >&2
    echo "Restore mtime of Claude Code session JSONL files from their last timestamp entry." >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --claude-dir) CLAUDE_DIR="${2:?--claude-dir requires a value}"; shift 2 ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

args=(restore-mtime --claude-dir "$CLAUDE_DIR")
[[ "$DRY_RUN" -eq 1 ]] && args+=(--dry-run --dry-run-style touch)
node "$SCRIPT_CHECKOUT_ROOT/bin/session-sync-engine" "${args[@]}" || true
