#!/usr/bin/env node
"use strict";
// bin/workflow/derive-complexity-level
// Stateless per-stage level derivation (#2099) — no session state is read or
// written. Used by the MDP-3 / WT-5 / WCD-3 fallback path, where no recorded
// evaluation exists and the stage still needs a model.
//
// Usage:
//   derive-complexity-level --stage <detail|write_tests|write_code> --signals <csv>
//   derive-complexity-level --stage <detail|write_tests|write_code> --signals-file <path>
//   derive-complexity-level --print-markdown-table
//   derive-complexity-level --print-signal-ids
//
// Exactly one of --signals / --signals-file is REQUIRED with --stage; passing
// both is an error. --signals-file reads the csv from a file with
// fs.readFileSync (never a shell), so judge-authored text never reaches
// command-argument position (#2099 CF-8a). Both forms feed the SAME parse +
// allowlist derivation: an unrecognized token routes to the undecidable
// level, so hostile file content fails high.
//
// Contract: this CLI ALWAYS returns some level, so it never prints NONE. When
// the routing table is unusable it fails open toward higher capability:
// stderr DERIVATION_UNAVAILABLE, stdout level=high, exit 0.

const fs = require("fs");
const path = require("path");
const routing = require(path.join(__dirname, "..", "..", "hooks", "workflow-state"));

function usage(msg) {
  if (msg) process.stderr.write("derive-complexity-level: " + msg + "\n");
  process.stderr.write(
    "usage: derive-complexity-level --stage <" + routing.ROUTING_STAGES.join("|") +
      "> (--signals <csv> | --signals-file <path>)\n" +
      "       derive-complexity-level --print-markdown-table\n" +
      "       derive-complexity-level --print-signal-ids\n"
  );
  process.exit(1);
}

// `signals` stays undefined until the flag is SEEN — symmetric with
// record-complexity-evaluation: `--signals ""` is a valid zero-signal input.
// No size bound: an unrecognized token routes to the undecidable level.
// A flag present as the LAST token, or immediately followed by another `--`
// flag, has no value — argv[i+1] reading blindly would return undefined
// (indistinguishable from "flag absent") or swallow the next flag as this
// flag's value. Both are usage errors, not a value.
function requireValue(argv, i, flagName) {
  const v = argv[i + 1];
  if (v === undefined || v.startsWith("--")) usage(flagName + " requires a value");
  return v;
}

function parseArgs(argv) {
  const out = { stage: null, signals: undefined, signalsFile: undefined, printTable: false, printIds: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--stage") {
      out.stage = requireValue(argv, i, "--stage");
      i++;
    } else if (a === "--signals") {
      out.signals = requireValue(argv, i, "--signals");
      i++;
    } else if (a === "--signals-file") {
      out.signalsFile = requireValue(argv, i, "--signals-file");
      i++;
    } else if (a === "--print-markdown-table") {
      out.printTable = true;
    } else if (a === "--print-signal-ids") {
      out.printIds = true;
    } else {
      usage("unknown argument: " + a);
    }
  }
  return out;
}

function main() {
  const args = parseArgs(process.argv.slice(2));

  if (args.printTable) {
    process.stdout.write(routing.renderStageRoutingMarkdown() + "\n");
    process.exit(0);
  }
  if (args.printIds) {
    process.stdout.write(routing.renderSignalIdsMarkdown() + "\n");
    process.exit(0);
  }

  if (!args.stage || !routing.ROUTING_STAGES.includes(args.stage)) {
    usage("--stage must be one of " + routing.ROUTING_STAGES.join(", "));
  }
  if (args.signals !== undefined && args.signalsFile !== undefined) {
    usage("--signals and --signals-file are mutually exclusive — pass exactly one");
  }
  if (args.signals === undefined && args.signalsFile === undefined) {
    usage('--signals or --signals-file is required (pass --signals "" for zero signals)');
  }

  // The file is read with fs.readFileSync only — never through a shell, eval, or
  // child_process — so its content cannot be interpreted as command syntax.
  let signalsText = args.signals;
  if (args.signalsFile !== undefined) {
    if (!args.signalsFile.length) usage("--signals-file requires a path");
    try {
      signalsText = fs.readFileSync(args.signalsFile, "utf8");
    } catch (e) {
      usage("--signals-file could not be read: " + args.signalsFile + " (" + e.code + ")");
    }
  }

  const signals = signalsText.trim().length
    ? signalsText.split(",").map((s) => s.trim()).filter((s) => s.length)
    : [];

  let level;
  try {
    level = routing.deriveStageLevel(args.stage, signals);
  } catch (e) {
    if (e instanceof routing.RoutingTableUnavailableError) {
      process.stderr.write("DERIVATION_UNAVAILABLE\n");
      process.stdout.write("level=high\n");
      process.exit(0);
    }
    throw e;
  }

  process.stdout.write("level=" + level + "\n");
  process.exit(0);
}

main();
