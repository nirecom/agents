#!/usr/bin/env node
"use strict";
// Dispatch only. All logic lives in ./lib/next-step/*.
// The four requires are deliberately top-level (not lazy): list.js and verdict.js
// pull in ./lib/next-step/steps.js, whose import-time invariant assertions must
// run on EVERY subcommand path, --help included.

const { parseArgs } = require("./lib/next-step/cli");
const { runList } = require("./lib/next-step/list");
const { runReset, runMark } = require("./lib/next-step/state-ops");
const { runAdvanceCli } = require("./lib/next-step/advance");
const { computeVerdict } = require("./lib/next-step/verdict");

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.advance) return runAdvanceCli(args);
  if (args.list) return runList(args.session);
  if (args.reset !== undefined) return runReset(args.session, args.reset);
  if (args.mark !== undefined) return runMark(args.session, args.mark);
  return computeVerdict(args.session);
}

main();
