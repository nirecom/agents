#!/usr/bin/env node
"use strict";
// Usage: pr-state [--repo <dir>]
// Read-only (#2527): prints the current branch's PR state and number for /deliver
// and its preflight. Never merges. Output, always exit 0 on a parsed command line:
//   PR_STATE=OPEN|MERGED|CLOSED|NONE|UNKNOWN
//   PR_NUMBER=<n>   (empty when there is no PR or it is unknown)

const path = require("path");

function die(msg) {
  process.stderr.write("pr-state: " + msg + "\n");
  process.exit(1);
}

let repoDir = process.cwd();
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "--repo") {
    if (i + 1 >= argv.length) die("--repo requires an argument");
    repoDir = argv[++i];
  } else {
    die("unknown argument: " + argv[i]);
  }
}

let pr = { state: "UNKNOWN", number: "" };
try {
  const { toWindowsPath } = require(path.join(__dirname, "../../hooks/lib/branch-diff"));
  const { prForBranch } = require(path.join(__dirname, "../../hooks/workflow-gate/gh-detect"));
  pr = prForBranch(toWindowsPath(repoDir)) || pr;
} catch (e) {
  process.stderr.write("pr-state: lookup failed — " + (e && e.message ? e.message : "unknown") + "\n");
}
process.stdout.write("PR_STATE=" + pr.state + "\nPR_NUMBER=" + (pr.number || "") + "\n");
