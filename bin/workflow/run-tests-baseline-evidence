#!/usr/bin/env node
"use strict";
// bin/workflow/run-tests-baseline-evidence — state hand-off for bin/run-tests-baseline (#2431).
//   failing --session <sid>
//     exit 0: `SEQ=<n>`, one failing test path per line, then `EXIT\t<code>\t<path>` per recorded
//     exit (#2688); exit 3: not classifiable;
//     exit 7: `HIT_COUNT=<n>` then the recorded hit lines (unattributed hits, #2669).
//   record --session <sid> --seq <n> --classification <file> [--base <sha>] [--note <text>]
//     exit 0 completed (prints the completion_basis), 1 classification unmet, 2 usage,
//     3 state moved or not pending, 8 classification unfinished (re-run requested).
//   rerun-list --session <sid>
//     exit 0: one path per line (failing tests + worktree-change HIT ids, #2803); 3 state;
//     exit 9: a HIT names no test, so only a full rerun is safe. Read-only.
//   input-version --session <sid>
//     exit 0: the cwd's input_version (branch-rerun cache key, #2688); exit 1: none resolves.

const path = require("path");
const lib = require(path.join(__dirname, "lib", "run-tests-baseline-evidence"));
const { rerunList } = require(path.join(__dirname, "lib", "run-tests-baseline-evidence", "rerun-list"));
const { normalizeCwd } = require(path.join(__dirname, "..", "..", "hooks", "lib", "path-normalize"));

const SESSION_ID_RE = /^[A-Za-z0-9_-]+$/;
const SESSION_ONLY = new Set(["rerun-list", "input-version"]);
const USAGE =
  "usage: run-tests-baseline-evidence failing --session <sid>\n" +
  "       run-tests-baseline-evidence record --session <sid> --seq <n> --classification <file> [--base <sha>] [--note <text>]\n" +
  "       run-tests-baseline-evidence rerun-list --session <sid>\n" +
  "       run-tests-baseline-evidence input-version --session <sid>";

function finish(code, stdout, stderr) {
  if (stdout) process.stdout.write(stdout);
  if (stderr) process.stderr.write(`run-tests-baseline-evidence: ${stderr}\n`);
  process.exit(code);
}

function usage(msg) {
  finish(lib.EXIT.USAGE, null, `${msg}\n${USAGE}`);
}

function parseArgs(sub, argv) {
  const opts = {};
  const known = SESSION_ONLY.has(sub)
    ? { "--session": "session" }
    : { "--session": "session", "--seq": "seq", "--classification": "classification", "--base": "base", "--note": "note" };
  for (let i = 0; i < argv.length; i++) {
    const key = known[argv[i]];
    if (key === undefined || i + 1 >= argv.length) usage(`bad argument: ${argv[i]}`);
    opts[key] = argv[++i];
  }
  return opts;
}

function main() {
  const [sub, ...rest] = process.argv.slice(2);
  const opts = parseArgs(sub, rest);
  if (!opts.session || !SESSION_ID_RE.test(opts.session)) usage("--session is required");

  if (sub === "failing") {
    const r = lib.failing(opts.session);
    finish(r.code, r.stdout, r.stderr);
  }
  if (sub === "record") {
    if (!opts.seq || !/^[1-9][0-9]*$/.test(opts.seq)) usage("--seq <positive integer> is required");
    if (!opts.classification) usage("--classification <file> is required");
    const file = normalizeCwd(opts.classification) || opts.classification;
    const r = lib.recordFromFile(opts.session, Number(opts.seq), file, opts.base, opts.note);
    finish(r.code, r.code === lib.EXIT.OK ? `RECORDED completion_basis=${r.basis}\n` : null, r.reason);
  }
  if (sub === "rerun-list") {
    const r = rerunList(opts.session);
    finish(r.code, r.stdout, r.stderr);
  }
  if (sub === "input-version") {
    const { computeInputVersion } = require(path.join(__dirname, "..", "..", "hooks", "lib", "diff-fingerprint"));
    const v = computeInputVersion(normalizeCwd(process.cwd()) || process.cwd());
    if (typeof v === "string" && v !== "") finish(0, `${v}\n`, null);
    finish(1, null, null);
  }
  usage(`unknown subcommand: ${sub === undefined ? "(none)" : sub}`);
}

main();
