#!/usr/bin/env node
"use strict";
// bin/workflow/normalize-judge-signals
// Strictly capture-and-normalize the complexity-judge subagent's raw output
// into a signals CSV consumable by derive-complexity-level.
//
// Usage:
//   normalize-judge-signals --raw-file <path> --session <sid> --stage <complexity|outline|detail|write-tests|write-code>
//
// The output is DERIVED as <session control dir>/<stage>-signals.txt; the caller never names it.
// The raw judge output is untrusted text and only ever reaches this process
// via fs.readFileSync — never a shell. Malformed / out-of-vocabulary input
// degrades to `S0-undecidable`; a `none` payload degrades to the empty CSV.
// The out file is always written (fail-open) and its path printed; only a write failure exits non-zero.

const fs = require("fs");
const path = require("path");
const { SIGNAL_IDS } = require(
  path.join(__dirname, "..", "..", "hooks", "workflow-state", "complexity-routing.js")
);
const controlDir = require(
  path.join(__dirname, "..", "..", "hooks", "workflow-state", "state-io", "control-dir.js")
);

const VALID_SIGNAL_IDS = new Set(SIGNAL_IDS);
const STAGES = ["complexity", "outline", "detail", "write-tests", "write-code"];

const SIGNALS_PREFIX = "SIGNALS:";
const CHARSET_RE = /^[A-Za-z0-9,_-]*$/;

function usage(msg) {
  if (msg) process.stderr.write("normalize-judge-signals: " + msg + "\n");
  process.stderr.write(
    "usage: normalize-judge-signals --raw-file <path> --session <sid> --stage <" + STAGES.join("|") + ">\n"
  );
  process.exit(2);
}

function requireValue(argv, i, flagName) {
  const v = argv[i + 1];
  if (v === undefined || v.startsWith("--")) usage(flagName + " requires a value");
  return v;
}

const FLAGS = { "--raw-file": "rawFile", "--session": "session", "--stage": "stage", "--out": "out" };

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    const key = FLAGS[argv[i]];
    if (!key) usage("unknown argument: " + argv[i]);
    out[key] = requireValue(argv, i, argv[i]);
    i++;
  }
  return out;
}

// --- BEGIN temporary: plans-dir control files -> workflow control dir migration added 2026-09-28 ---
// deletion-condition: remove after 2026-12-28 (release + 3 months) together with hooks/lib/temporary-migrations/control-dir-split/, bin/migrate-control-dir and the legacy-argument shims; keep guard (c) until then
function legacyOutStage(args) {
  const { legacyArgName, legacySessionId } = require(
    path.join(__dirname, "..", "..", "hooks", "lib", "temporary-migrations", "control-dir-split", "legacy-arg.js")
  );
  const sid = legacySessionId(args.session);
  const name = legacyArgName(args.out, sid, STAGES.map((s) => `${s}-signals.txt`));
  if (name === null) usage("--out is accepted only as the legacy session-prefixed <stage>-signals.txt path in the plans dir");
  return { sid, stage: name.slice(0, -"-signals.txt".length) };
}
// --- END temporary: plans-dir control files -> workflow control dir migration ---

function resolveOut(args) {
  let sid = args.session;
  let stage = args.stage;
  if (args.out !== undefined) {
    if (stage !== undefined) usage("--out and --stage are mutually exclusive");
    ({ sid, stage } = legacyOutStage(args));
  }
  if (!sid) usage("--session is required");
  if (!STAGES.includes(stage)) usage("--stage must be one of " + STAGES.join(", "));
  try {
    return controlDir.controlPath(sid, `${stage}-signals.txt`, { forWrite: true });
  } catch (e) {
    process.stderr.write("normalize-judge-signals: " + (e && e.message ? e.message : String(e)) + "\n");
    process.exit(e instanceof controlDir.ControlMigrationError ? 3 : 2);
  }
}

// A write failure is the only non-zero exit after argument resolution.
function writeOutAndExit(outPath, value) {
  try {
    fs.writeFileSync(outPath, value);
  } catch (e) {
    process.stderr.write(
      "normalize-judge-signals: could not write out file: " + outPath + " (" + e.code + ")\n"
    );
    process.exit(1);
  }
  process.stdout.write(outPath.replace(/\\/g, "/") + "\n");
  process.exit(0);
}

function normalize(raw) {
  const signalsLines = [];
  let sawSignalsLine = false;
  for (const line of raw.split(/\r?\n/)) {
    const t = line.trim();
    if (t === "") continue;
    if (t.startsWith(SIGNALS_PREFIX)) {
      signalsLines.push(t);
      sawSignalsLine = true;
    } else if (sawSignalsLine) {
      return "S0-undecidable";
    }
  }
  if (signalsLines.length !== 1) return "S0-undecidable";

  const payload = signalsLines[0].slice(SIGNALS_PREFIX.length).trim();
  if (payload.toLowerCase() === "none") return "";

  const fields = payload.split(",").map((f) => f.trim());
  const normalizedCsv = fields.join(",");
  if (!CHARSET_RE.test(normalizedCsv)) return "S0-undecidable";
  for (const f of fields) {
    if (f === "" || !VALID_SIGNAL_IDS.has(f)) return "S0-undecidable";
  }
  return normalizedCsv;
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (!args.rawFile) usage("--raw-file is required");
  const outPath = resolveOut(args);

  let raw;
  try {
    raw = fs.readFileSync(args.rawFile, "utf8");
  } catch (e) {
    process.stderr.write(
      "normalize-judge-signals: raw file unreadable (" + e.code + "); emitting S0-undecidable\n"
    );
    return writeOutAndExit(outPath, "S0-undecidable");
  }
  return writeOutAndExit(outPath, normalize(raw));
}

main();
