#!/usr/bin/env node
"use strict";
// Thin CLI over appendStateHandoffRecord (#2652), for skill prompts and shell scripts.
// --session defaults to the CC-native sid (resolveSessionId), never the
// PLANS_DIR filename heuristic: a wsid default would make writer and reader
// look at different files.
// A record that is not written (no state file, outside the recording period, an identical
// repeat, the budget reached) is named on one stderr line and still exits 0, so a skill's
// recording call never fails its step.

const path = require("path");
const HOOKS = path.join(__dirname, "..", "..", "hooks");
const SCHEMA = require(path.join(HOOKS, "workflow-state", "state-io", "state-handoff-record-schema"));
const { appendStateHandoffRecord } = require(path.join(HOOKS, "lib", "state-handoff-record"));
const { resolveSessionId } = require(path.join(HOOKS, "workflow-state", "session-id"));
const { SESSION_ID_VALID_RE } = require(path.join(HOOKS, "workflow-state", "state-io"));

const FLAGS = {
  "--session": "session",
  "--class": "cls",
  "--step": "step",
  "--key": "key",
  "--summary": "summary",
  "--pointer": "pointer",
  "--origin": "origin",
};

// Retired origins: step-end (#2430) and flush (#2652; a main-session fact belongs in
// session-progress.md). A caller still passing one gets the usage, not just a rejection.
const RETIRED_ORIGINS = ["step-end", "flush"];
// The CLI writes declared records only (security review C2): an origin the hooks write
// through write.js directly would let a CLI caller forge an "observed" record.
const CLI_ORIGINS = ["procedure-point"];
const HOOK_ONLY_ORIGINS = SCHEMA.ORIGINS.filter((o) => !CLI_ORIGINS.includes(o));

// A skill runs this from memory at a procedure point and cannot afford to open the
// source, so the command answers for itself. --origin has no default on purpose.
const USAGE = [
  "Usage: handoff-append --class <A-G> --step <step|-> --key <id> --summary <text> --pointer <path|-> --origin <origin>",
  "",
  "Required flags:",
  "  --class <A-G>       record class; one of: " + SCHEMA.CLASSES.join(", "),
  "  --step <step|->     workflow step the record belongs to, or '-' for a stepless record",
  "  --key <id>          dedup identity; characters A-Z a-z 0-9 _ . : -",
  "  --origin <origin>   what produced the record; one of: " + CLI_ORIGINS.join(", "),
  "                      (" + HOOK_ONLY_ORIGINS.join(", ") + " are hook-only and refused)",
  "",
  "The record goes into the session's state file. When it is not written (no-state,",
  "outside-period, noop-identical, overflow) one stderr line names the reason; exit 0.",
  "",
  "Optional flags:",
  "  --summary <text>    what a fresh session needs; keep under 300 characters",
  "  --pointer <path|->  file holding the detail, or '-' when there is none",
  "  --session <sid>     target session; defaults to the resolved Claude Code session id",
  "  --help, -h          print this message",
  "",
  "Class vocabulary and the record fields: docs/architecture/claude-code/state-handoff-record.md",
  "",
].join("\n");

const HELP_FLAGS = ["--help", "-h"];
const NOT_WRITTEN_REASONS = ["no-state", "outside-period", "noop-identical", "overflow"];

function acceptedFlagList() {
  return Object.keys(FLAGS).concat(HELP_FLAGS).join(", ");
}

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i += 1) {
    if (HELP_FLAGS.indexOf(argv[i]) !== -1) return { help: true };
    const name = FLAGS[argv[i]];
    if (!name) {
      return { error: `unknown argument: ${argv[i]} — accepted flags: ${acceptedFlagList()}` };
    }
    if (i + 1 >= argv.length) return { error: `${argv[i]} requires a value` };
    out[name] = argv[i + 1];
    i += 1;
  }
  return { opts: out };
}

// Every offending field in ONE pass: a caller who mistyped two flags should not
// have to rerun the command to discover the second one.
function invalidEntryFields(opts) {
  const bad = [];
  if (!SCHEMA.CLASSES.includes(opts.cls)) {
    bad.push(`--class ${JSON.stringify(opts.cls ?? null)} (want one of: ${SCHEMA.CLASSES.join(", ")})`);
  }
  if (!SCHEMA.isValidAtStep(opts.step)) {
    bad.push(`--step ${JSON.stringify(opts.step ?? null)} (want a workflow step name, or '-')`);
  }
  if (!SCHEMA.isValidKey(opts.key)) {
    bad.push(`--key ${JSON.stringify(opts.key ?? null)} (want at most ${SCHEMA.KEY_MAX_CHARS} characters A-Z a-z 0-9 _ . : -)`);
  } else if (opts.key === SCHEMA.OVERFLOW_KEY) {
    bad.push(`--key ${JSON.stringify(opts.key)} (reserved for the overflow record)`);
  }
  if (!CLI_ORIGINS.includes(opts.origin)) {
    bad.push(`--origin ${JSON.stringify(opts.origin ?? null)} (want one of: ${CLI_ORIGINS.join(", ")})`);
  }
  return bad;
}

function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.help) {
    process.stdout.write(USAGE);
    return 0;
  }
  if (parsed.error) {
    process.stderr.write(`handoff-append: ${parsed.error}\n`);
    return 2;
  }
  const opts = parsed.opts;
  if (RETIRED_ORIGINS.includes(opts.origin)) {
    process.stderr.write(`handoff-append: --origin ${opts.origin} is retired\n${USAGE}`);
    return 2;
  }
  if (HOOK_ONLY_ORIGINS.includes(opts.origin)) {
    process.stderr.write(`handoff-append: --origin ${opts.origin} is hook-only; pass --origin ${CLI_ORIGINS.join(", ")}\n`);
    return 2;
  }
  const sid = opts.session !== undefined ? opts.session : resolveSessionId({});
  if (!sid) {
    process.stderr.write("handoff-append: no session id could be resolved\n");
    return 2;
  }
  const bad = invalidEntryFields(opts);
  if (bad.length) {
    process.stderr.write(`handoff-append: rejected — ${bad.length} field(s) out of vocabulary: ${bad.join("; ")}\n`);
    return 2;
  }
  // Checked before the write: an invalid sid is a caller error (exit 2), never
  // a missing state that would silently swallow the mistake.
  if (typeof sid !== "string" || !SESSION_ID_VALID_RE.test(sid)) {
    process.stderr.write(`handoff-append: rejected — --session ${JSON.stringify(sid)} is not a valid session id\n`);
    return 2;
  }
  const result = appendStateHandoffRecord(sid, {
    cls: opts.cls,
    step: opts.step,
    key: opts.key,
    summary: opts.summary === undefined ? "" : opts.summary,
    pointer: opts.pointer === undefined ? "-" : opts.pointer,
    origin: opts.origin,
  });
  if (result.written) {
    process.stdout.write(`WRITTEN=1 REASON=${result.reason}\n`);
    return 0;
  }
  // The fields and the sid were already cleared, so `invalid` here is unexpected — still named.
  if (result.reason === "invalid") {
    process.stderr.write("handoff-append: rejected — the record failed validation\n");
    return 2;
  }
  // lock-timeout and io-error already printed their `record dropped` line from the write entry.
  if (NOT_WRITTEN_REASONS.includes(result.reason)) {
    process.stderr.write(`handoff-append: not recorded — ${result.reason}\n`);
  }
  process.stdout.write(`WRITTEN=0 REASON=${result.reason}\n`);
  return 0;
}

process.exit(main());
