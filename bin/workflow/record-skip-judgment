#!/usr/bin/env node
"use strict";
// CLI wrapper for recordSkipJudgment(), called by jev-judge finalize (#2460).
// record-skip-judgment --session <sid> --target <outline|detail> --cond <key>=<true|false> ...
//   --source <jev|subagent|mixed> --ticket <16 hex> [--advance [--next]]
// --cond names exactly CONDITION_SCHEMAS[target]; anything off-schema or unknown is exit 2.
// The ticket must be a finalized one in the broker's own store with this very answer (verifyTicket),
// and makes the call an idempotent resume (resumeAction: RECORDED=superseded / REPLAYED=1).
// Prints RECORDED=<target> all_conditions_met=<true|false> with unchanged bytes in every mode;
// --advance (#1644) settles the step as skipped when every condition is true, --next adds ACTION.

const path = require("path");
const WS = path.join(__dirname, "..", "..", "hooks", "workflow-state");
const { recordSkipJudgment, readSkipJudgment, readState } = require(WS);
const { runAdvance } = require(path.join(__dirname, "lib", "next-step", "advance-shared"));
const { RECORDED_VERDICT_REASONS } = require(path.join(WS, "record-step-verdict"));
const { CONDITION_SCHEMAS, JUDGMENT_SOURCES } = require(path.join(WS, "skip-signal-resolver", "condition-schemas"));
const TWO_STAGE = path.join(__dirname, "..", "..", "hooks", "lib", "jev", "two-stage");
const { readClaims } = require(path.join(TWO_STAGE, "paths"));
const { sourcesChanged } = require(path.join(TWO_STAGE, "source-fresh"));

const TICKET_RE = /^[0-9a-f]{16}$/;
const COND_RE = /^([a-z][a-z0-9_]*)=(true|false)$/;

function fail(code, msg) {
  process.stderr.write("record-skip-judgment: " + msg + "\n");
  process.exit(code);
}

function verifyWrite(sj, conditions, allMet, source, ticket) {
  if (!sj || typeof sj !== "object" || Array.isArray(sj)) return false;
  if (sj.judgment_source !== source) return false;
  if (sj.ticket !== ticket) return false;
  if (sj.all_conditions_met !== allMet) return false;
  const rc = sj.conditions;
  if (!rc || typeof rc !== "object" || Array.isArray(rc)) return false;
  const expectedKeys = Object.keys(conditions);
  if (Object.keys(rc).length !== expectedKeys.length) return false;
  for (const k of expectedKeys) {
    if (rc[k] !== conditions[k]) return false;
  }
  return true;
}

function parseArgs(argv) {
  const out = { session: null, target: null, conds: null, source: null, ticket: null, advance: false, next: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--session") {
      out.session = argv[++i] || null;
    } else if (a === "--target") {
      out.target = argv[++i] || null;
    } else if (a === "--cond") {
      const raw = argv[++i] || "";
      const m = COND_RE.exec(raw);
      if (!m) fail(2, "--cond takes <key>=<true|false>, got " + JSON.stringify(raw.slice(0, 80)));
      out.conds = out.conds || new Map();
      if (out.conds.has(m[1])) fail(2, "--cond repeats " + m[1]);
      out.conds.set(m[1], m[2] === "true");
    } else if (a === "--source" || a === "--ticket") {
      const v = argv[++i];
      if (typeof v !== "string" || out[a.slice(2)] !== null) fail(2, a + " needs one value");
      out[a.slice(2)] = v;
    } else if (a === "--advance") {
      out.advance = true;
    } else if (a === "--next") {
      out.next = true;
    } else {
      fail(2, "unknown argument: " + a);
    }
  }
  // --next asks for the action AFTER the forward operation; rejected before any write.
  if (out.next && !out.advance) fail(1, "--next is only meaningful with --advance");
  return out;
}

// The command line is not evidence of a judgment: the ticket must be one the broker finalized
// for this session and target, and its written-ahead answer must be exactly the one supplied.
// Returns the ticket's claim; exit 2 otherwise.
function verifyTicket(sid, target, form) {
  const claim = readClaims(sid, form.ticket).find((h) => h.kind === "cli-ticket" && h.finalized === true
    && h.session_id === sid && h.ticket === form.ticket && h.target === target);
  const r = claim && claim.result;
  if (!r || r.target !== target || r.source !== form.source) fail(2, "--ticket is not a finalized ticket of this session and target");
  const rc = r.conditions && typeof r.conditions === "object" ? r.conditions : {};
  const keys = Object.keys(form.conditions);
  if (Object.keys(rc).length !== keys.length || !keys.every((k) => rc[k] === form.conditions[k])) {
    fail(2, "--cond differs from the ticket's finalized answer");
  }
  return claim;
}

// {conditions, source, ticket, reason}; exit 2 on anything off-schema.
function judgmentForm(args) {
  if (!args.conds) fail(2, "--cond is required");
  if (!JUDGMENT_SOURCES.includes(args.source)) fail(2, "--source must be one of " + JUDGMENT_SOURCES.join("|"));
  if (args.ticket === null || !TICKET_RE.test(args.ticket)) fail(2, "--ticket must be 16 lowercase hex");
  const keys = CONDITION_SCHEMAS[args.target];
  if (args.conds.size !== keys.length || !keys.every((k) => args.conds.has(k))) {
    fail(2, "--cond must name exactly " + keys.join(", "));
  }
  const conditions = {};
  for (const k of keys) conditions[k] = args.conds.get(k);
  return { conditions, source: args.source, ticket: args.ticket, reason: RECORDED_VERDICT_REASONS[args.target] };
}

// The step's recorded status; a missing state or step reads as pending (nothing settled it).
function stepStatus(sid, target) {
  try {
    const s = readState(sid);
    return (s && s.steps && s.steps[target] && s.steps[target].status) || "pending";
  } catch (_e) {
    return "pending";
  }
}

// The --ticket resume table: "write" (normal), "superseded", "replay" (nothing to do),
// or "advance" (the judgment of this ticket is written, the advance is not).
function resumeAction(sj, ticket, allMet, status) {
  if (sj && sj.ticket === ticket) {
    if (!allMet) return "replay";
    if (status === "pending") return "advance";
    return status === "skipped" ? "replay" : "superseded";
  }
  return status === "pending" ? "write" : "superseded";
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (!args.session || !args.session.trim()) fail(1, "--session is required");
  if (args.target !== "outline" && args.target !== "detail") fail(1, "--target must be outline or detail");
  const form = judgmentForm(args);
  const sid = args.session.trim();
  const claim = verifyTicket(sid, args.target, form);
  const allMet = Object.values(form.conditions).every((v) => v === true);
  const recordedLine = "RECORDED=" + args.target + " all_conditions_met=" + allMet + "\n";
  // The judgment is already its own annotation; copying it onto the status write
  // would emit a second skip_judgment event for the same ticket.
  const advance = (suffix) => runAdvance({
    session: sid, binary: "record-skip-judgment", step: args.target, status: "skipped",
    skipReason: form.reason, next: args.next, prefix: recordedLine, suffix,
  });

  const action = resumeAction(readSkipJudgment(sid, args.target), form.ticket, allMet, stepStatus(sid, args.target));
  if (action === "superseded") {
    process.stdout.write("RECORDED=superseded\n");
    process.exit(0);
  }
  // A skip that is still to be written or advanced must describe the sources as they are now.
  if (allMet && action !== "replay" && sourcesChanged(sid, claim.stage, claim.artifacts_sha256)) {
    fail(2, "the ticket's sources changed since its query");
  }
  if (action === "advance" && args.advance) advance("REPLAYED=1\n");
  const replayed = action !== "write";
  if (!replayed) {
    recordSkipJudgment(sid, args.target, form.conditions, form.source, { ticket: form.ticket });
    // Hardening #1 (#1300): recordSkipJudgment is fail-open/silent, so read the record
    // back; a failed write or a stale prior record is never reported as success.
    const readBack = readSkipJudgment(sid, args.target);
    if (!verifyWrite(readBack, form.conditions, allMet, form.source, form.ticket)) {
      // With --advance the write is the first half of the forward transaction: exit 2.
      fail(args.advance ? 2 : 1, "write verification failed for target " + args.target);
    }
    if (args.advance && allMet) advance("");
  }
  process.stdout.write(recordedLine + (replayed ? "REPLAYED=1\n" : ""));
  process.exit(0);
}

main();
