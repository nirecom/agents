#!/usr/bin/env node
"use strict";
// bin/workflow/record-skip-judgment
// CLI wrapper for recordSkipJudgment(). Used by SKILL.md Bash calls.
//
// Usage:
//   record-skip-judgment --session <sid> --target <outline|detail>
//                        --c1 [true|false] --c2 [true|false]
//                        [--c3 [true|false]]
//
// --c1/--c2/--c3 accept an optional value:
//   bare flag (--c1)         → true
//   --c1 true / --c1 false   → boolean
//   --c1 <next-flag>         → true (next-flag consumed separately)
//
// --c3 is required when --target=detail; ignored for outline.
// Prints to stdout: RECORDED=<target> all_conditions_met=<true|false>
// Exits 0 on success, 1 on bad args.
//
// --advance (#1644) additionally settles the target step as skipped, but ONLY
// when all_conditions_met is true — the recorded judgment is the authority, so a
// false judgment records the judgment and stops. --next adds the ACTION block.
// The RECORDED= line above keeps its exact bytes in every mode.

const path = require("path");
const { recordSkipJudgment, readSkipJudgment } = require(
  path.join(__dirname, "..", "..", "hooks", "workflow-state")
);
const { runAdvance } = require(
  path.join(__dirname, "lib", "next-step", "advance-shared")
);
const { RECORDED_VERDICT_REASONS } = require(
  path.join(__dirname, "..", "..", "hooks", "workflow-state", "record-step-verdict")
);

function verifyWrite(sj, conditions, allMet) {
  if (!sj || typeof sj !== "object" || Array.isArray(sj)) return false;
  if (sj.judgment_source !== "orchestrator") return false;
  if (sj.all_conditions_met !== allMet) return false;
  const rc = sj.conditions;
  if (!rc || typeof rc !== "object" || Array.isArray(rc)) return false;
  const expectedKeys = Object.keys(conditions);
  const actualKeys = Object.keys(rc);
  if (actualKeys.length !== expectedKeys.length) return false;
  for (const k of expectedKeys) {
    if (rc[k] !== conditions[k]) return false;
  }
  return true;
}

// Parse a boolean-flag value. Returns { value: bool, consumed: 0|1 }.
// consumed=1 means the next token was consumed as the value.
function parseFlagBool(argv, i, flagName) {
  const next = argv[i + 1];
  if (next !== undefined && next !== null && !next.startsWith("--")) {
    const v = next.trim().toLowerCase();
    if (v === "true") return { value: true, consumed: 1 };
    if (v === "false") return { value: false, consumed: 1 };
    process.stderr.write("record-skip-judgment: invalid boolean for " + flagName + ": " + next + "\n");
    process.exit(1);
  }
  // bare flag → true
  return { value: true, consumed: 0 };
}

function parseArgs(argv) {
  const out = { session: null, target: null, c1: null, c2: null, c3: null, advance: false, next: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--session") {
      out.session = argv[++i] || null;
    } else if (a === "--target") {
      out.target = argv[++i] || null;
    } else if (a === "--c1") {
      const r = parseFlagBool(argv, i, "--c1");
      out.c1 = r.value;
      i += r.consumed;
    } else if (a === "--c2") {
      const r = parseFlagBool(argv, i, "--c2");
      out.c2 = r.value;
      i += r.consumed;
    } else if (a === "--c3") {
      const r = parseFlagBool(argv, i, "--c3");
      out.c3 = r.value;
      i += r.consumed;
    } else if (a === "--advance") {
      out.advance = true;
    } else if (a === "--next") {
      out.next = true;
    } else {
      process.stderr.write("record-skip-judgment: unknown argument: " + a + "\n");
      process.exit(1);
    }
  }
  // --next asks for the action AFTER the forward operation, so on its own it has
  // nothing to follow. Rejected here — before any write — so a malformed call
  // never leaves a half-applied judgment behind.
  if (out.next && !out.advance) {
    process.stderr.write("record-skip-judgment: --next is only meaningful with --advance\n");
    process.exit(1);
  }
  return out;
}

function main() {
  const args = parseArgs(process.argv.slice(2));

  if (!args.session || !args.session.trim()) {
    process.stderr.write("record-skip-judgment: --session is required\n");
    process.exit(1);
  }
  if (args.target !== "outline" && args.target !== "detail") {
    process.stderr.write("record-skip-judgment: --target must be outline or detail\n");
    process.exit(1);
  }
  if (args.c1 === null || args.c1 === undefined) {
    process.stderr.write("record-skip-judgment: --c1 is required\n");
    process.exit(1);
  }
  if (args.c2 === null || args.c2 === undefined) {
    process.stderr.write("record-skip-judgment: --c2 is required\n");
    process.exit(1);
  }

  let conditions;
  let allMet;

  if (args.target === "outline") {
    conditions = { so_c1: args.c1, so_c2: args.c2 };
    allMet = args.c1 === true && args.c2 === true;
  } else {
    // detail: --c3 required
    if (args.c3 === null || args.c3 === undefined) {
      process.stderr.write("record-skip-judgment: --c3 is required when --target=detail\n");
      process.exit(1);
    }
    conditions = { sd_c1: args.c1, sd_c2: args.c2, sd_c3: args.c3 };
    allMet = args.c1 === true && args.c2 === true && args.c3 === true;
  }

  recordSkipJudgment(args.session.trim(), args.target, conditions, "orchestrator");

  // Hardening #1 (#1300): recordSkipJudgment is fail-open/silent. Read the record
  // back and confirm it matches EXACTLY what this invocation wrote — a failed write
  // or a stale prior record must not be reported as success.
  const __readBack = readSkipJudgment(args.session.trim(), args.target);
  if (!verifyWrite(__readBack, conditions, allMet)) {
    process.stderr.write("record-skip-judgment: write verification failed for target " + args.target + "\n");
    // Without --advance this is the frozen exit 1. With --advance the judgment
    // write is the first half of the forward transaction, so its failure is a
    // record failure and carries the class's exit 2.
    process.exit(args.advance ? 2 : 1);
  }

  const recordedLine = "RECORDED=" + args.target + " all_conditions_met=" + allMet + "\n";
  if (!args.advance || allMet !== true) {
    // A false judgment is a valid recording, not an error: the step stays
    // unsettled and the caller decides what to do next.
    process.stdout.write(recordedLine);
    process.exit(0);
  }

  runAdvance({
    session: args.session.trim(),
    binary: "record-skip-judgment",
    step: args.target,
    status: "skipped",
    skipReason: RECORDED_VERDICT_REASONS[args.target],
    skipJudgment: __readBack,
    next: args.next,
    prefix: recordedLine,
  });
}

main();
