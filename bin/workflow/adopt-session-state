#!/usr/bin/env node
"use strict";

// Explicit crash-resume adoption (#1305): a session that lost its id cannot
// prove descent, so the user asserts it by hand here. Argument parsing and
// output only — every guard lives in hooks/workflow-state/inheritance/adopt.js.

const path = require("path");

const SCRIPT_CHECKOUT_ROOT = path.resolve(__dirname, "..", "..");
const { adoptState, listAdoptCandidates } =
  require(path.join(SCRIPT_CHECKOUT_ROOT, "hooks", "workflow-state", "inheritance", "adopt.js"));
const { describeGranularInheritance } =
  require(path.join(SCRIPT_CHECKOUT_ROOT, "hooks", "workflow-state", "inheritance", "apply.js"));
const { inheritanceSideLines } =
  require(path.join(SCRIPT_CHECKOUT_ROOT, "bin", "lib", "resume-session", "render.js"));
const { resolveSessionId } =
  require(path.join(SCRIPT_CHECKOUT_ROOT, "hooks", "workflow-state", "session-id.js"));

const SID_RE = /^[A-Za-z0-9_-]+$/;
// #2297: kept recognized so an old command line fails loudly instead of as "unrecognized".
const REMOVED_FLAGS = ["--granularity", "--verified-equivalent"];

function usage() {
  process.stdout.write(
    "Usage: adopt-session-state [--session <downstream-sid>] --list\n" +
    "       adopt-session-state [--session <downstream-sid>] --from <upstream-sid>\n"
  );
}

function parseArgs(argv) {
  const out = { session: null, from: null, list: false, help: false, error: null, removed: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (REMOVED_FLAGS.indexOf(a) !== -1) {
      if (out.removed === null) out.removed = a;
    } else if (a === "--help" || a === "-h") out.help = true;
    else if (a === "--list") out.list = true;
    else if (a === "--session" && i + 1 < argv.length) out.session = argv[++i];
    else if (a === "--from" && i + 1 < argv.length) out.from = argv[++i];
    else out.error = `unrecognized argument: ${a}`;
  }
  return out;
}

function fail(message) {
  process.stderr.write(`adopt-session-state: ${message}\n`);
  process.exit(1);
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  // Checked before anything else: a removed flag never reaches an adoption.
  if (args.removed !== null) {
    process.stderr.write(`adopt-session-state: ${args.removed} removed: granularity is decided from where this session runs\n`);
    process.exit(2);
  }
  if (args.help) { usage(); return; }
  if (args.error) { usage(); fail(args.error); }

  // The sid flows into path.join() inside the state layer, so an out-of-charset
  // value is rejected here rather than normalized (CWE-22).
  for (const [label, value] of [["--session", args.session], ["--from", args.from]]) {
    if (value !== null && !SID_RE.test(value)) fail(`${label} value is not a valid session id`);
  }

  let heirSid = args.session;
  if (!heirSid) {
    try { heirSid = resolveSessionId(); } catch (e) { heirSid = null; }
  }
  if (!heirSid) fail("could not resolve this session's id; pass --session <sid>");

  if (args.list) {
    const r = listAdoptCandidates(heirSid);
    if (!r.ok) fail(r.error);
    if (r.candidates.length === 0) {
      process.stdout.write("No adoptable prior session found for this cwd+branch.\n");
      return;
    }
    process.stdout.write("Adoptable prior sessions (same cwd+branch, still resumable):\n");
    for (const c of r.candidates) {
      process.stdout.write(`  ${c.sessionId}\t${c.git_branch || "(no branch)"}\t${c.last_activity || "(unknown)"}\n`);
    }
    process.stdout.write(
      `\nAdopt with: node bin/workflow/adopt-session-state --session ${heirSid} --from <sid>\n`
    );
    return;
  }

  if (!args.from) { usage(); fail("nothing to do — pass --list or --from <upstream-sid>"); }

  const result = adoptState({ heirSid, donorSid: args.from });
  if (!result.ok) fail(result.error);
  process.stdout.write(
    `Adopted workflow state from session ${result.donorSessionId} into ${heirSid}.\n`
  );
  process.stdout.write(describeGranularInheritance(result.inheritance) + "\n");
  for (const line of inheritanceSideLines(result.inheritance, result.donorSessionId)) {
    process.stdout.write(line + "\n");
  }
  if (result.degraded_reason) {
    process.stdout.write(`Session upstream evidence was incomplete (${result.degraded_reason}).\n`);
  }
}

main();
