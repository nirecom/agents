#!/usr/bin/env bash
# supervisor-check-session-active — Check whether a workflow session is still active.
#
# Parses closes_issues from <wsid>-intent.md and queries GitHub to determine
# if the session is still active (any issue OPEN) or terminated (all CLOSED).
#
# Usage: bin/supervisor-check-session-active [--wsid] <wsid> [--plans-dir <dir>]
#        bin/supervisor-check-session-active --wsid <wsid> [--plans-dir <dir>]
#
# Exit 0 = active session (any OPEN, empty closes_issues, intent.md not found, or gh failure)
# Exit 1 = terminated session (all issues CLOSED)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

WSID=""
PLANS_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --wsid)
      WSID="${2:?--wsid requires a value}"
      shift 2
      ;;
    --plans-dir)
      PLANS_DIR="${2:?--plans-dir requires a value}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "ERROR: unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$WSID" ]]; then
        WSID="$1"
        shift
      else
        echo "ERROR: unexpected argument: $1" >&2
        exit 1
      fi
      ;;
  esac
done

if [[ -z "$WSID" ]]; then
  echo "ERROR: wsid required (use --wsid <wsid> or pass as positional arg)" >&2
  exit 1
fi

if [[ -z "$PLANS_DIR" ]]; then
  _scsa_resolver="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workflow-plans-dir"
  if [[ -x "$_scsa_resolver" ]]; then
    PLANS_DIR="$(bash "$_scsa_resolver")"
  else
    PLANS_DIR="${WORKFLOW_PLANS_DIR:-$HOME/.workflow-plans}"
  fi
fi

# Owner-resolved (#2633): a downstream session reads its upstream's intent. A resolver failure
# (no node) keeps the session's own path, so a missing intent still means "active". A sid outside
# the session-id alphabet is never joined into a path (#2748): it reads as "active".
[[ "$WSID" =~ ^[A-Za-z0-9_-]+$ ]] || exit 0
INTENT_MD="$(node "${SCRIPT_DIR}/plan-artifact-path" --stage intent --session "$WSID" --plans-dir "$PLANS_DIR" 2>/dev/null || true)"
[[ -n "$INTENT_MD" ]] || INTENT_MD="${PLANS_DIR}/${WSID}-intent.md"

# If intent.md not found → active session (cannot determine terminated)
if [[ ! -f "$INTENT_MD" ]]; then
  exit 0
fi

# Parse closes_issues via canonical parser
ISSUES="$(node "${SCRIPT_DIR}/parse-closes-issues" "$INTENT_MD" 2>/dev/null || echo "[]")"

# If empty array → active session
if [[ "$ISSUES" == "[]" ]]; then
  exit 0
fi

# The parser prints [{"number":N,"repo"?:...}]; gh needs the bare number.
IFS=',' read -ra NUMS <<< "$(node -e 'try { const a = JSON.parse(process.argv[1]); process.stdout.write(a.map((e) => (e && typeof e === "object" ? e.number : e)).filter((n) => Number.isInteger(Number(n))).join(",")); } catch (_) {}' "$ISSUES")"

# Check each issue state
for NUM in "${NUMS[@]}"; do
  # Skip empty elements
  [[ -z "$NUM" ]] && continue

  STATE="$(gh issue view "$NUM" --json state --jq .state 2>/dev/null || echo "UNKNOWN")"

  # Any non-CLOSED state (or gh failure) → active session
  if [[ "$STATE" != "CLOSED" ]]; then
    exit 0
  fi
done

# All issues CLOSED → terminated session
exit 1
