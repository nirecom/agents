#!/usr/bin/env bash
# bin/run-tests-baseline — classify the failing tests of the last /run-tests run (#2431, #2688)
# and complete run_tests when every failure pre-existed at the merge base or has an auto-accepted
# cause. Stages: failing list -> solo re-run on the branch -> rename source + ledger -> base;
# a base failure is compared line by line with the branch (#2956; classes: test-result-contract.md).
#
# Usage: bin/run-tests-baseline --session <sid> [--worktree <path>] [--per-test-timeout <sec>] [--note <text>]
# Timeout: omitted -> derived from the duration ledger (2x measured, 300-540 s; unmeasured 300); any value is cut by one 600 s budget.
# --note: what the user knows about the failures; kept as baseline_note and shown in the PR body.
# Output: `BASELINE: <class> <path> <detail>[ new=<N> head=<json>]` lines, then `BASELINE_SUMMARY:
#   preexisting=N inherited=N broken=N undetermined=N file_verdict=N new_on_branch=N`.
# Exit:   0 run_tests completed (`RECORDED completion_basis=<basis>` on stderr), 1 otherwise,
#   2 usage, 3 no hook-recorded failing list (or state moved), 4 merge base not trustworthy,
#   5 no baseline (base predates the root names or the case details: merge main and re-run),
#   6 unattributed hits: `BASELINE_HITS: count=N` then `HIT: <line>` lines, 8 re-run requested.
# Child test output goes to log files only, never to stdout.

set -uo pipefail

SCRIPT_CHECKOUT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for _lib in ledger timeout worktree exec homeref branch rename compare classify; do
  # shellcheck source=/dev/null
  . "$SCRIPT_CHECKOUT_ROOT/bin/lib/run-tests-baseline-$_lib.sh"
done

RTB_EVIDENCE="$SCRIPT_CHECKOUT_ROOT/bin/workflow/run-tests-baseline-evidence"
RTB_RESOLVE="$SCRIPT_CHECKOUT_ROOT/bin/resolve-merge-base.sh"

die() { printf 'run-tests-baseline: %s\n' "$2" >&2; exit "$1"; }

SID="" WT_ARG="$PWD" PER_TEST_TIMEOUT="" PTT_EXPLICIT=0 NOTE="" HAS_NOTE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --session) [ "$#" -ge 2 ] || die 2 "--session needs a value"; SID="$2"; shift 2 ;;
    --worktree) [ "$#" -ge 2 ] || die 2 "--worktree needs a value"; WT_ARG="$2"; shift 2 ;;
    --per-test-timeout) [ "$#" -ge 2 ] || die 2 "--per-test-timeout needs a value"; PER_TEST_TIMEOUT="$2"; PTT_EXPLICIT=1; shift 2 ;;
    --note) [ "$#" -ge 2 ] || die 2 "--note needs a value"; NOTE="$2"; HAS_NOTE=1; shift 2 ;;
    -h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) die 2 "unknown argument: $1" ;;
  esac
done
[ -n "$SID" ] || die 2 "--session <sid> is required"
if [ "$PTT_EXPLICIT" = 1 ]; then
  case "$PER_TEST_TIMEOUT" in ''|*[!0-9]*|??????????*) die 2 "--per-test-timeout must be a positive integer of at most 9 digits" ;; esac
  [ $((10#$PER_TEST_TIMEOUT)) -gt 0 ] || die 2 "--per-test-timeout must be a positive integer of at most 9 digits"
  PER_TEST_TIMEOUT=$((10#$PER_TEST_TIMEOUT))
fi

# 1. The failing list the run-tests hook recorded, its causal position and each test's exit.
FAILING_OUT="$(node "$(rtb_wt_native "$RTB_EVIDENCE")" failing --session "$SID")"
FAILING_RC=$?
if [ "$FAILING_RC" -eq 7 ]; then
  # Unattributed hits (#2669) outrank any failing list: no failure in such a run is classifiable.
  printf 'BASELINE_HITS: count=%s\n' "$(printf '%s\n' "$FAILING_OUT" | sed -n '1s/^HIT_COUNT=//p')"
  printf '%s\n' "$FAILING_OUT" | sed '1d' | while IFS= read -r line; do
    [ -z "$line" ] || printf 'HIT: %s\n' "$line"
  done
  die 6 "unattributed hits; cannot classify; re-run with jobs=1"
fi
[ "$FAILING_RC" -eq 0 ] \
  || die 3 "the run-tests hook recorded no failing-test list for this session (no trusted RUN_CONTRACT, count mismatch, or run_tests not failing); baseline classification is not possible"
SEQ="$(printf '%s\n' "$FAILING_OUT" | sed -n '1s/^SEQ=//p')"
TESTS=()
declare -A BR_EXIT=()
# shellcheck disable=SC2034  # BR_EXIT is read by rtb_branch_stage
while IFS= read -r line; do
  case "$line" in
    '') ;;
    EXIT$'\t'*) _rest="${line#EXIT$'\t'}"; BR_EXIT["${_rest#*$'\t'}"]="${_rest%%$'\t'*}" ;;
    *) TESTS+=("$line") ;;
  esac
done < <(printf '%s\n' "$FAILING_OUT" | sed '1d')
[ -n "$SEQ" ] && [ "${#TESTS[@]}" -gt 0 ] || die 3 "malformed failing-test list"

ROOT="$(git -C "$WT_ARG" rev-parse --show-toplevel 2>/dev/null)" || die 2 "not a git checkout: $WT_ARG"
ROOT="$(rtb_wt_native "$ROOT")"

export RTB_LEDGER_REPO="$ROOT"
run_all_dur_repo_id "$ROOT" >/dev/null
run_all_dur_host_token >/dev/null
TMP_BASE="$(run_all_cache_dir)/baseline/tmp"
mkdir -p "$TMP_BASE" 2>/dev/null || TMP_BASE="$(mktemp -d)"
find "$TMP_BASE" -mindepth 1 -maxdepth 1 -mmin +$((RTB_LEDGER_RETENTION_DAYS * 1440)) \
  -exec rm -rf {} + 2>/dev/null || true
LOGDIR="$TMP_BASE/logs-$(date +%s)-$$"
RTB_LINES_WRITTEN_LOG="$TMP_BASE/lines-written-$$"
: >"$RTB_LINES_WRITTEN_LOG" 2>/dev/null || RTB_LINES_WRITTEN_LOG=""
trap '[ -z "$RTB_LINES_WRITTEN_LOG" ] || rm -f "$RTB_LINES_WRITTEN_LOG"' EXIT
# Loaded even with an explicit --per-test-timeout: the derived value decides whether a timeout
# under that REQUESTED_TEST_TIMEOUT may be recorded (#3015).
ledger_args=()
for i in "${!TESTS[@]}"; do ledger_args+=("$i:${TESTS[$i]}"); done
rtb_timeout_load_ledger "$ROOT" "$TMP_BASE" "${ledger_args[@]}"

# shellcheck disable=SC2034  # BR_* are filled by the branch stage, RUN_REL/RUN_OLD by the ledger stage
declare -a CLS=() DET=() RERUN=() NEWC=() NEWH=() BR_RES=() BR_END=() BR_NOREC=() BR_TIMEOUT=() RUN_REL=() RUN_OLD=()

# 2. Each failing test alone on the branch: one that passes there is no base question.
rtb_branch_stage
REST=0
for i in "${!TESTS[@]}"; do [ -n "${CLS[i]:-}" ] || REST=$((REST + 1)); done

# 3. The merge base, needed only for what the branch left; short of trustworthy goes to the user.
B2=""
if [ "$REST" -gt 0 ]; then
  MB_ERR_FILE="$(mktemp)"
  MB_OUT="$(bash "$RTB_RESOLVE" -C "$ROOT" --session "$SID" --format kv --no-fetch 2>"$MB_ERR_FILE")"
  MB_RC=$?
  MB_ERR="$(cat "$MB_ERR_FILE" 2>/dev/null)"
  rm -f "$MB_ERR_FILE"
  MB_BASE="$(printf '%s\n' "$MB_OUT" | sed -n 's/^base=//p' | head -n 1)"
  MB_STATE="$(printf '%s\n' "$MB_OUT" | sed -n 's/^state=//p' | head -n 1)"
  case "$MB_STATE" in
    RECORDED|RESOLVED) ;;
    *)
      [ -z "$MB_ERR" ] || printf '%s\n' "$MB_ERR" >&2
      die 4 "merge base is ${MB_STATE:-UNRESOLVED} (resolve-merge-base exit $MB_RC); confirm the base (see /run-tests RNT-1) before classifying" ;;
  esac
  [ "$MB_RC" -eq 0 ] || die 4 "resolve-merge-base exited $MB_RC"
  B2="$(git -C "$ROOT" rev-parse --verify --quiet "$MB_BASE^{commit}")" || die 4 "merge base $MB_BASE is not a local commit"
  # Decided before the ledger: a cached verdict for such a base would be just as unusable.
  if rtb_base_predates_root_names "$ROOT" "$B2"; then
    die 5 "no baseline, rebase needed: merge base $B2 predates the root names this checkout's tests run under"
  fi
  rtb_wt_sweep_stale "$ROOT"
  # This checkout's registry; used only to normalize names (the base launches its own tests).
  # shellcheck source=bin/lib/test-language-registry.sh
  { . "$SCRIPT_CHECKOUT_ROOT/bin/lib/test-language-registry.sh" && tlr_load; } || die 2 "test language registry not readable"
fi

# 4. Ledger: (a) same base, then (b) inheritance from an ancestor base (run-tests-baseline-classify.sh).
[ -z "$B2" ] || rtb_cls_ledger_stage

# 5. Re-run the rest in a marked, detached checkout of the merge base; a test the base lacks
#    runs under its rename source when git names one (detail gains `-via-rename:<old>`).
if [ "${#RERUN[@]}" -gt 0 ]; then
  WT="$(rtb_wt_create "$ROOT" "$B2")" || WT=""
  # A base harness that writes no fail-details.tsv leaves nothing to compare (#2956 S3).
  if [ -n "$WT" ] && rtb_base_predates_case_detail "$WT"; then
    rtb_wt_remove "$ROOT" "$WT" || true
    die 5 "no baseline, merge main and re-run: merge base $B2 predates the case details (its tests/lib/harness.sh writes no fail-details.tsv)"
  fi
  EXPLICIT=""
  [ "$PTT_EXPLICIT" != 1 ] || EXPLICIT="$PER_TEST_TIMEOUT"
  for i in "${RERUN[@]}"; do
    t="${TESTS[$i]}" run="${RUN_REL[i]:-}" old="${RUN_OLD[i]:-}"
    if [ -z "$WT" ]; then
      CLS[i]="undetermined"; DET[i]="worktree-create-failed"; continue
    fi
    if [ -z "$run" ]; then
      CLS[i]="undetermined"; DET[i]="missing-at-base"; continue
    fi
    d="$(rtb_test_data_dir "$run")"
    targets=("$WT/$run")
    [ -d "$WT/$d" ] && targets+=("$WT/$d")
    if rtb_has_home_ref "${targets[@]}"; then
      CLS[i]="undetermined"; DET[i]="home-claude-ref"; continue
    fi
    rtb_timeout_requested_into "${RTB_TIMEOUT_LEDGER[$i]:-}" "$EXPLICIT"
    REQUESTED_TEST_TIMEOUT="$RTB_TIMEOUT_REQUESTED_OUT" DERIVED="$RTB_TIMEOUT_DERIVED_OUT" SRC="$RTB_TIMEOUT_SRC_OUT"
    rtb_timeout_budget_into "$REQUESTED_TEST_TIMEOUT" "$SECONDS"
    if [ "$RTB_TIMEOUT_APPLIED_OUT" -eq 0 ]; then
      CLS[i]="undetermined"; DET[i]="budget-exhausted"; continue
    fi
    APPLIED_TEST_TIMEOUT="$RTB_TIMEOUT_APPLIED_OUT"
    [ "$APPLIED_TEST_TIMEOUT" -ge "$REQUESTED_TEST_TIMEOUT" ] || SRC="$SRC, limited from ${REQUESTED_TEST_TIMEOUT}s by budget"
    printf 'run-tests-baseline: timeout: %s %ss (%s)\n' "$t" "$APPLIED_TEST_TIMEOUT" "$SRC" >&2
    if ! rtb_exec_one "$WT" "$run" "$APPLIED_TEST_TIMEOUT" "$LOGDIR"; then
      CLS[i]="undetermined"; DET[i]="exec-setup-failed"; continue
    fi
    if [ "$RTB_EXEC_TIMEDOUT" = "1" ]; then
      rtb_cls_base_timeout "$i" "$run" "$APPLIED_TEST_TIMEOUT" "$REQUESTED_TEST_TIMEOUT" "$DERIVED"
    elif [ "$RTB_EXEC_UNSUPPORTED" = "1" ]; then
      CLS[i]="undetermined"; DET[i]="unsupported-at-base"; rtb_ledger_append "$B2" "$run" und:unsupported-at-base
    elif [ "$RTB_EXEC_DECOY" = "1" ]; then
      CLS[i]="undetermined"; DET[i]="root-decoy-hit-at-base"; rtb_ledger_append "$B2" "$run" und:root-decoy-hit-at-base
    elif [ "$RTB_EXEC_UNRUNNABLE" = "1" ]; then
      CLS[i]="undetermined"; DET[i]="unrunnable-at-base"
    elif [ -n "$RTB_EXEC_STATE" ]; then
      # The launcher already told TIMEOUT apart (.timedout), so a FAIL with 124/142 is the
      # test's own failure; only a signal death (137/143) stays ambiguous.
      case "$RTB_EXEC_STATE:$RTB_EXEC_RC" in
        SKIP:*) CLS[i]="undetermined"; DET[i]="skip-at-base" ;;
        PASS:*) rtb_cls_base_pass "$i" "passes-at-base"; rtb_ledger_append "$B2" "$run" pass ;;
        FAIL:137|FAIL:143) CLS[i]="undetermined"; DET[i]="ambiguous-exit-$RTB_EXEC_RC" ;;
        FAIL:*) rtb_cls_base_fail "$i" "$run" "$old" ;;
        *) CLS[i]="undetermined"; DET[i]="state-$RTB_EXEC_STATE-at-base" ;;
      esac
    elif tlr_match "$run" && _tlr_get "$TLR_ID" launch.wrapper && [ -n "$_TLR_V" ]; then
      # A base launcher that predates #2501 ran a wrapper language raw: its rc is no result.
      CLS[i]="undetermined"; DET[i]="base-launcher-predates-result-conversion"
      rtb_ledger_append "$B2" "$run" und:base-launcher-predates-result-conversion
    else
      case "$RTB_EXEC_RC" in
        77) CLS[i]="undetermined"; DET[i]="skip-at-base" ;;
        124|137|142|143) CLS[i]="undetermined"; DET[i]="ambiguous-exit-$RTB_EXEC_RC" ;;
        0) rtb_cls_base_pass "$i" "passes-at-base"; rtb_ledger_append "$B2" "$run" pass ;;
        *) rtb_cls_base_fail "$i" "$run" "$old" ;;
      esac
    fi
    rtb_cls_append_via "$i" "$old"
  done
  # 6. Removal failure only warns; the classification stands.
  [ -z "$WT" ] || rtb_wt_remove "$ROOT" "$WT" || true
fi
[ -d "$LOGDIR" ] && printf 'run-tests-baseline: base-run logs: %s\n' "$LOGDIR" >&2

# 7. Hand the classification to the state side; it alone may complete run_tests. Its
#    output goes to stderr so a refusal's reason reaches the user (stdout stays BASELINE lines).
CLS_FILE="$TMP_BASE/classification-$(date +%s)-$$.tsv"
: >"$CLS_FILE" 2>/dev/null || die 1 "cannot write $CLS_FILE"
N_PRE=0 N_INH=0 N_BRK=0 N_UND=0 N_FV=0 N_NEW=0
for i in "${!TESTS[@]}"; do
  printf '%s\t%s\t%s\t%s\t%s\n' "${TESTS[$i]}" "${CLS[i]}" "${DET[i]}" "${NEWC[i]:-0}" "${NEWH[i]:-[]}" >>"$CLS_FILE"
  case "${CLS[i]}" in
    preexisting) N_PRE=$((N_PRE + 1)) ;;
    preexisting-inherited) N_INH=$((N_INH + 1)) ;;
    broken) N_BRK=$((N_BRK + 1)) ;;
    file-verdict-preexisting) N_FV=$((N_FV + 1)) ;;
    new-case-failure-on-branch) N_NEW=$((N_NEW + 1)) ;;
    *) N_UND=$((N_UND + 1)) ;;
  esac
done
rec_args=(record --session "$SID" --seq "$SEQ" --classification "$(rtb_wt_native "$CLS_FILE")")
[ -z "$B2" ] || rec_args+=(--base "$B2")
[ "$HAS_NOTE" = 0 ] || rec_args+=(--note "$NOTE")
node "$(rtb_wt_native "$RTB_EVIDENCE")" "${rec_args[@]}" >&2
REC_RC=$?
rm -f "$CLS_FILE"

for i in "${!TESTS[@]}"; do
  if [ "${NEWC[i]:-0}" -gt 0 ] 2>/dev/null; then
    printf 'BASELINE: %s %s %s new=%s head=%s\n' "${CLS[i]}" "${TESTS[$i]}" "${DET[i]}" "${NEWC[i]}" "${NEWH[i]}"
  else
    printf 'BASELINE: %s %s %s\n' "${CLS[i]}" "${TESTS[$i]}" "${DET[i]}"
  fi
done
printf 'BASELINE_SUMMARY: preexisting=%s inherited=%s broken=%s undetermined=%s file_verdict=%s new_on_branch=%s\n' \
  "$N_PRE" "$N_INH" "$N_BRK" "$N_UND" "$N_FV" "$N_NEW"

# 8. The state side's verdict is the exit: it alone applies the #2688 allow-list.
case "$REC_RC" in
  0|8) exit "$REC_RC" ;;
  3) die 3 "run_tests changed while classifying; re-run /run-tests" ;;
  *) die 1 "run_tests was not completed (evidence exit $REC_RC; its reason is above)" ;;
esac
