#!/usr/bin/env node
"use strict";
// bin/glossary-promote <intent.md> <repo-root> — glossary promotion (#2529): apply the approved
// intent glossary's user / internal rows (add / delete / redefine) to
// <repo-root>/docs/glossary/<category>*.md. New entries get `Related: TODO` (update-docs fills
// it; the gate blocks a leftover TODO); a redefine keeps the Related line. Three layers run
// before the first write: 0 the CONFIRM_INTENT-approved intent only, 1 the rows against the
// glossary files, 2 the applied result against the rows. GLOSSARY_ACCEPTED never unblocks
// promote (named exception). Never creates a glossary file.
// Exit: 0 ok, 1 blocked / invalid glossary file set, 2 usage / unreadable.

const fs = require("fs");
const path = require("path");
const fmt = require(path.join(__dirname, "lib", "glossary-format"));
const prov = require(path.join(__dirname, "lib", "glossary-provenance"));
const { SESSION_ID_VALID_RE } = require(path.join(__dirname, "..", "hooks", "workflow-state", "state-io"));
const { getPlansArtifactPath } = require(path.join(__dirname, "..", "hooks", "lib", "plans-artifact-registry"));
const { toWindowsPath } = require(path.join(__dirname, "..", "hooks", "lib", "branch-diff"));

const USAGE = "usage: glossary-promote <plans-dir>/<sid>-intent.md <repo-root>";
const RECOVERY = "fix the intent `## Glossary` rows (on intent-unapproved / intent-modified, take " +
  "CONFIRM_INTENT again), or edit the glossary by hand and clear the commit-time glossary provenance check block " +
  "with GLOSSARY_ACCEPTED; GLOSSARY_ACCEPTED does not unblock promote.";

function fail(code, msg) {
  process.stderr.write("glossary-promote: " + msg + "\n");
  process.exit(code);
}

function block(lines) {
  for (const l of lines) process.stderr.write("  BLOCK: " + l + "\n");
  fail(1, "nothing promoted — " + RECOVERY);
}

const opLine = (u) => u.term + " " + u.operation + " " + u.category + ": " + u.reason;
const samePath = (a, b) => {
  const n = (p) => path.resolve(toWindowsPath(String(p)));
  return process.platform === "win32" ? n(a).toLowerCase() === n(b).toLowerCase() : n(a) === n(b);
};

// sessionOf(intentPath) -> sid, or exit 2 unless the path is the session's own intent artifact.
function sessionOf(intentPath) {
  const m = /^(.+)-intent\.md$/.exec(path.basename(String(intentPath).replace(/\\/g, "/")));
  if (!m || !SESSION_ID_VALID_RE.test(m[1])) fail(2, USAGE + " (basename must be <sid>-intent.md)");
  let expected;
  try { expected = getPlansArtifactPath(m[1], "intent"); } catch (e) { fail(2, USAGE + " (" + e.message + ")"); }
  if (!samePath(intentPath, expected)) fail(2, USAGE + " (" + intentPath + " is not " + expected + ")");
  return m[1];
}

// locate(texts, files, category, term) -> the file of `category` holding `term`, or null.
function locate(texts, files, category, term) {
  const key = term.toLowerCase();
  for (const f of files) {
    const parsed = fmt.parseGlossaryPath(f);
    if (!parsed || parsed.category !== category) continue;
    if (fmt.parseGlossaryFile(texts.get(f)).entries.some((e) => e.term.toLowerCase() === key)) return f;
  }
  return null;
}

// apply(texts, files, rows) -> counts; edits `texts` in place (delete -> redefine -> add).
function apply(texts, files, rows, changed) {
  const counts = { added: 0, deleted: 0, redefined: 0, existing: 0 };
  const set = (f, t) => { texts.set(f, t); changed.add(f); };
  for (const r of rows.filter((x) => x.operation === "delete")) {
    const f = locate(texts, files, r.category, r.term);
    if (f) { set(f, fmt.removeEntry(texts.get(f), r.term)); counts.deleted += 1; }
  }
  for (const r of rows.filter((x) => x.operation === "redefine")) {
    const f = locate(texts, files, r.category, r.term);
    const next = f && fmt.replaceDefinition(texts.get(f), r.term, r.definition);
    if (next !== null && next !== undefined && f) { set(f, next); counts.redefined += 1; }
  }
  for (const r of rows.filter((x) => x.operation === "add")) {
    if (locate(texts, files, r.category, r.term)) { counts.existing += 1; continue; }
    const target = fmt.fileForTerm(files, r.category, r.term);
    if (target === null) {
      process.stderr.write("WARN: no " + r.category + " glossary file; '" + r.term + "' not promoted\n");
      continue;
    }
    const entry = "### " + r.term + "\n- **Definition**: " + r.definition + "\n- **Related**: TODO\n";
    set(target, fmt.insertEntry(texts.get(target), r.term, entry));
    counts.added += 1;
  }
  return counts;
}

// writeAll(repoRoot, files, texts, io) — each file goes to a sibling temp first; the renames run
// only once every temp write succeeded, so a failed write leaves all originals untouched. A
// failing rename can still leave the earlier files renamed (rename is per file).
function writeAll(repoRoot, files, texts, io) {
  const x = io || fs;
  const staged = [];
  const cleanup = () => { for (const s of staged) { try { x.rmSync(s.tmp, { force: true }); } catch (_) { /* best effort */ } } };
  try {
    for (const f of files) {
      const dest = path.join(repoRoot, f);
      staged.push({ tmp: dest + "." + process.pid + ".promote-tmp", dest });
      x.writeFileSync(staged[staged.length - 1].tmp, texts.get(f));
    }
    while (staged.length > 0) {
      x.renameSync(staged[0].tmp, staged[0].dest);
      staged.shift();
    }
  } catch (e) {
    cleanup();
    throw e;
  }
}

function main(argv) {
  if (argv.length !== 2) fail(2, USAGE);
  const [intentPath, repoRoot] = argv;
  const sid = sessionOf(intentPath);

  const loaded = prov.loadIntentGlossary(sid);
  if (!loaded.ok) block([loaded.case + " " + loaded.reason + (loaded.detail ? " (" + [].concat(loaded.detail).join("; ") + ")" : "")]);

  let files;
  try { files = fmt.listGlossaryFiles(repoRoot); } catch (e) { fail(2, "cannot list " + path.join(repoRoot, fmt.GLOSSARY_DIR) + ": " + (e.code || e.message)); }
  const setErrors = fmt.checkFileSet(files);
  if (setErrors.length > 0) {
    for (const e of setErrors) process.stderr.write(e + "\n");
    fail(1, "glossary file set is invalid; nothing promoted");
  }
  const texts = new Map();
  for (const f of files) texts.set(f, fs.readFileSync(path.join(repoRoot, f), "utf8"));
  const before = prov.readTermSets((p) => texts.get(p), files);

  const rows = loaded.rows.filter((r) => r.category !== "session");
  const rowBlocks = prov.checkIntentRows(before, rows);
  if (rowBlocks.length > 0) block(rowBlocks.map(opLine));

  const changed = new Set();
  const counts = apply(texts, files, rows, changed);
  const after = prov.readTermSets((p) => texts.get(p), files);
  const { unmatched } = prov.matchOperations(prov.computeOperations(before, after), rows, []);
  if (unmatched.length > 0) block(unmatched.map(opLine));

  try { writeAll(repoRoot, [...changed], texts); } catch (e) { fail(2, "cannot write the glossary: " + (e.code || e.message) + "; nothing promoted"); }
  process.stdout.write("ADDED=" + counts.added + " DELETED=" + counts.deleted + " REDEFINED=" + counts.redefined +
    " SKIPPED_EXISTING=" + counts.existing + " SKIPPED_SESSION=" + (loaded.rows.length - rows.length) + "\n");
  return 0;
}

if (require.main === module) process.exit(main(process.argv.slice(2)));

module.exports = { writeAll };
