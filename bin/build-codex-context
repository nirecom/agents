#!/usr/bin/env bash
# bin/build-codex-context
# Builds a unified Codex review context file by concatenating intent.md and
# outline.md from a session plans directory. Handles absent/empty inputs,
# atomic writes, trailing-newline injection, and stale-output cleanup.
set -euo pipefail

# --- Argument parsing ---
PLANS_DIR=""
SID=""
OUTPUT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --plans-dir)  PLANS_DIR="$2"; shift 2 ;;
        --session-id) SID="$2";       shift 2 ;;
        --output)     OUTPUT="$2";    shift 2 ;;
        *) echo "build-codex-context: unknown argument: $1" >&2; exit 1 ;;
    esac
done

# --- Validation ---
[[ -n "$PLANS_DIR" ]] || { echo "build-codex-context: --plans-dir is required" >&2; exit 1; }
[[ -n "$SID" ]]       || { echo "build-codex-context: --session-id is required" >&2; exit 1; }
[[ -n "$OUTPUT" ]]    || { echo "build-codex-context: --output is required" >&2; exit 1; }
[[ -d "$PLANS_DIR" ]] || { echo "build-codex-context: --plans-dir does not exist: $PLANS_DIR" >&2; exit 1; }

# The session id is pasted into names inside the plans dir, so it is validated
# here as well as in the loop: this script is executable on its own, and a design
# that relies on "the caller already checked" is an unstated assumption (#2025
# C9). --output is not checked — it is a complete path the caller chose, not a
# token. The checks are explicit rather than left to `set -e`, so the user gets
# a reason. This same library also provides the publish primitive used below.
SAFE_TOKEN_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/safe-plans-path.sh"
[[ -f "$SAFE_TOKEN_LIB" ]] || { echo "build-codex-context: required library missing: $SAFE_TOKEN_LIB" >&2; exit 1; }
# shellcheck source=/dev/null
source "$SAFE_TOKEN_LIB" || { echo "build-codex-context: required library failed to load: $SAFE_TOKEN_LIB" >&2; exit 1; }
sp_valid_token "$SID" || { echo "build-codex-context: --session-id is not a safe path token: $SID" >&2; exit 1; }

INTENT="$PLANS_DIR/$SID-intent.md"
OUTLINE="$PLANS_DIR/$SID-outline.md"

INTENT_PRESENT=0
OUTLINE_PRESENT=0
[[ -f "$INTENT" && -s "$INTENT" ]] && INTENT_PRESENT=1
[[ -f "$OUTLINE" && -s "$OUTLINE" ]] && OUTLINE_PRESENT=1

# --- Case: both absent/empty → delete stale output, exit 0 ---
if [[ "$INTENT_PRESENT" -eq 0 && "$OUTLINE_PRESENT" -eq 0 ]]; then
    rm -f "$OUTPUT"
    exit 0
fi

# --- Atomic write ---
# _sp_dirname, not dirname(1): for a backslash-spelled --output, dirname answers
# "." and the real parent is never created, so the temp below has nowhere to go.
OUT_DIR="$(_sp_dirname "$OUTPUT")"
mkdir -p "$OUT_DIR"

TMP="$(sp_mktemp_beside "$OUTPUT")" || { echo "build-codex-context: cannot create a temporary file beside $OUTPUT" >&2; exit 1; }
trap 'rm -f "$TMP"' EXIT

inject_trailing_newline_if_missing() {
    local file="$1"
    if [[ "$(tail -c1 "$file" | wc -c)" -gt 0 ]] && [[ "$(tail -c1 "$file" | wc -l)" -eq 0 ]]; then
        printf '\n' >> "$TMP"
    fi
}

if [[ "$INTENT_PRESENT" -eq 1 ]]; then
    printf '<!-- Source: %s -->\n' "$INTENT" >> "$TMP"
    printf '## Section 1: Intent (User Requirements)\n' >> "$TMP"
    cat "$INTENT" >> "$TMP"
    inject_trailing_newline_if_missing "$INTENT"
fi

if [[ "$INTENT_PRESENT" -eq 1 && "$OUTLINE_PRESENT" -eq 1 ]]; then
    printf '\n---\n\n' >> "$TMP"
fi

if [[ "$OUTLINE_PRESENT" -eq 1 ]]; then
    printf '<!-- Source: %s -->\n' "$OUTLINE" >> "$TMP"
    printf '## Section 2: Outline (Design Proposal)\n' >> "$TMP"
    cat "$OUTLINE" >> "$TMP"
    inject_trailing_newline_if_missing "$OUTLINE"
fi

# The danger of mv here is success, not failure: with a directory at $OUTPUT it
# moves the context inside and returns 0, and the loop then marks the context
# built. sp_publish_file decides on the post-rename condition instead, and the
# failure is announced rather than left to `set -e` (#2025 C6).
sp_publish_file "$TMP" "$OUTPUT" || { echo "build-codex-context: could not publish the context to $OUTPUT" >&2; exit 1; }
trap - EXIT

exit 0
