#!/usr/bin/env bash
# Documentation file size review for Markdown docs. Usage: review-doc-size [--staged | --all]
# bin/size-check owns counting, target filtering and the limits (SSOT hooks/lib/size-limits.js,
# kind docs; rules/coding/file-split.md Pattern C). Stream records (history.md, CHANGELOG.md,
# _archive/_archived) are exempt. --staged judges the staged blobs against HEAD and exits 1 when
# a doc is over HARD and does not shrink, so a commit that performs a split passes. --all walks the
# working tree, advisory only (exit 0). The modes are mutually exclusive; no mode is a SKIP.
# A bin/size-check infrastructure error emits "## Doc-size Review: ERROR" and exits 2.

set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib/review-size.sh"

HARD_HIT=0
HDR="## Doc-size Review"

emit_skip() {
  printf '%s\n' "$HDR: SKIPPED — $1"
  exit 0
}

ALL_SCAN=0
STAGED_ONLY=0
BAD_ARG=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL_SCAN=1; shift ;;
    --staged) STAGED_ONLY=1; shift ;;
    *) BAD_ARG=1; shift ;;
  esac
done

[[ "$BAD_ARG" -eq 1 ]] && emit_skip "unrecognized argument"
if [[ "$ALL_SCAN" -eq 1 && "$STAGED_ONLY" -eq 1 ]]; then
  emit_skip "--staged and --all are mutually exclusive"
fi
if [[ "$ALL_SCAN" -eq 0 && "$STAGED_ONLY" -eq 0 ]]; then
  emit_skip "no mode selected (use --staged or --all)"
fi

report_records() {
  local verdict value pre warn hard unit file
  while IFS=$'\t' read -r verdict value pre warn hard unit file; do
    case "$verdict" in
      HARD)
        echo "  HARD: $file — $value lines (exceeds ${hard}-line hard limit; split or trim — see rules/coding/file-split.md Pattern C)"
        HARD_HIT=1 ;;
      SHRINK) echo "  SHRINK: $file — $value lines (over the ${hard}-line hard limit, down from $pre; reducing changes pass)" ;;
      WARN) echo "  WARN: $file — $value lines (exceeds ${warn}-line warn threshold)" ;;
      OK) echo "  INFO: $file — $value lines" ;;
    esac
  done <<< "$RS_RECORDS"
}

if [[ "$ALL_SCAN" -eq 1 ]]; then
  review_size_check "$HDR" docs none worktree < <(find . -type f -name '*.md' \
    -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | sed 's|^\./||' | sort | review_size_worktree_nul)
  echo "$HDR: PERFORMED (all-scan mode)"
  echo ""
  report_records
  echo ""
  echo "  WARN/INFO are advisory in all-scan mode."
  exit 0
fi

# --- staged mode ---
review_size_check "$HDR" docs "$(review_size_pre_head)" index < <(git -c core.quotePath=false diff -z \
  --name-only --cached --diff-filter=ACMRT 2>/dev/null || true)
echo "$HDR: PERFORMED (staged mode)"
echo ""
report_records
echo ""
if [[ "$RS_TARGETS" -eq 0 ]]; then
  echo "  (no staged docs to review)"
fi
echo "  HARD findings block the commit (exit 1). WARN/INFO are advisory."

[[ "$HARD_HIT" -eq 1 ]] && exit 1 || exit 0
