#!/usr/bin/env bash
# Comment-block size review — flags comment blocks carrying more than the threshold's worth of
# comment lines. Usage: review-comment-block-size [--staged | --all]
# Exit: 0 = performed or skipped; 1 = BLOCK (--staged only); 3 = internal error.
# Thin adapter (#2507): bin/review-comment-block-size.d/cli.js owns the review. A missing node
# is an ordinary state on a commit host, so it is a SKIP at rc 0, never a silent all-clear.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
    printf '%s\n' "## Comment-block Size Review: SKIPPED — node runtime unavailable"
    exit 0
fi
exec node "$SCRIPT_DIR/review-comment-block-size.d/cli.js" "$@"
