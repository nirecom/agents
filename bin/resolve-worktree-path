#!/usr/bin/env bash
":" //; : <<'AGENTS_NODE_GUARD'
// #1532 node-misinvocation guard. bash never reads this region: the line above
// is a no-op command plus a quoted here-document that swallows it. node parses
// it as JavaScript, names the mistake and leaves 70 in process.exitCode. Every
// write is fs.writeSync(2, ...) and the guard never calls process.exit, since
// an asynchronous write followed by process.exit can be dropped. EAGAIN on a
// non-blocking stderr is retried, any other error gives the diagnostic up --
// the exit code survives either way. The block comment opened below is closed
// only at end of file: the bash body must never close it early.
const msg = process.argv[1] + ": this is a bash script, not a Node program." +
  " Re-run it as: bash " + process.argv[1] + " [args...]\n";
for (let i = 0; i < 100; i++) {
  try { require("fs").writeSync(2, msg); break; }
  catch (err) { if (err.code !== "EAGAIN") break; }
}
process.exitCode = 70;
/*
AGENTS_NODE_GUARD
set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
if command -v cygpath >/dev/null 2>&1; then
  NODE_DIR="$(cygpath -m "$SCRIPT_DIR")"
else
  NODE_DIR="$SCRIPT_DIR"
fi
# Path travels via env, not string interpolation — apostrophes/metachars in the
# checkout path cannot break or alter the evaluated program.
# Contract (mirrors compute-staged-tests-token.js):
#   no session id           → empty stdout, exit 0
#   session id, no state    → "NOSTATE" stdout, exit 0
#   resolved linked wt      → path stdout, exit 0
#   unresolvable / main wt  → empty stdout, exit 0
BRIDGE_DIR="$NODE_DIR" node -e '
  const path = require("path");
  const sid = process.env.SESSION_ID || process.env.CLAUDE_SESSION_ID || "";
  try {
    if (!sid) { process.stdout.write(""); process.exit(0); }
    const stateIo = require(path.join(process.env.BRIDGE_DIR, "..", "hooks", "workflow-state", "state-io"));
    if (stateIo.readState(sid) === null) { process.stdout.write("NOSTATE"); process.exit(0); }
    const { resolveSessionWorktreePath } = require(path.join(process.env.BRIDGE_DIR, "..", "hooks", "workflow-state", "resolve-worktree-path"));
    const wt = resolveSessionWorktreePath(sid);
    process.stdout.write(wt || "");
  } catch (e) {
    process.stdout.write("");
  }
  process.exit(0);
'
# End of the #1532 node-misinvocation guard envelope: ordinary comments for
# bash. The last line closes the JavaScript block comment opened at the top;
# nothing may follow the marker on that line.
# */
