# Path travels via env, not string interpolation — apostrophes/metachars in the
# checkout path cannot break or alter the evaluated program.
# Contract (mirrors compute-staged-tests-token.js):
#   no session id                          → empty stdout, exit 0
#   session id, no state                   → "NOSTATE" stdout, exit 0
#   resolved linked wt                     → path stdout, exit 0
#   unresolvable / main wt                 → empty stdout, exit 0
#   --session <id> (valid)                 → argument overrides env-derived resolution
#   --session <malformed> / value missing  → stderr, exit 2 (no env fallback)
#   unknown flag                           → stderr, exit 2
BRIDGE_SESSION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session)
      if [ $# -lt 2 ]; then
        echo "resolve-worktree-path: --session requires a value" >&2
        exit 2
      fi
      BRIDGE_SESSION="$2"
      shift 2
      ;;
    *)
      echo "resolve-worktree-path: unknown argument: $1" >&2
      exit 2
