#!/usr/bin/env bash
# bin/concern-ledger — CLI front end for bin/lib/concern-ledger.sh (#1992/#1996).
#
# Every subcommand addresses the ledger by (plans-dir, session-id, format); the
# on-disk paths are derived, never passed in, so no caller can drift from the
# layout the loops and the summarizer agree on.
#
# Exit codes: 0 ok, 1 the verdict subcommands' "not satisfied", 2 usage/invalid
# argument, 3 check-staged could not read the round at all (distinct from 1, so
# a loop can tell a broken listing from a round nobody has staged yet — #2025
# C6), 5 artifact could not be produced (includes: the library could not be
# loaded).
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# This script does not run under `set -e`, so the load needs its own check: a
# half-loaded library turns every cl_* call into "command not found" and the
# round's findings disappear with a success status (#2025 C9).
# shellcheck source=bin/lib/concern-ledger.sh
if ! . "$SELF_DIR/lib/concern-ledger.sh"; then
    printf 'concern-ledger: failed to load %s — refusing to run half-loaded\n' \
        "$SELF_DIR/lib/concern-ledger.sh" >&2
    exit 5
fi

usage() {
    cat >&2 <<'EOF'
usage: concern-ledger <subcommand> [options]

  slot            --path P --anchor A --category C
  bind            --ledger L --delta D
  render-prior    --plans-dir D --session-id S --format F
  stage           --plans-dir D --session-id S --format F --round N
                  --producer P --from-report FILE [--exec LABEL] [--parser MODE]
  reduce          --plans-dir D --session-id S --format F --round N
  tally           --plans-dir D --session-id S --format F
  begin-round     --plans-dir D --session-id S --format F --round N
  finalize        --plans-dir D --session-id S --format F --mode M --reason R
                  --round N --cap C [--max-extensions N] [--extensions-used N]
  check-finalized --plans-dir D --session-id S --format F [--round N]
  check-staged    --plans-dir D --session-id S --format F --round N
EOF
    exit 2
}

SUB="${1:-}"; [ -n "$SUB" ] || usage; shift || true

PLANS=""; SID=""; FORMAT=""; ROUND=""; PRODUCER=""; REPORT=""; EXEC=""
PARSER="anchored"; MODE=""; REASON=""; CAP=""; MAXEXT="0"; USED="0"
LEDGER_ARG=""; DELTA_ARG=""; APATH=""; AANCHOR=""; ACAT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --plans-dir) PLANS="${2:-}"; shift 2 ;;
        --session-id) SID="${2:-}"; shift 2 ;;
        --format) FORMAT="${2:-}"; shift 2 ;;
        --round) ROUND="${2:-}"; shift 2 ;;
        --producer) PRODUCER="${2:-}"; shift 2 ;;
        --from-report) REPORT="${2:-}"; shift 2 ;;
        --exec) EXEC="${2:-}"; shift 2 ;;
        --parser) PARSER="${2:-}"; shift 2 ;;
        --mode) MODE="${2:-}"; shift 2 ;;
        --reason) REASON="${2:-}"; shift 2 ;;
        --cap) CAP="${2:-}"; shift 2 ;;
        --max-extensions) MAXEXT="${2:-}"; shift 2 ;;
        --extensions-used) USED="${2:-}"; shift 2 ;;
        --ledger) LEDGER_ARG="${2:-}"; shift 2 ;;
        --delta) DELTA_ARG="${2:-}"; shift 2 ;;
        --path) APATH="${2:-}"; shift 2 ;;
        --anchor) AANCHOR="${2:-}"; shift 2 ;;
        --category) ACAT="${2:-}"; shift 2 ;;
        -h|--help) usage ;;
        *) printf 'concern-ledger: unknown option: %s\n' "$1" >&2; usage ;;
    esac
done

[ -n "$SID" ] && export CL_SESSION_ID="$SID"

need() { [ -n "$1" ] || { printf 'concern-ledger: %s is required\n' "$2" >&2; usage; }; }

# need_addr — require the 3-part address unless --ledger was given directly.
need_addr() { [ -n "$LEDGER_ARG" ] && return 0; need "$PLANS" --plans-dir; need "$SID" --session-id; need "$FORMAT" --format; }

# validate_round — domain-check --round when supplied. exit 2 on bad value.
validate_round() {
    [ -n "$ROUND" ] || return 0
    case "$ROUND" in
        ''|*[!0-9]*) printf 'concern-ledger: --round must be a positive integer 1-999 (got: %s)\n' "$ROUND" >&2; exit 2 ;;
    esac
    if [ "${#ROUND}" -gt 3 ] || [ "$ROUND" -lt 1 ]; then
        printf 'concern-ledger: --round must be a positive integer 1-999 (got: %s)\n' "$ROUND" >&2; exit 2
    fi
    ROUND="$((10#$ROUND))"
}

# validate_report — for stage: --from-report must exist and be non-empty.
validate_report() {
    [ "$SUB" = "stage" ] || return 0
    if [ ! -f "$REPORT" ]; then
        printf 'concern-ledger: --from-report does not exist: %s\n' "$REPORT" >&2; exit 2
    fi
    if [ ! -s "$REPORT" ]; then
        printf 'concern-ledger: --from-report is empty: %s\n' "$REPORT" >&2; exit 2
    fi
}

# validate_args <sub> — check required args before dispatch; runs outside any
# subshell so exit 2 reaches the caller (#2057).
validate_args() {
    case "$1" in
        slot)     need "$APATH" --path; need "$AANCHOR" --anchor; need "$ACAT" --category ;;
        bind)     need "$LEDGER_ARG" --ledger; need "$DELTA_ARG" --delta ;;
        render-prior|tally|check-finalized) need_addr ;;
        begin-round)    need_addr; need "$ROUND" --round ;;
        reduce)   need_addr; need "$ROUND" --round; validate_glob_tokens reduce ;;
        stage)    need_addr; need "$ROUND" --round; need "$PRODUCER" --producer; need "$REPORT" --from-report ;;
        check-staged) need_addr; need "$ROUND" --round; validate_glob_tokens check-staged ;;
        finalize) need_addr; need "$ROUND" --round ;;
        *) printf 'concern-ledger: unknown subcommand: %s\n' "$1" >&2; usage ;;
    esac
    validate_round
    validate_report
}

# validate_glob_tokens — reduce/check-staged paste SID/FORMAT into a delta-file
# glob directly (#2088's discovery mechanism), bypassing the validated path
# builders (cl_ledger_path etc.) that --ledger otherwise lets need_addr skip
# (#2025 C11). Required even with --ledger set: the glob is built from SID/
# FORMAT regardless of which ledger address form was used.
validate_glob_tokens() {
    _cl_reject_bad_tokens "$1" "$SID" "$FORMAT" || exit 2
}

# The path builders refuse an unsafe token by printing nothing and returning 2
# (#2025 C3). An empty path is never harmless here: pasted into a redirect or a
# reader it silently addresses the working directory instead, so every derived
# path is checked for emptiness at the point it is taken.
resolve_ledger() {
    local p
    if [ -n "$LEDGER_ARG" ]; then printf '%s' "$LEDGER_ARG"; return 0; fi
    p="$(cl_ledger_path "$PLANS" "$SID" "$FORMAT")" || return 2
    [ -n "$p" ] || return 2
    printf '%s' "$p"
}

# bad_path <what> — the refusal message. The check itself stays in the main
# shell at each site: an `exit` inside "$( )" would only leave the subshell.
bad_path() {
    printf 'concern-ledger: could not derive %s from the given arguments\n' "$1" >&2
}

validate_args "$SUB"

case "$SUB" in
    slot)
        cl_slot "$APATH" "$AANCHOR" "$ACAT"; printf '\n'
        ;;
    bind)
        cl_bind "$LEDGER_ARG" "$DELTA_ARG"
        ;;
    render-prior)
        LED="$(resolve_ledger)"
        [ -n "$LED" ] || { bad_path "the ledger path"; exit 2; }
        cl_render_prior "$LED"
        ;;
    begin-round)
        LED="$(resolve_ledger)"
        [ -n "$LED" ] || { bad_path "the ledger path"; exit 2; }
        cl_begin_cycle "$LED" "$FORMAT" "$ROUND"
        ;;
    stage)
        TMPD="$(mktemp -d)" || exit 5
        NORM="$TMPD/norm.txt"
        export CL_PRODUCER="$PRODUCER"
        case "$PARSER" in
            numbered) PARSE="$(cl_parse_numbered "$REPORT" "$NORM")" ;;
            cnref)
                LED="$(resolve_ledger)"
                [ -n "$LED" ] || { bad_path "the ledger path"; rm -rf "$TMPD"; exit 2; }
                PARSE="$(cl_parse_cnref "$REPORT" "$LED" "$NORM")"
                ;;
            *)        PARSE="$(cl_parse_anchored "$REPORT" "$PRODUCER" "$NORM")" ;;
        esac
        if [ -z "$EXEC" ]; then
            EXEC="$(grep -m1 -Eo '^## [A-Za-z ]+: (PERFORMED|SKIPPED|FAILED)' "$REPORT" 2>/dev/null | sed 's/.*: //')"
            SCOPE="$(grep -m1 -Eo '^## [A-Za-z ]+ Scope: (TRUNCATED|BASE-[A-Z-]+)' "$REPORT" 2>/dev/null | sed 's/.*: //')"
            case "$SCOPE" in TRUNCATED|BASE-*) [ "$EXEC" = "PERFORMED" ] && EXEC="$SCOPE" ;; esac
            [ -z "$EXEC" ] && EXEC="PERFORMED"
        fi
        STAGE_RC=0
        CL_STAGE_PREFIX="${SID}-" cl_stage "$PLANS" "$FORMAT" "$ROUND" "$PRODUCER" \
            "$EXEC" "$PARSE" "$NORM" >/dev/null || STAGE_RC=$?
        rm -rf "$TMPD"
        # cl_stage's rc 2 is a rejected argument, not a failed publish, and the
        # CLI's documented exit codes keep those apart: a caller retrying an
        # exit 5 is right, a caller retrying bad tokens never gets anywhere.
        if [ "$STAGE_RC" -eq 2 ]; then
            exit 2
        elif [ "$STAGE_RC" -ne 0 ]; then
            exit 5
        fi
        ;;
    reduce)
        LED="$(resolve_ledger)"
        [ -n "$LED" ] || { bad_path "the ledger path"; exit 2; }
        cl_reduce "$LED" "$PLANS/${SID}-${FORMAT}-round-${ROUND}-delta-*.txt" "$ROUND" "$FORMAT" "$LED"
        ;;
    tally)
        LED="$(resolve_ledger)"
        [ -n "$LED" ] || { bad_path "the ledger path"; exit 2; }
        cl_tally "$LED"; printf '\n'
        ;;
    finalize)
        [ -n "$MODE" ] || MODE="terminal"
        [ -n "$REASON" ] || REASON="review loop ended without convergence"
        [ -n "$CAP" ] || CAP="$ROUND"
        [ -n "$LEDGER_ARG" ] && export CL_LEDGER_OVERRIDE="$LEDGER_ARG"
        if cl_finalize "$PLANS" "$SID" "$FORMAT" "$MODE" "$REASON" "$ROUND" \
                "$CAP" "$MAXEXT" "$USED"; then
            JSONP="$(cl_json_path "$PLANS" "$SID" "$FORMAT")"
            [ -n "$JSONP" ] || { bad_path "the unresolved-concerns path"; exit 2; }
            printf '%s\n' "$JSONP"
        else
            # Announced on both streams: the caller pipes stdout into its own
            # report, while a human watching the terminal only sees stderr. The
            # recovery path is named on stderr alone — stdout becomes a durable
            # artifact, and an absolute path there records the OS account name
            # and the checkout layout in it.
            MSG="## Concern Ledger: FINALIZE-FAILED — ${CL_FINALIZE_ERROR:-could not write the unresolved-concerns artifact}"
            printf '%s\n' "$MSG"
            if [ -n "${CL_RECOVERY:-}" ]; then
                printf '%s (recovered copy: %s)\n' "$MSG" "$CL_RECOVERY" >&2
            else
                printf '%s\n' "$MSG" >&2
            fi
            exit 5
        fi
        ;;
    check-finalized)
        JSONP="$(cl_json_path "$PLANS" "$SID" "$FORMAT")"
        [ -n "$JSONP" ] || { bad_path "the unresolved-concerns path"; exit 2; }
        cl_artifact_ok "$JSONP" "$ROUND" || exit 1
        ;;
    check-staged)
        STAGED_MISSING=""
        _producers="$(cl_declared_producers "$FORMAT" 2>/dev/null)"
        if [ -z "$_producers" ]; then
            _any_ok=0
            _fallback_msg="(no format):missing"
            # Same discovery mechanism as cl_reduce and finalize's producer
            # scan: a glob would eat a Windows plans-dir's backslashes and
            # report "nothing staged" for a round that staged fine (#2088).
            # The helper answers through a process substitution, so its refusal
            # arrives on the armed channel and not as an exit status. This is
            # the caller the distinction matters most to: "nothing staged yet"
            # is the loop's normal state and it waits, while "the directory
            # could not be read" must stop it — so the two get different words
            # and different exit codes (#2025 C6).
            if ! _cl_discovery_arm; then
                printf '(no format):discovery-failed\n'
                exit 3
            fi
            while IFS= read -r -d '' _f; do
                [ -f "$_f" ] || continue
                _hdr="$(_cl_delta_header "$_f")"
                IFS='|' read -r _ _prod _comp _ _ _rnd _ <<< "$_hdr"
                if [ "$_rnd" = "$ROUND" ]; then
                    if [ "$_comp" = "COMPLETE" ]; then
                        _any_ok=1; break
                    else
                        _fallback_msg="(no format):incomplete:$_comp"
                    fi
                fi
            done < <(_cl_list_pattern_files "$PLANS/$SID-$FORMAT-round-$ROUND-delta-*.txt")
            if _cl_discovery_failed; then
                _cl_discovery_disarm
                printf '(no format):discovery-failed\n'
                exit 3
            fi
            _cl_discovery_disarm
            [ "$_any_ok" -eq 0 ] && STAGED_MISSING="$_fallback_msg"
        else
            for _prod in $_producers; do
                _delta="$(cl_delta_path "$PLANS" "$SID" "$FORMAT" "$ROUND" "$_prod" 2>/dev/null)"
                if [ ! -f "$_delta" ] || [ ! -s "$_delta" ]; then
                    STAGED_MISSING="$STAGED_MISSING $_prod:missing"; continue
                fi
                _hdr="$(_cl_delta_header "$_delta")"
                IFS='|' read -r _ _hprod _comp _ _ _rnd _ <<< "$_hdr"
                if [ "$_rnd" != "$ROUND" ]; then
                    STAGED_MISSING="$STAGED_MISSING $_prod:round-mismatch:$_rnd"; continue
                fi
                if [ "$_comp" != "COMPLETE" ]; then
                    STAGED_MISSING="$STAGED_MISSING $_prod:incomplete:$_comp"; continue
                fi
                if [ "$_hprod" != "$_prod" ]; then
                    STAGED_MISSING="$STAGED_MISSING $_prod:producer-mismatch:$_hprod"
                fi
            done
        fi
        STAGED_MISSING="$(printf '%s' "$STAGED_MISSING" | sed 's/^ *//')"
        if [ -n "$STAGED_MISSING" ]; then
            printf '%s\n' "$STAGED_MISSING"
            exit 1
        fi
        exit 0
        ;;
esac
