#!/usr/bin/env bash
# Prompt file size / quality review. Usage: review-prompt-size [--base <ref>] [--all]
# bin/size-check owns counting, target filtering and the limits (SSOT hooks/lib/size-limits.js).
# Emits "## Prompt Size Review: PERFORMED[ (all-scan mode)]" or "...: SKIPPED — <reason>".
# Diff mode exits 1 when a changed prompt file is over HARD and does not shrink; --all always
# exits 0. A bin/size-check infrastructure error emits "## Prompt Size Review: ERROR" and exits 2.

set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib/review-size.sh"

HDR="## Prompt Size Review"
HARD_HIT=0
BASE_REF="origin/main"
BASE_EXPLICIT=0
ALL_SCAN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL_SCAN=1; shift ;;
    --base)
      if [[ $# -lt 2 ]]; then
        echo "$HDR: SKIPPED (--base requires an argument)"; exit 0
      fi
      BASE_REF="$2"; BASE_EXPLICIT=1; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; shift ;;
  esac
done

if [[ "$ALL_SCAN" -eq 1 && "$BASE_EXPLICIT" -eq 1 ]]; then
  echo "$HDR: SKIPPED — --base and --all are mutually exclusive"; exit 0
fi

report_records() {
  local verdict value pre warn hard unit file
  echo ""
  echo "[Line counts]"
  while IFS=$'\t' read -r verdict value pre warn hard unit file; do
    case "$verdict" in
      HARD)
        echo "HARD: $file — $value lines total (exceeds ${hard}-line hard limit; move multi-step procedures to skills/<name>/scripts/ or bin/<tool> — see rules/coding/file-split.md Pattern B)"
        HARD_HIT=1 ;;
      SHRINK) echo "SHRINK: $file — $value lines (over the ${hard}-line hard limit, down from $pre; reducing changes pass)" ;;
      WARN) echo "WARN: $file — $value lines (exceeds ${warn}-line safety net)" ;;
      OK) echo "INFO: $file — $value lines" ;;
    esac
  done <<< "$RS_RECORDS"
  echo ""

  cat <<'EOF'
### Manual review checklist — apply to every prompt file (regardless of line count)

Criteria SSOT: rules/prompt.md (§1 Form — directives, one-line, multi-step → CLI).

EOF
  echo "  HARD findings block the workflow (exit 1) in diff mode. WARN/INFO are advisory."
}

if [[ "$ALL_SCAN" -eq 1 ]]; then
  review_size_check "$HDR" prompt none worktree < <(
    { find skills/ -name SKILL.md 2>/dev/null || true; \
      find rules/ -name '*.md' 2>/dev/null || true; \
      find agents/ -name '*.md' 2>/dev/null || true; \
      find skills/_shared/ -name '*.md' 2>/dev/null || true; } | sort -u | review_size_worktree_nul
  )
  if [[ "$RS_TARGETS" -eq 0 ]]; then
    echo "$HDR: SKIPPED — no prompt files found"; exit 0
  fi
  echo "$HDR: PERFORMED (all-scan mode)"
  echo ""
  echo "All prompt files scanned: $RS_TARGETS"
  report_records
  exit 0
fi

BASE_SHA=$(git merge-base "$BASE_REF" HEAD 2>/dev/null) || {
  echo "$HDR: SKIPPED (merge-base unresolved: $BASE_REF)"; exit 0
}

ERR=$(mktemp)
trap 'rm -f "$ERR"' EXIT
git diff --name-only --diff-filter=ACMRT "$BASE_SHA"...HEAD >/dev/null 2>"$ERR" || true
if [[ -s "$ERR" ]]; then
  echo "$HDR: SKIPPED (git diff failed: $(cat "$ERR"))"; exit 0
fi

review_size_check "$HDR" prompt "rev:$BASE_SHA" worktree < <(review_size_changed_nul "$BASE_SHA")
if [[ "$RS_TARGETS" -eq 0 ]]; then
  echo "$HDR: SKIPPED — no prompt files changed"; exit 0
fi

echo "$HDR: PERFORMED"
echo ""
echo "Changed prompt files: $RS_TARGETS"
report_records

[[ "$HARD_HIT" -eq 1 ]] && exit 1 || exit 0
