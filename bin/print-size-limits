#!/usr/bin/env node
"use strict";
// bin/print-size-limits — render the size limits out of their SSOT, hooks/lib/size-limits.js.
// --markdown-table prints the body of the size-limits generated block in rules/coding/file-split.md;
// --get <kind> prints "<warn> <hard>" for shell and Python callers.

const path = require("path");
const { LIMITS, SCOPES } = require(path.join(__dirname, "..", "hooks", "lib", "size-limits.js"));

const USAGE = "usage: print-size-limits --markdown-table | --get <kind>";

function main(argv) {
  if (argv.length === 1 && argv[0] === "--markdown-table") {
    const rows = ["| Kind | Applies to | Unit | WARN (over) | HARD (over) |", "|---|---|---|---|---|"];
    for (const [kind, l] of Object.entries(LIMITS)) {
      rows.push(`| ${kind} | ${SCOPES[kind]} | ${l.unit} | ${l.warn} | ${l.hard} |`);
    }
    process.stdout.write(rows.join("\n") + "\n");
    return 0;
  }
  if (argv.length === 2 && argv[0] === "--get") {
    const l = Object.prototype.hasOwnProperty.call(LIMITS, argv[1]) ? LIMITS[argv[1]] : null;
    if (!l) {
      process.stderr.write(`print-size-limits: unknown kind: ${argv[1]} (known: ${Object.keys(LIMITS).join(", ")})\n`);
      return 2;
    }
    process.stdout.write(`${l.warn} ${l.hard}\n`);
    return 0;
  }
  process.stderr.write(USAGE + "\n");
  return 2;
}

process.exit(main(process.argv.slice(2)));
