#!/usr/bin/env bash
# settings.json allow-rule drift review: turns `gen-settings-allow.js --check --staged`
# into a PERFORMED/FAIL binary for hooks/pre-commit, fail-closed by construction.
# Never added to install/path-exposed-commands.txt (repo-path invocation only).
# Details: docs/architecture/claude-code/settings.md.

set -uo pipefail

_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
_GEN="$_ROOT/install/gen-settings-allow.js"

fail() { # <message>
    printf '%s\n' "$1"
    printf '%s\n' '## Settings Allow Review: FAIL'
    exit 2
}

if ! command -v node >/dev/null 2>&1; then
    fail "node is not available, so settings.json allow-rule drift cannot be checked."
fi

if [[ ! -f "$_GEN" ]]; then
    fail "install/gen-settings-allow.js is missing, so the drift gate cannot run: restore it before committing."
fi

_OUT="$(node "$_GEN" --check --staged 2>&1)"
_RC=$?

[[ -n "$_OUT" ]] && printf '%s\n' "$_OUT"

if [[ "$_RC" -eq 0 ]]; then
    printf '%s\n' '## Settings Allow Review: PERFORMED'
    exit 0
fi

printf '%s\n' '## Settings Allow Review: FAIL'
exit "$_RC"
