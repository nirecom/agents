":" //; : <<'AGENTS_NODE_GUARD'
// #1532 node-misinvocation guard -- keep intact; never write */ in this file.
// Why it is shaped this way, and how to edit it: docs/agents-repo-dev.md
const msg = process.argv[1] + ": this is a bash script, not a Node program." +
  " Re-run it as: bash " + process.argv[1] + " [args...]\n";
for (let i = 0; i < 100; i++) {
  try { require("fs").writeSync(2, msg); break; }
  catch (err) { if (err.code !== "EAGAIN") break; }
}
process.exitCode = 70;
/*
AGENTS_NODE_GUARD
# Usage:
#   confirm-off <KEY> [<default>]
#       Resolves <KEY> through hooks/lib/config-flag.js beside this script (a sibling
#       wrapper of bin/get-config-var over the same module) and prints exactly one of:
#         OFF   — KEY is explicitly off
#         ON    — KEY is explicitly on, unset (no default), or holds an
#                 unrecognized value (fail-safe ON)
#         ERROR — internal failure (e.g. node cannot start, or config-flag.js /
#                 load-env.js could not be loaded); stderr carries the cause
#       Exit: 0 (OFF) | 1 (ON) | 2 (ERROR) | 64 (usage).
#       Fail-safe OFF instead: run `get-config-var --is-off <KEY> off` and treat
#       ONLY exit 1 as ON.
#
#   Canonical caller idiom (absolute path — resolves #677 WSL/PATH issue):
#     OUT=$(bash "<agents-root>/bin/confirm-off" CONFIRM_X on) || true
#     case "$OUT" in
#       OFF)   ... ;;
#       ON)    ... ;;
#       ERROR) ... ;;
#     esac
#   DO NOT use: OUT=$(... confirm-off ...) without || true — exit 1/2 leaks.

set -u

CF_MODE="verdict"
CF_REPO_ROOT=""
CF_NAME="${1:-}"
CF_DEFAULT="${2:-}"

if [ -z "$CF_NAME" ]; then
  printf 'usage: confirm-off <KEY> [<default>]\n' >&2
  exit 64
fi

# config-flag bootstrap: begin
CF_OUT="$(CONFIG_FLAG_MODE="$CF_MODE" CONFIG_FLAG_NAME="$CF_NAME" CONFIG_FLAG_DEFAULT="$CF_DEFAULT" CONFIG_FLAG_REPO_ROOT="$CF_REPO_ROOT" node -e '
  const fs = require("fs"); const path = require("path"); const e = process.env;
  const a = { mode: e.CONFIG_FLAG_MODE || "value", name: e.CONFIG_FLAG_NAME || "", defaultValue: e.CONFIG_FLAG_DEFAULT || "", repoRoot: e.CONFIG_FLAG_REPO_ROOT || "" };
  for (const k of ["CONFIG_FLAG_MODE", "CONFIG_FLAG_NAME", "CONFIG_FLAG_DEFAULT", "CONFIG_FLAG_REPO_ROOT"]) delete e[k];
  function toNative(p) {
    if (process.platform !== "win32" || p.charAt(0) !== "/") return p;
    const m = /^\/([A-Za-z])\//.exec(p);
    if (m) return m[1] + ":/" + p.slice(3);
    // MSYS_NO_PATHCONV=1 left an MSYS mount path: map the prefix env PWD shares with the native cwd.
    let px = String(e.PWD || ""); let wd = process.cwd();
    while (px.length > 1 && path.basename(px) === path.basename(wd) && path.dirname(wd) !== wd) { px = path.posix.dirname(px); wd = path.dirname(wd); }
    if (px.charAt(0) !== "/") return p;
    if (px === "/") return path.join(wd, p);
    return p === px || p.startsWith(px + "/") ? path.join(wd, p.slice(px.length)) : p;
  }
  let lib = null;
  try {
    const self = fs.realpathSync(toNative(String(process.argv[1] || "")));
    lib = require(path.join(path.dirname(self), "..", "hooks", "lib", "config-flag.js"));
  } catch (_e) { lib = null; }
  if (lib) lib.runCli(a);
  else if (a.mode === "kind") process.stdout.write("failed lib-missing");
  else if (a.mode === "verdict") process.stdout.write("ERROR lib-missing");
  else { const x = e[a.name]; process.stdout.write(x && x.length ? x : a.defaultValue); }
' "${BASH_SOURCE[0]}")"
# config-flag bootstrap: end

case "$CF_OUT" in
  OFF) printf 'OFF\n'; exit 0 ;;
  ON) printf 'ON\n'; exit 1 ;;
  ERROR*)
    printf 'ERROR\n'
    printf 'confirm-off: config resolution failed (%s)\n' "${CF_OUT#ERROR }" >&2
    exit 2 ;;
  *)
    printf 'ERROR\n'
    printf 'confirm-off: config resolution failed (no answer from node)\n' >&2
    exit 2 ;;
esac
# End of the #1532 node-misinvocation guard envelope -- docs/agents-repo-dev.md
# */
