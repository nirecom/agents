#!/usr/bin/env bash
# Resolve the --accepted-tradeoffs source for a codex review stage (#2924).
# Reads every readable candidate plan of the suffix chain that stays inside PLANS_DIR after
# symlink resolution (an escaping or unverifiable candidate is skipped, fail closed), merges
# each stage's `## Accepted Tradeoffs (<stage>)` into <control dir>/accepted-tradeoffs.<chain
# head>.md, and prints that path. The intent stage also takes the legacy heading of the intent
# file; a legacy heading downstream is a carried copy, read only when the intent file is
# unreadable. When no candidate qualifies, a body-less merged file is written — but only after
# the last candidate passes the same containment checks as before (else exit 3).
set -euo pipefail

usage() {
  echo "resolve-accepted-tradeoffs-file: usage: resolve-accepted-tradeoffs-file <PLANS_DIR> <SESSION_ID> <suffix> [<suffix>...]" >&2
  exit 2
}

[[ $# -ge 3 ]] || usage
PLANS_DIR="$1"
SESSION_ID="$2"
shift 2
[[ -n "$PLANS_DIR" && -n "$SESSION_ID" ]] || usage

CANON_MODE=""
if command -v realpath >/dev/null 2>&1; then
  CANON_MODE="realpath"
elif command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
  CANON_MODE="readlink"
fi

canon() {
  case "$CANON_MODE" in
    realpath) realpath -- "$1" 2>/dev/null || true ;;
    readlink) readlink -f -- "$1" 2>/dev/null || true ;;
    *) : ;;
  esac
}

lex_norm() {
  local p="$1" prefix="" seg out=""
  local -a segs=() keep=()
  # Win32 consumers treat `\` as a separator, so `..\..` must collapse here too.
  p="${p//\\//}"
  case "$p" in /*) prefix="/" ;; esac
  local IFS='/'
  # A here-string ends `read` at the first newline, dropping the rest of a path that embeds one.
  set -f
  segs=($p)
  set +f
  for seg in "${segs[@]}"; do
    case "$seg" in
      ''|'.') continue ;;
      '..')
        if [[ "${#keep[@]}" -gt 0 && "${keep[${#keep[@]}-1]}" != ".." ]]; then
          unset "keep[${#keep[@]}-1]"
          keep=("${keep[@]+"${keep[@]}"}")
        else
          keep+=("..")
        fi
        ;;
      *) keep+=("$seg") ;;
    esac
  done
  out="${keep[*]+${keep[*]}}"
  printf '%s%s' "$prefix" "$out"
}

REAL_DIR="$(canon "$PLANS_DIR")"
LEX_DIR="$(lex_norm "$PLANS_DIR")"

# 0 = inside, 1 = outside, 2 = undecidable (no canonicalizer).
canon_status() {
  local rp
  [[ -n "$CANON_MODE" && -n "$REAL_DIR" ]] || return 2
  rp="$(canon "$1")"
  [[ -n "$rp" ]] || return 2
  if [[ "$rp" == "$REAL_DIR"/* ]]; then return 0; fi
  return 1
}

# Plan basename <first_session_id>-<suffix>.md (#2633, #2748). Only the basename is taken from
# bin/plan-artifact-path, so the candidate keeps PLANS_DIR's own spelling and every
# inside-PLANS_DIR check below still applies. An unresolvable plan is no candidate at all.
# Exception: an id that is not a session id (SESSION_ID_VALID_RE, hooks/workflow-state/state-io/core.js)
# has no state and so no session chain; its first_session_id is itself, and the containment checks
# below still judge the resulting name.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$PLANS_DIR" in /*|[A-Za-z]:*) ABS_PLANS_DIR="$PLANS_DIR" ;; *) ABS_PLANS_DIR="$PWD/$PLANS_DIR" ;; esac
owned_name() {
  local p name step="$1"
  if [[ ! "$SESSION_ID" =~ ^[A-Za-z0-9_-]+$ ]]; then
    printf '%s' "$SESSION_ID-$1.md"
    return 0
  fi
  # The CLI takes the workflow step; only the intent plan's suffix differs from its step name.
  [[ "$step" == intent ]] && step=clarify_intent
  p="$(node "$SCRIPT_DIR/plan-artifact-path" --step "$step" --session "$SESSION_ID" --plans-dir "$ABS_PLANS_DIR" 2>/dev/null)" || return 1
  name="${p##*[/\\]}"
  [[ -n "$name" && "$name" == *"-$1.md" && "$name" != *..* ]] || return 1
  printf '%s' "$name"
}

EXTRACT="$SCRIPT_DIR/extract-mandatory-sections"
PLAN_SCHEMA="$SCRIPT_DIR/../hooks/lib/plan-schema.js"
HEAD_SFX="$1"
LAST=""
READ_SFX=()
READ_FILE=()
for sfx in "$@"; do
  case "$sfx" in
    intent|outline|detail)
      NAME="$(owned_name "$sfx")" || continue
      CAND="$PLANS_DIR/$NAME" ;;
    *) CAND="$PLANS_DIR/$SESSION_ID-$sfx.md" ;;
  esac
  LAST="$CAND"
  [[ -f "$CAND" && -s "$CAND" && -r "$CAND" ]] || continue
  ST=0
  canon_status "$CAND" || ST=$?
  [[ "$ST" -eq 0 ]] || continue
  READ_SFX+=("$sfx")
  READ_FILE+=("$CAND")
done

# write_merged — merge the stages of the readable candidates into the control file and print it.
# Returns 1 when no merged file can be named (a chain head or session id that is no plain token
# has no control-dir file); the caller then forwards the first readable candidate as before, and
# with none readable there is nothing to forward (exit 3).
write_merged() {
  local out legacy stage i heading
  [[ "$HEAD_SFX" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  out="$(node "$SCRIPT_DIR/workflow-control-dir" --session "$SESSION_ID" --file "accepted-tradeoffs.$HEAD_SFX.md" --for-write 2>/dev/null)" || return 1
  [[ -n "$out" ]] || return 1
  legacy="$(node "$PLAN_SCHEMA" --accepted-tradeoffs-headings 2>/dev/null | tail -n 1 | tr -d '\r')"
  [[ -n "$legacy" ]] || legacy="Accepted Tradeoffs"
  # A directory at $out would swallow the rename and leave a directory path as the answer.
  [[ -d "$out" ]] && return 1
  # Global, not local: the EXIT trap runs after this function returns. Called under `||`, so
  # errexit is off here and every write checks its own status.
  MERGE_TMP="$out.tmp.$$"
  trap 'rm -f "${MERGE_TMP:-}"' EXIT
  : > "$MERGE_TMP" || return 1
  for stage in intent outline detail; do
    heading="$(node "$PLAN_SCHEMA" --accepted-tradeoffs-heading "$stage" 2>/dev/null | tr -d '\r')" || return 1
    [[ -n "$heading" ]] || return 1
    local body="" upstream="" own_read=0
    for ((i = 0; i < ${#READ_SFX[@]}; i++)); do
      upstream="${READ_FILE[$i]}"
      [[ "${READ_SFX[$i]}" == "$stage" ]] || continue
      own_read=1
      body="$("$EXTRACT" "${READ_FILE[$i]}" --section "$heading" --with-headers 2>/dev/null || true)"
      if [[ -z "$body" && "$stage" == intent ]]; then
        body="$("$EXTRACT" "${READ_FILE[$i]}" --section "$legacy" --with-headers 2>/dev/null || true)"
      fi
    done
    # Rescue: with the intent file unreadable, the most upstream readable file's legacy heading
    # (the last readable candidate — the chain runs downstream to upstream) is the intent stage.
    if [[ "$stage" == intent && "$own_read" -eq 0 && -n "$upstream" ]]; then
      body="$("$EXTRACT" "$upstream" --section "$legacy" --with-headers 2>/dev/null || true)"
    fi
    [[ -n "$body" ]] || continue
    if [[ -s "$MERGE_TMP" ]]; then printf '\n' >> "$MERGE_TMP" || return 1; fi
    printf '## %s\n%s\n' "$heading" "$(printf '%s\n' "$body" | tail -n +2)" >> "$MERGE_TMP" || return 1
  done
  mv -f "$MERGE_TMP" "$out" || return 1
  [[ -f "$out" && ! -d "$out" ]] || return 1
  printf '%s\n' "$out"
  exit 0
}

if [[ "${#READ_SFX[@]}" -gt 0 ]]; then
  write_merged || { printf '%s\n' "${READ_FILE[0]}"; exit 0; }
fi

if [[ -z "$LAST" ]]; then
  echo "resolve-accepted-tradeoffs-file: no candidate plan path could be resolved." >&2
  exit 3
fi
LEX_LAST="$(lex_norm "$LAST")"
if [[ "$LEX_LAST" != "$LEX_DIR"/* ]]; then
  echo "resolve-accepted-tradeoffs-file: the last candidate path leaves the plans directory; refusing to forward it." >&2
  exit 3
fi
if [[ -e "$LAST" || -L "$LAST" ]]; then
  ST=0
  canon_status "$LAST" || ST=$?
  REL="${LAST#"$PLANS_DIR"/}"
  DIRECT_CHILD=0
  case "$REL" in */*|*\\*) ;; *) DIRECT_CHILD=1 ;; esac
  # An unverifiable candidate is emitted only when no canonicalizer exists at
  # all, it is not a symlink, and it is a direct child of PLANS_DIR.
  if [[ "$ST" -ne 0 && ( -n "$CANON_MODE" || -L "$LAST" || "$DIRECT_CHILD" -eq 0 ) ]]; then
    echo "resolve-accepted-tradeoffs-file: the last candidate resolves outside the plans directory; refusing to forward it." >&2
    exit 3
  fi
fi
if ! write_merged; then
  echo "resolve-accepted-tradeoffs-file: no candidate is readable and the chain has no merged-file name; refusing to forward it." >&2
  exit 3
fi
