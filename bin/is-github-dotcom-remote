#!/usr/bin/env bash
":" //; : <<'AGENTS_NODE_GUARD'
// #1532 node-misinvocation guard. bash never reads this region: the line above
// is a no-op command plus a quoted here-document that swallows it. node parses
// it as JavaScript, names the mistake and leaves 70 in process.exitCode. Every
// write is fs.writeSync(2, ...) and the guard never calls process.exit, since
// an asynchronous write followed by process.exit can be dropped. EAGAIN on a
// non-blocking stderr is retried, any other error gives the diagnostic up --
// the exit code survives either way. The block comment opened below is closed
// only at end of file: the bash body must never close it early.
const msg = process.argv[1] + ": this is a bash script, not a Node program." +
  " Re-run it as: bash " + process.argv[1] + " [args...]\n";
for (let i = 0; i < 100; i++) {
  try { require("fs").writeSync(2, msg); break; }
  catch (err) { if (err.code !== "EAGAIN") break; }
}
process.exitCode = 70;
/*
AGENTS_NODE_GUARD
# Detects whether a git repo's origin remote is github.com.
# Exit 0 = github.com, 1 = non-GitHub, 2 = unknown/error (fail-open)
#
# Usage: is-github-dotcom-remote [<repo-dir>]
#        is-github-dotcom-remote --url <remote-url>
#   Default <repo-dir> is the current directory ($PWD).
#
# --url classifies a remote URL the caller already read, instead of reading
# `git remote get-url origin` here. A caller that both PARSES the URL (for
# owner/repo) and CLASSIFIES it (for the host) must not read the remote twice:
# two independent reads can diverge, and the parsed value would then never have
# been the value this classifier approved (#1899). --url makes the parsed bytes
# and the classified bytes provably identical.
set -u

url=""

if [ "${1:-}" = "--url" ]; then
    # Empty/absent URL is indistinguishable from "no origin" → unknown.
    [ "$#" -ge 2 ] || exit 2
    url="$2"
else
    DIR="${1:-.}"
    url=$(git -C "$DIR" remote get-url origin 2>/dev/null) || exit 2
fi

[ -z "$url" ] && exit 2

host=""

# URL scheme (https://, http://, ssh://, git://, etc.)
if [[ "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://([^@/]+@)?([^/:]+) ]]; then
    host="${BASH_REMATCH[2]}"
# SCP-like: user@host:path (e.g. git@github.com:owner/repo.git)
elif [[ "$url" =~ ^[^@/:]+@([^:]+): ]]; then
    host="${BASH_REMATCH[1]}"
else
    exit 2
fi

[ -z "$host" ] && exit 2

host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"

if [ "$host" = "github.com" ]; then
    exit 0
else
    exit 1
fi
# End of the #1532 node-misinvocation guard envelope: ordinary comments for
# bash. The last line closes the JavaScript block comment opened at the top;
# nothing may follow the marker on that line.
# */
