#!/usr/bin/env bash
# bin/run-codex-review-loop
# Wrapper for steps b (context build) + c (reviewer) + d (verdict parse) of
# skills/_shared/codex-review-loop.md. Per-format behaviour (which reviewer, how
# its output is parsed, whether the input is a path or a ref, which ledger token,
# whether the scanner fallback is allowed) lives in the fp_resolve() table
# sourced from the FP_LIB path resolved below.
#
# Exit codes (SSOT table: skills/_shared/codex-review-loop.md):
#   0 APPROVED (or silent LAND)  1 NON_APPROVED_VERDICT  2 ESCALATE
#   3 codex CLI unusable -> caller falls back to REVIEWER_AGENT subagent
#   4 wrapper/config/parser failure -> caller MUST halt, no fallback
#   5 AUTO_EXTEND (caller increments EXTENSIONS_USED, re-enters)
#   6 HIGH_UNRESOLVED (high-severity concerns remain at budget ceiling)
#   7 FINALIZE-FAILED (the unresolved-concerns artifact could not be written)
set -uo pipefail
REDUCE_COMMITTED=false
PRESTAGED_MODE=0
# 1 only for a prestaged pass that ALLOCATED its own round (the scanner fallback
# entered with no --round: #2276 S8-d). A prestaged JOIN (--round given) leaves
# this 0 so settle_round_counter never touches a counter the reviewer pass owns.
PRESTAGED_ADVANCED=0

die() {
  echo "run-codex-review-loop: script error: $1" >&2
  exit 4
}

require_value() {
  local flag="$1"
  local val="${2-__MISSING__}"
  [[ "$val" != "__MISSING__" && -n "$val" ]] || die "$flag requires a value"
  [[ "$val" != --* ]] || die "$flag requires a value (got flag-like token: $val)"
}

# --- Pre-flight: AGENTS_CONFIG_DIR and core-principles.md ---
[[ -n "${AGENTS_CONFIG_DIR:-}" ]] || die "AGENTS_CONFIG_DIR is not set"
[[ -d "$AGENTS_CONFIG_DIR" ]]      || die "AGENTS_CONFIG_DIR does not exist: $AGENTS_CONFIG_DIR"
CORE_PRINCIPLES="$AGENTS_CONFIG_DIR/rules/core-principles.md"
[[ -f "$CORE_PRINCIPLES" ]] || die "required context missing: $CORE_PRINCIPLES"

CODEX_CORE="$AGENTS_CONFIG_DIR/bin/lib/codex-core.sh"
# shellcheck source=/dev/null
[[ -f "$CODEX_CORE" ]] && source "$CODEX_CORE"

FORMAT=""
SID=""
PLANS_DIR=""
DRAFT=""
CAP=""
MAX_EXT=""
EXT_USED="0"
TRADEOFFS=""
CLASS_MEMBERS=""
ROUND=""
FORCE_ROUND=""
LEDGER_OVERRIDE=""
EXTRA_CTX=()
REPO_ROOT_ARG=""
RISK_SIGNAL=""
BASE_STATE_ARG=""
PRESTAGED_REPORT=""
PRESTAGED_PRODUCER=""
PRESTAGED_EXEC=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --format)
      require_value "--format" "${2:-}"
      FORMAT="$2"; shift 2 ;;
    --session-id)
      require_value "--session-id" "${2:-}"
      SID="$2"; shift 2 ;;
    --plans-dir)
      require_value "--plans-dir" "${2:-}"
      PLANS_DIR="$2"; shift 2 ;;
    # Note: --draft-file is the path the planner wrote to (now the in-place final-artifact path).
    --draft-file)
      require_value "--draft-file" "${2:-}"
      DRAFT="$2"; shift 2 ;;
    --cap)
      require_value "--cap" "${2:-}"
      CAP="$2"; shift 2 ;;
    --max-extensions)
      require_value "--max-extensions" "${2:-}"
      MAX_EXT="$2"; shift 2 ;;
    --extensions-used)
      require_value "--extensions-used" "${2:-}"
      EXT_USED="$2"; shift 2 ;;
    --accepted-tradeoffs)
      require_value "--accepted-tradeoffs" "${2:-}"
      TRADEOFFS="$2"; shift 2 ;;
    # Class members SSOT is intent.md (#2228), a path-kind concern only; forwarded
    # to review-plan-codex via path_build_args. Optional: absent -> empty -> not forwarded.
    --class-members)
      require_value "--class-members" "${2:-}"
      CLASS_MEMBERS="$2"; shift 2 ;;
    --round)
      require_value "--round" "${2:-}"
      ROUND="$2"; shift 2 ;;
    --ledger)
      require_value "--ledger" "${2:-}"
      LEDGER_OVERRIDE="$2"; shift 2 ;;
    --context)
      require_value "--context" "${2:-}"
      EXTRA_CTX+=("$2"); shift 2 ;;
    --repo-root)
      require_value "--repo-root" "${2:-}"
      REPO_ROOT_ARG="$2"; shift 2 ;;
    --risk-signal)
      require_value "--risk-signal" "${2:-}"
      RISK_SIGNAL="$2"; shift 2 ;;
    # ref-kind only: pin the reviewer's base-state (SUSPECT|FALLBACK|UNRESOLVED|
    # CLEAN) instead of letting rk_build_args auto-resolve the merge-base. The
    # reviewer then emits "## Codex Review Scope: BASE-<state>" and the exec
    # label auto-derives to PARTIAL for a non-CLEAN base (#2276 S8). --base is an
    # accepted alias so a caller can pass either spelling.
    --base|--base-state)
      require_value "$1" "${2:-}"
      BASE_STATE_ARG="$2"; shift 2 ;;
    --force-round)
      require_value "--force-round" "${2:-}"
      FORCE_ROUND="$2"; shift 2 ;;
    # The scanner fallback re-enters the loop with a report it already produced
    # (#2276 S8-d). All three prestaged flags are required together; the pass
    # joins the current round without a reviewer run or a counter advance.
    --prestaged-report)
      require_value "--prestaged-report" "${2:-}"
      PRESTAGED_REPORT="$2"; shift 2 ;;
    --prestaged-producer)
      require_value "--prestaged-producer" "${2:-}"
      PRESTAGED_PRODUCER="$2"; shift 2 ;;
    --prestaged-exec)
      require_value "--prestaged-exec" "${2:-}"
      PRESTAGED_EXEC="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$FORMAT" ]]    || die "--format is required"
[[ -n "$SID" ]]       || die "--session-id is required"
[[ -n "$PLANS_DIR" ]] || die "--plans-dir is required"
[[ -n "$CAP" ]]       || die "--cap is required"
[[ -n "$MAX_EXT" ]]   || die "--max-extensions is required"
[[ -n "$TRADEOFFS" ]] || die "--accepted-tradeoffs is required"
if [[ -n "${ROUND:-}" ]] && [[ -n "${FORCE_ROUND:-}" ]]; then
  echo "run-codex-review-loop: --round and --force-round are mutually exclusive" >&2; exit 4
fi
if [[ -n "$ROUND" ]]; then
  [[ "$ROUND" =~ ^[1-9][0-9]*$ ]] || { echo "run-codex-review-loop: --round must be a positive integer" >&2; exit 4; }
fi
# Did the caller name the round, or did the loop derive it from the counter?
# The round >= 2 ledger-absent guard (see below) distinguishes the two: an
# explicitly named round asserts prior state that must be there, while an
# auto-derived resume of the persisted counter (#2276 S9-c) treats a missing
# ledger as "the prior cycle left nothing to carry" and opens the cycle.
ROUND_EXPLICIT=0
if [[ -n "${ROUND:-}" ]] || [[ -n "${FORCE_ROUND:-}" ]]; then
  ROUND_EXPLICIT=1
fi

# --- Per-format parameters (fp_resolve): the one allowlist for --format ---
FP_LIB="$AGENTS_CONFIG_DIR/bin/lib/codex-review-loop/format-params.sh"
[[ -f "$FP_LIB" ]] || die "required library missing: $FP_LIB"
# shellcheck source=/dev/null
source "$FP_LIB" || die "required library failed to load: $FP_LIB"
fp_resolve "$FORMAT" || die "--format must be detail-plan, outline-plan, security-plan, test-review, or security-code"
LEDGER_FORMAT="$FP_LEDGER_FORMAT"
INPUT_KIND="$FP_INPUT_KIND"
PARSE_MODE="$FP_PARSE_MODE"
PRESTAGED_POLICY="$FP_PRESTAGED"
REVIEWER_BIN="$FP_REVIEWER"
CL_PRODUCER_NAME="$FP_REVIEWER"
# Exported so cl_reduce's per-entry provenance gate can tell an intentional
# scanner-ABSENT format (0) from one where a missing scanner means "not run" (1,
# fail-closed, #2344).
export FP_SCANNER_REQUIRED="$FP_SCANNER_REQUIRED"

# --- Prestaged (scanner fallback) flag validation ---
if [[ -n "$PRESTAGED_REPORT$PRESTAGED_PRODUCER$PRESTAGED_EXEC" ]]; then
  [[ -n "$PRESTAGED_REPORT" && -n "$PRESTAGED_PRODUCER" && -n "$PRESTAGED_EXEC" ]] \
    || die "--prestaged-report, --prestaged-producer and --prestaged-exec are required together"
  [[ "$PRESTAGED_POLICY" == "allow" ]] \
    || die "--prestaged-report is not permitted for format: $FORMAT"
  # The exec label must be one concern-ledger recognises: an unknown token would
  # otherwise fall through cl_exec_completeness's default to ABSENT and stage a
  # silently-degraded round. Reject it here (#2276 S8-d / P6).
  case "$PRESTAGED_EXEC" in
    PERFORMED|COMPLETE|TRUNCATED|PARTIAL|ABSENT|BASE-*) : ;;
    *) die "--prestaged-exec must be one of PERFORMED|COMPLETE|TRUNCATED|PARTIAL|ABSENT|BASE-* (got: $PRESTAGED_EXEC)" ;;
  esac
  PRESTAGED_MODE=1
fi

# --draft-file is a path-kind concern only: ref-kind reviewers diff the tree.
# A --draft-file handed to a ref-kind format is refused (fail-closed), never
# silently ignored: the caller believes it named the review input (#2276 S8-b).
if [[ "$INPUT_KIND" == "path" ]]; then
  [[ -n "$DRAFT" ]] || die "--draft-file is required"
else
  [[ -z "$DRAFT" ]] || die "--draft-file is not accepted for ref-kind format: $FORMAT"
fi

# Validated here, not at the ledger CLI: this wrapper builds and *creates*
# $PLANS_DIR/$SID-... itself — the context file, the built-marker, the round
# counter, the last-round file and the round lock — long before any concern-
# ledger code runs, so guarding only the CLI leaves this prefix open (#2025 C9).
SAFE_TOKEN_LIB="$AGENTS_CONFIG_DIR/bin/lib/safe-plans-path.sh"
[[ -f "$SAFE_TOKEN_LIB" ]] || die "required library missing: $SAFE_TOKEN_LIB"
# shellcheck source=/dev/null
source "$SAFE_TOKEN_LIB" || die "required library failed to load: $SAFE_TOKEN_LIB"
sp_valid_token "$SID" || die "--session-id must match [A-Za-z0-9._-]+ and contain no '..' or separators (got: $SID)"

if [[ "$INPUT_KIND" == "path" ]]; then
  [[ -f "$DRAFT" ]] || die "draft file does not exist: $DRAFT"
fi
[[ -d "$PLANS_DIR" ]] || die "plans dir does not exist: $PLANS_DIR"

if [[ -z "$REPO_ROOT_ARG" ]]; then
  REPO_ROOT_ARG="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -n "$REPO_ROOT_ARG" ]] && [[ ! -d "$REPO_ROOT_ARG" ]]; then
  die "--repo-root is not a directory: $REPO_ROOT_ARG"
fi

BUILDER="$AGENTS_CONFIG_DIR/bin/build-codex-context"
REVIEWER="$AGENTS_CONFIG_DIR/bin/$REVIEWER_BIN"
[[ -f "$BUILDER" ]]  || die "build-codex-context not found: $BUILDER"
[[ -f "$REVIEWER" ]] || die "reviewer not found: $REVIEWER"

mkdir -p "$PLANS_DIR" || die "cannot create PLANS_DIR: $PLANS_DIR"

CONTEXT_OUT="$PLANS_DIR/$SID-codex-context.md"
MARKER="$PLANS_DIR/$SID-codex-context.$FORMAT.built"
# The ledger is addressed by the shared ledger token, the round counter by the
# loop format: security-code and the security-plan review share one ledger while
# keeping separate round counters (#2276 S8-a).
if [[ -n "$LEDGER_OVERRIDE" ]]; then
  LEDGER="$LEDGER_OVERRIDE"
else
  LEDGER="$PLANS_DIR/$SID-$LEDGER_FORMAT-concern-ledger.txt"
fi

# --- Round counter management: SSOT for ROUND allocation (P2-2b/c) ---
ROUND_FILE="$PLANS_DIR/$SID-$FORMAT-round-number.txt"
LAST_ROUND_FILE="$PLANS_DIR/$SID-$FORMAT-last-round.txt"
ROUND_LOCK="$ROUND_FILE.lock"
ROUND_LOCK_HELD=0

# --- Sourced helper modules (rules/coding/file-split.md Pattern A) ---
CRL_LIB="$AGENTS_CONFIG_DIR/bin/lib/codex-review-loop"
# shellcheck source=bin/lib/codex-review-loop/round-counter.sh
source "$CRL_LIB/round-counter.sh"  || die "required library failed to load: round-counter.sh"
# shellcheck source=bin/lib/codex-review-loop/ledger-verdict.sh
source "$CRL_LIB/ledger-verdict.sh" || die "required library failed to load: ledger-verdict.sh"
# shellcheck source=bin/lib/codex-review-loop/path-parse.sh
source "$CRL_LIB/path-parse.sh"     || die "required library failed to load: path-parse.sh"
# shellcheck source=bin/lib/codex-review-loop/ref-kind-input.sh
source "$CRL_LIB/ref-kind-input.sh" || die "required library failed to load: ref-kind-input.sh"
# shellcheck source=bin/lib/codex-review-loop/verdict-dispatch.sh
source "$CRL_LIB/verdict-dispatch.sh" || die "required library failed to load: verdict-dispatch.sh"
# shellcheck source=bin/lib/codex-review-loop/prestaged-pass.sh
source "$CRL_LIB/prestaged-pass.sh"  || die "required library failed to load: prestaged-pass.sh"

resolve_concern_ledger || die "concern-ledger not found under AGENTS_CONFIG_DIR (${AGENTS_CONFIG_DIR}) or beside the wrapper ($(dirname "$(dirname "$0")")); set AGENTS_CONFIG_DIR to your agents checkout"

# The scanner may only stage under a producer the ledger format admits (#2276 C3).
if (( PRESTAGED_MODE == 1 )); then
  PRESTAGED_ALLOWED="$(cl_allowed_producers_list)"
  case $'\n'"$PRESTAGED_ALLOWED"$'\n' in
    *$'\n'"$PRESTAGED_PRODUCER"$'\n'*) : ;;
    *) die "--prestaged-producer not permitted for format ${FORMAT}: $PRESTAGED_PRODUCER" ;;
  esac
fi

FINAL_RC=4
trap 'settle_round_counter "$FINAL_RC"; release_round_lock; rm -f "${TMP_OUT:-}"' EXIT

# PRESTAGED (scanner fallback) pass — joins the current round, no reviewer run,
# no counter advance (#2276 S8-d). Body extracted to prestaged-pass.sh under
# rules/coding/file-split.md Pattern A; run_prestaged_pass exits the process.
if (( PRESTAGED_MODE == 1 )); then
  run_prestaged_pass
fi

# ===========================================================================
# REVIEWER pass — allocate the round, run the reviewer, fold its findings.
# ===========================================================================
acquire_round_lock

ROUND_FILE_EXISTED=0
ROUND_PREV=0
if [[ -n "${FORCE_ROUND:-}" ]] && [[ -f "$ROUND_FILE" ]]; then
  ROUND_FILE_EXISTED=1
  if ! ROUND_PREV="$(read_round_file)"; then
    ROUND_PREV=0
    echo "run-codex-review-loop: round counter could not be parsed (${ROUND_FILE}); treating as 0 for --force-round recovery" >&2
  fi
elif [[ -f "$ROUND_FILE" ]]; then
  ROUND_FILE_EXISTED=1
  if ! ROUND_PREV="$(read_round_file)"; then
    echo "run-codex-review-loop: round counter is corrupt: ${ROUND_FILE} (content is not a bare integer 1-999); inspect it and re-run with --force-round <N> once the correct round is known" >&2
    exit 4
  fi
fi

if [[ -n "${FORCE_ROUND:-}" ]]; then
  ROUND="$FORCE_ROUND"
  echo "run-codex-review-loop: --force-round ${ROUND} overrides the recorded round counter (recorded: ${ROUND_PREV}) — recovery/test use only" >&2
elif [[ -z "${ROUND:-}" ]]; then
  ROUND=$(( ROUND_PREV + 1 ))
elif (( ROUND != ROUND_PREV + 1 )); then
  echo "run-codex-review-loop: --round ${ROUND} does not follow the recorded round counter (recorded: ${ROUND_PREV}, expected: $(( ROUND_PREV + 1 ))); use --force-round for recovery" >&2
  exit 4
fi
write_round_file "$ROUND"
ROUND_WRITTEN="$ROUND"
release_round_lock
# --- End round counter management ---

# test-review: always rebuild context to avoid stale compacted-conversation bleed (#1376)
if [[ "$FORMAT" == "test-review" ]]; then
  if [[ -f "$MARKER" ]]; then
    echo "[run-codex-review-loop] test-review: clearing stale built marker for fresh context rebuild" >&2
  fi
  rm -f "$MARKER"
fi

if [[ ! -f "$MARKER" ]]; then
  if ! bash "$BUILDER" --plans-dir "$PLANS_DIR" --session-id "$SID" --output "$CONTEXT_OUT"; then
    die "build-codex-context failed"
  fi
  # An empty publish, not a truncating redirect: $MARKER is predictable (C6).
  : | sp_publish_stdin "$MARKER" || die "cannot create marker: $MARKER"
fi

# The round >= 2 ledger guard is shared by both input kinds: an *explicitly*
# named round >= 2 (--round / --force-round) with no ledger would restart
# concern IDs from C1, so it is refused (see #748/#776/#2068). An auto-derived
# resume of the persisted counter (#2276 S9-c) is not that failure: the counter
# only survives a non-terminal round, and a missing ledger there means the prior
# cycle produced nothing to carry, so the loop opens the cycle rather than
# refusing. The caller of a review-only format never passes --round, so this
# relaxation is confined to the counter-resume path.
if [[ "$ROUND" -ge 2 ]] && [[ ! -f "$LEDGER" ]] && (( ROUND_EXPLICIT == 1 )); then
  echo "run-codex-review-loop: ledger missing for round ${ROUND} (expected at ${LEDGER}); refusing to restart concern IDs from C1 (see #748/#776/#2068)" >&2
  exit 4
fi

TMP_OUT=$(mktemp) || die "mktemp failed"

if [[ "$INPUT_KIND" == "path" ]]; then
  path_build_args
else
  # ref-kind (security-code): review-code-codex diffs the tree; no --input.
  rk_build_args
fi

bash "$REVIEWER" "${ARGS[@]}" > "$TMP_OUT"
RV=$?

if [[ $RV -ne 0 ]]; then
  echo "run-codex-review-loop: codex unavailable ($REVIEWER_BIN exited $RV)" >&2
  exit 3
fi

# S8-f unified every shared reviewer (review-plan-codex and review-code-codex)
# on the single label "## Codex Review: <status>", so the header is matched by
# that exact prefix — never by first-line position, which a "## Codex Review
# Scope:" preamble line would otherwise capture. The retired "## Codex Plan
# Review:" label no longer exists in the tree and is deliberately not accepted:
# a stale reviewer emitting it yields an empty HEADER -> unrecognized -> exit 4.
HEADER=$(grep -m1 '^## Codex Review: ' "$TMP_OUT" | tr -d '\r')
STATUS="${HEADER##*Review: }"

case "$STATUS" in
  PERFORMED)
    : ;;
  "FAILED — round cap reached"*)
    echo "run-codex-review-loop: round cap reached" >&2
    exit 2 ;;
  SKIPPED*)
    # The reviewer explained on stdout why it produced no review; the author
    # must see that before the fallback fires, so emit it, then exit 3.
    cat "$TMP_OUT"
    echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER)" >&2
    exit 3 ;;
  FAILED*)
    cat "$TMP_OUT"
    echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER)" >&2
    exit 3 ;;
  *)
    die "unrecognized status header: $HEADER" ;;
esac

if [[ "$INPUT_KIND" == "path" ]]; then
  path_verdict
else
  rk_synthetic_verdict
fi

# --- BEGIN concern-ID ledger + verdict-script block (issues #673 / #1992 / #1996) ---
# The ledger itself lives in bin/lib/concern-ledger.sh, reached through
# bin/concern-ledger. What stays here is what only this wrapper knows: the
# reviewer's on-the-wire concern form, the auto-rejection of out-of-scope
# findings, and the mapping from a tally to a verdict.
FINAL_EXIT=0
HIGH_N=0; MED_N=0; LOW_N=0

# A round enters the stage+reduce+dispatch path whenever the reviewer raised
# concerns (non-APPROVED). It ALSO enters when the verdict is APPROVED but this
# is a ref-kind (anchored) format whose ledger already holds prior C-entries: an
# empty codex delta is itself a signal (codex ran and re-raised nothing), so the
# ledger tally plus the per-producer provenance gate must decide whether those
# concerns resolve or persist stale (#2276 S8-d / N4). This holds on ROUND=1 too:
# an APPROVED re-review of committed work (#2344) opens as round 1 but must still
# reduce against the prior entries rather than delete them — so the guard keys on
# the presence of prior C-rows, not on ROUND >= 2. Silently deleting a ledger
# that still holds open concerns is never correct — a codex-only APPROVED pass
# must not erase a scanner-owned concern. Path-kind APPROVED, and a ref-kind
# APPROVED with no prior entries to adjudicate, keep the clean-exit shortcut
# (cleanup_ledger, exit 0).
NEEDS_LEDGER_PASS=0
if [[ ! "$VERDICT" =~ ^APPROVED($|[[:space:]]) ]]; then
  NEEDS_LEDGER_PASS=1
elif [[ "$INPUT_KIND" != "path" ]] && [[ -f "$LEDGER" ]] \
     && grep -qE '^C[0-9]+\|' "$LEDGER"; then
  NEEDS_LEDGER_PASS=1
fi

if (( NEEDS_LEDGER_PASS == 1 )); then
  # Exclusively created beside TMP_OUT, not the predictable "${TMP_OUT}.delta":
  # that name is derivable from a mktemp in the shared $TMPDIR (#2025 C6).
  DELTA_SRC="$(sp_mktemp_beside "$TMP_OUT")" \
    || die "cannot stage the round's concerns beside: $TMP_OUT"

  if [[ "$INPUT_KIND" == "path" ]]; then
    if [[ "$ROUND" == "1" ]]; then
      parse_round1_numbered
    else
      parse_round2_cnref
    fi
    STAGE_EXEC_ARGS=(--exec PERFORMED --parser "$PARSER")
  else
    # ref-kind: the whole raw output is the anchored delta; the exec label is
    # auto-derived from the reviewer header, so NO --exec is passed.
    rk_stage_anchored
    STAGE_EXEC_ARGS=(--parser "$PARSER")
  fi

  CL_NO_OPEN_CONCERNS="<!-- concern-ledger: no open concerns in round ${ROUND} -->"
  if [[ ! -s "$DELTA_SRC" ]]; then
    printf '%s\n' "$CL_NO_OPEN_CONCERNS" > "$DELTA_SRC" \
      || die "cannot write concern sentinel: $DELTA_SRC"
  fi

  if ! ledger_cli stage --round "$ROUND" --producer "$CL_PRODUCER_NAME" \
        "${STAGE_EXEC_ARGS[@]}" --from-report "$DELTA_SRC" >/dev/null 2>&1; then
    # The reviewer's own review still reaches the author even though the ledger
    # write failed: the halt (exit 4) is a wrapper fault, not a lost review.
    cat "$TMP_OUT"
    echo "run-codex-review-loop: failed to write ledger to $LEDGER" >&2
    rm -f "$DELTA_SRC"
    exit 4
  fi
  REDUCE_RC=0
  TALLY="$(ledger_cli reduce --round "$ROUND" 2>/dev/null)" || REDUCE_RC=$?
  rm -f "$DELTA_SRC"
  if (( REDUCE_RC != 0 )) || [[ -z "$TALLY" ]] || [[ ! -f "$LEDGER" ]]; then
    echo "run-codex-review-loop: round ${ROUND} could not be folded into the ledger (reduce rc=${REDUCE_RC}); refusing to judge it from the previous round's tally" >&2
    exit 4
  fi
  REDUCE_COMMITTED=true

  if [[ -f "$LEDGER" ]] && ! grep -qE '^C[0-9]+\|' "$LEDGER"; then
    echo "run-codex-review-loop: ledger exists but contains no valid concern entries after reduce (round ${ROUND}); refusing to judge from a header-only ledger" >&2
    exit 4
  fi

  # The tally the verdict reads is the ledger's own view of what is still open,
  # not a count of this round's bullets.
  for _kv in $TALLY; do
    case "$_kv" in
      open_high=*)   HIGH_N="${_kv#*=}" ;;
      open_medium=*) MED_N="${_kv#*=}" ;;
      open_low=*)    LOW_N="${_kv#*=}" ;;
    esac
  done
  [[ "$HIGH_N" =~ ^[0-9]+$ ]] || HIGH_N=0
  [[ "$MED_N"  =~ ^[0-9]+$ ]] || MED_N=0
  [[ "$LOW_N"  =~ ^[0-9]+$ ]] || LOW_N=0

  dispatch_codex_verdict
else
  cleanup_ledger
  FINAL_EXIT=0
fi
# --- END concern-ID ledger + verdict-script block ---

cat "$TMP_OUT"
FINAL_RC="$FINAL_EXIT"
exit "$FINAL_EXIT"
