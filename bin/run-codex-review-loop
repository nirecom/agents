#!/usr/bin/env bash
# bin/run-codex-review-loop
# Wrapper that enforces step b (context build) + step c (review-plan-codex)
# + step d (verdict parse) of skills/_shared/codex-review-loop.md.
#
# Exit codes (see skills/_shared/codex-review-loop.md for SSOT table):
#   0 — APPROVED (or silent LAND absorbed as approved)
#   1 — NON_APPROVED_VERDICT (NEEDS_REVISION / MISSING_ALTERNATIVE:)
#   2 — ESCALATE (risk signal present at budget ceiling)
#   3 — codex CLI unusable (SKIPPED / FAILED-other / verdict malformed)
#       -> caller silently falls back to REVIEWER_AGENT subagent
#   4 — wrapper / config / parser failure (unset AGENTS_CONFIG_DIR,
#       missing core-principles.md, missing arg, missing option value,
#       missing binaries, unrecognized status header, etc.)
#       -> caller MUST halt with blocking error; do NOT fall back.
#   5 — AUTO_EXTEND (budget available; caller increments EXTENSIONS_USED and re-enters)
set -uo pipefail

die() {
  echo "run-codex-review-loop: script error: $1" >&2
  exit 4
}

require_value() {
  local flag="$1"
  local val="${2-__MISSING__}"
  [[ "$val" != "__MISSING__" && -n "$val" ]] || die "$flag requires a value"
  [[ "$val" != --* ]] || die "$flag requires a value (got flag-like token: $val)"
}

# --- Pre-flight: AGENTS_CONFIG_DIR and core-principles.md ---
[[ -n "${AGENTS_CONFIG_DIR:-}" ]] || die "AGENTS_CONFIG_DIR is not set"
[[ -d "$AGENTS_CONFIG_DIR" ]]      || die "AGENTS_CONFIG_DIR does not exist: $AGENTS_CONFIG_DIR"
CORE_PRINCIPLES="$AGENTS_CONFIG_DIR/rules/core-principles.md"
[[ -f "$CORE_PRINCIPLES" ]] || die "required context missing: $CORE_PRINCIPLES"

CODEX_CORE="$AGENTS_CONFIG_DIR/bin/lib/codex-core.sh"
# shellcheck source=/dev/null
[[ -f "$CODEX_CORE" ]] && source "$CODEX_CORE"

FORMAT=""
SID=""
PLANS_DIR=""
DRAFT=""
CAP=""
MAX_EXT=""
EXT_USED="0"
TRADEOFFS=""
ROUND=""
LEDGER_OVERRIDE=""
EXTRA_CTX=()
REPO_ROOT_ARG=""
RISK_SIGNAL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --format)
      require_value "--format" "${2:-}"
      FORMAT="$2"; shift 2 ;;
    --session-id)
      require_value "--session-id" "${2:-}"
      SID="$2"; shift 2 ;;
    --plans-dir)
      require_value "--plans-dir" "${2:-}"
      PLANS_DIR="$2"; shift 2 ;;
    # Note: --draft-file is the path the planner wrote to (now the in-place final-artifact path).
    --draft-file)
      require_value "--draft-file" "${2:-}"
      DRAFT="$2"; shift 2 ;;
    --cap)
      require_value "--cap" "${2:-}"
      CAP="$2"; shift 2 ;;
    --max-extensions)
      require_value "--max-extensions" "${2:-}"
      MAX_EXT="$2"; shift 2 ;;
    --extensions-used)
      require_value "--extensions-used" "${2:-}"
      EXT_USED="$2"; shift 2 ;;
    --accepted-tradeoffs)
      require_value "--accepted-tradeoffs" "${2:-}"
      TRADEOFFS="$2"; shift 2 ;;
    --round)
      require_value "--round" "${2:-}"
      ROUND="$2"; shift 2 ;;
    --ledger)
      require_value "--ledger" "${2:-}"
      LEDGER_OVERRIDE="$2"; shift 2 ;;
    --context)
      require_value "--context" "${2:-}"
      EXTRA_CTX+=("$2"); shift 2 ;;
    --repo-root)
      require_value "--repo-root" "${2:-}"
      REPO_ROOT_ARG="$2"; shift 2 ;;
    --risk-signal)
      require_value "--risk-signal" "${2:-}"
      RISK_SIGNAL="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$FORMAT" ]]    || die "--format is required"
[[ -n "$SID" ]]       || die "--session-id is required"
[[ -n "$PLANS_DIR" ]] || die "--plans-dir is required"
[[ -n "$DRAFT" ]]     || die "--draft-file is required"
[[ -n "$CAP" ]]       || die "--cap is required"
[[ -n "$MAX_EXT" ]]   || die "--max-extensions is required"
[[ -n "$TRADEOFFS" ]] || die "--accepted-tradeoffs is required"
[[ -n "$ROUND" ]] || { echo "run-codex-review-loop: --round is required" >&2; exit 4; }
[[ "$ROUND" =~ ^[1-9][0-9]*$ ]] || { echo "run-codex-review-loop: --round must be a positive integer" >&2; exit 4; }

case "$FORMAT" in
  detail-plan|outline-plan|security-plan|test-review) ;;
  *) die "--format must be detail-plan, outline-plan, security-plan, or test-review" ;;
esac

[[ -f "$DRAFT" ]]     || die "draft file does not exist: $DRAFT"
[[ -d "$PLANS_DIR" ]] || die "plans dir does not exist: $PLANS_DIR"

if [[ -z "$REPO_ROOT_ARG" ]]; then
  REPO_ROOT_ARG="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [[ -n "$REPO_ROOT_ARG" ]] && [[ ! -d "$REPO_ROOT_ARG" ]]; then
  die "--repo-root is not a directory: $REPO_ROOT_ARG"
fi

BUILDER="$AGENTS_CONFIG_DIR/bin/build-codex-context"
REVIEWER="$AGENTS_CONFIG_DIR/bin/review-plan-codex"
[[ -f "$BUILDER" ]]  || die "build-codex-context not found: $BUILDER"
[[ -f "$REVIEWER" ]] || die "review-plan-codex not found: $REVIEWER"

mkdir -p "$PLANS_DIR" || die "cannot create PLANS_DIR: $PLANS_DIR"

CONTEXT_OUT="$PLANS_DIR/$SID-codex-context.md"
MARKER="$PLANS_DIR/$SID-codex-context.$FORMAT.built"
if [[ -n "$LEDGER_OVERRIDE" ]]; then
  LEDGER="$LEDGER_OVERRIDE"
else
  LEDGER="$PLANS_DIR/$SID-$FORMAT-concern-ledger.txt"
fi

# test-review: always rebuild context to avoid stale compacted-conversation bleed (#1376)
if [[ "$FORMAT" == "test-review" ]]; then
  if [[ -f "$MARKER" ]]; then
    echo "[run-codex-review-loop] test-review: clearing stale built marker for fresh context rebuild" >&2
  fi
  rm -f "$MARKER"
fi

if [[ ! -f "$MARKER" ]]; then
  if ! bash "$BUILDER" --plans-dir "$PLANS_DIR" --session-id "$SID" --output "$CONTEXT_OUT"; then
    die "build-codex-context failed"
  fi
  : > "$MARKER" || die "cannot create marker: $MARKER"
fi

ARGS=(
  --input "$DRAFT"
  --format "$FORMAT"
  --session-id "$SID"
  --log-dir "$PLANS_DIR"
  --cap "$CAP"
  --max-extensions "$MAX_EXT"
  --extensions-used "$EXT_USED"
  --accepted-tradeoffs "$TRADEOFFS"
  --round "$ROUND"
)

if [[ "$ROUND" -ge 2 ]]; then
  if [[ -f "$LEDGER" ]]; then
    ARGS+=(--ledger "$LEDGER")
  elif [[ -z "$LEDGER_OVERRIDE" ]]; then
    echo "run-codex-review-loop: ledger absent at round ${ROUND} — downgrading effective round to 1 (concern-ID continuity lost; see #748/#776)" >&2
    ROUND=1
    for i in "${!ARGS[@]}"; do
      if [[ "${ARGS[$i]}" == "--round" ]]; then
        ARGS[$((i+1))]="1"
        break
      fi
    done
  fi
fi

if [[ -f "$CONTEXT_OUT" && -s "$CONTEXT_OUT" ]]; then
  ARGS+=(--context "$CONTEXT_OUT")
fi

for ctx in "${EXTRA_CTX[@]+"${EXTRA_CTX[@]}"}"; do
  [[ -z "$ctx" ]] && continue
  if [[ -f "$ctx" && -s "$ctx" ]]; then
    ARGS+=(--context "$ctx")
  fi
done

ARGS+=(--context "$CORE_PRINCIPLES")

if [[ "${CODEX_MCP_FS:-}" != "off" ]] && [[ -n "$REPO_ROOT_ARG" ]]; then
  ARGS+=(--repo-root "$REPO_ROOT_ARG")
fi

TMP_OUT=$(mktemp) || die "mktemp failed"
trap 'rm -f "$TMP_OUT"' EXIT

bash "$REVIEWER" "${ARGS[@]}" > "$TMP_OUT"
RV=$?

if [[ $RV -ne 0 ]]; then
  echo "run-codex-review-loop: codex unavailable (review-plan-codex exited $RV)" >&2
  exit 3
fi

HEADER=$(awk 'NF{print; exit}' "$TMP_OUT" | tr -d '\r')

case "$HEADER" in
  "## Codex Plan Review: PERFORMED")
    : ;;
  "## Codex Plan Review: FAILED — round cap reached"*)
    echo "run-codex-review-loop: round cap reached" >&2
    exit 2 ;;
  "## Codex Plan Review: SKIPPED"*)
    echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER)" >&2
    exit 3 ;;
  "## Codex Plan Review: FAILED"*)
    echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER)" >&2
    exit 3 ;;
  *)
    die "unrecognized status header: $HEADER" ;;
esac

VERDICT=$(awk '
  /<!-- begin-codex-output/ { inblock=1; next }
  /<!-- end-codex-output -->/ { inblock=0; next }
  inblock && NF { print; exit }
' "$TMP_OUT" | tr -d '\r')

if [[ -z "$VERDICT" ]]; then
  echo "run-codex-review-loop: codex unavailable or verdict malformed (empty verdict block)" >&2
  exit 3
fi

# Validate verdict matches expected non-APPROVED keyword for the format
if [[ ! "$VERDICT" =~ ^APPROVED($|[[:space:]].+$) ]]; then
  case "$FORMAT" in
    detail-plan)
      [[ "$VERDICT" == "NEEDS_REVISION" ]] || {
        echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER, verdict=$VERDICT)" >&2
        exit 3
      } ;;
    outline-plan)
      [[ "$VERDICT" =~ ^MISSING_ALTERNATIVE: ]] || {
        echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER, verdict=$VERDICT)" >&2
        exit 3
      } ;;
    security-plan|test-review)
      [[ "$VERDICT" == "NEEDS_REVISION" ]] || {
        echo "run-codex-review-loop: codex unavailable or verdict malformed (header=$HEADER, verdict=$VERDICT)" >&2
        exit 3
      } ;;
  esac
fi

# --- BEGIN concern-ID ledger + verdict-script block (issues #673 / #1992 / #1996) ---
# The ledger itself lives in bin/lib/concern-ledger.sh, reached through
# bin/concern-ledger. What stays here is what only this wrapper knows: the
# reviewer's on-the-wire concern form, the auto-rejection of out-of-scope
# findings, and the mapping from a tally to a verdict.
FINAL_EXIT=0
HIGH_N=0; MED_N=0; LOW_N=0
CL_CLI=""
CL_PRODUCER_NAME="review-plan-codex"

# The reducer is a library shared with the code-review path, so its home is
# resolved rather than assumed: an AGENTS_CONFIG_DIR that predates #1992 does
# not carry it, and concern-ID continuity must not be lost to a stale or partial
# deployment. Each candidate must hold *both* halves — CLI and library — so a
# repository that merely happens to have a similarly named file cannot answer.
# "Both halves" includes the library's sibling module directory: the entrypoint
# is dispatch-only, so a root carrying just bin/lib/concern-ledger.sh is a
# partial deployment that aborts on load — it must lose to a complete one.
resolve_concern_ledger() {
  local root
  for root in "${AGENTS_CONFIG_DIR}" \
              "$(dirname "$(dirname "$(realpath "$0" 2>/dev/null || printf '%s' "$0")")")" \
              "${REPO_ROOT_ARG}" \
              "$(git rev-parse --show-toplevel 2>/dev/null || true)"; do
    [[ -n "$root" ]] || continue
    if [[ -f "$root/bin/concern-ledger" && -f "$root/bin/lib/concern-ledger.sh" \
          && -d "$root/bin/lib/concern-ledger" ]]; then
      CL_CLI="$root/bin/concern-ledger"
      return 0
    fi
  done
  return 1
}

# ledger_cli <subcommand> [args...] — every ledger operation in this wrapper
# addresses the same (plans-dir, session, format, ledger) tuple, so the
# addressing is written once and no call site can drift from it.
ledger_cli() {
  local sub="$1"; shift
  bash "$CL_CLI" "$sub" --plans-dir "$PLANS_DIR" --session-id "$SID" \
    --format "$FORMAT" --ledger "$LEDGER" "$@"
}

# finalize_ledger <mode> <reason> <would-be-verdict>
# The review has ended without converging, so the concerns that outlived it are
# written out as a machine-readable artifact. A finalize that cannot write is
# terminal for this wrapper: returning the verdict anyway would let the caller
# mark the step complete over findings nobody can read (fail-CLOSED).
finalize_ledger() {
  local mode="$1" reason="$2" wouldbe="$3" out msg rc=0
  out="$(ledger_cli finalize --mode "$mode" --reason "$reason" --round "$ROUND" \
      --cap "$CAP" --max-extensions "$MAX_EXT" --extensions-used "$EXT_USED" 2>&1)" || rc=$?
  [[ $rc -eq 0 ]] && return 0
  msg="$(printf '%s\n' "$out" | grep -F '## Concern Ledger: FINALIZE-FAILED — ' | head -n 1)"
  [[ -n "$msg" ]] || msg="## Concern Ledger: FINALIZE-FAILED — the unresolved-concerns artifact could not be written"
  msg="$msg (would-be verdict: $wouldbe)"
  cat "$TMP_OUT"
  printf '%s\n' "$msg"
  printf '%s\n' "$msg" >&2
  exit 7
}

if [[ ! "$VERDICT" =~ ^APPROVED($|[[:space:]]) ]]; then
  resolve_concern_ledger || die "concern-ledger not found under AGENTS_CONFIG_DIR (${AGENTS_CONFIG_DIR}), the wrapper's own directory, or the current repository"
  DELTA_SRC="${TMP_OUT}.delta"
  : > "$DELTA_SRC" || die "cannot stage the round's concerns: $DELTA_SRC"

  if [[ "$ROUND" == "1" ]]; then
    # Round 1: the reviewer numbers its own findings; this loop assigns the
    # concern IDs the later rounds refer back to.
    ID_COUNTER=0
    TRANSFORMED_CONTENT=""
    INBLOCK=0

    while IFS= read -r line; do
      if [[ "$line" =~ ^\<!--[[:space:]]*begin-codex-output ]]; then
        INBLOCK=1
        TRANSFORMED_CONTENT+="$line"$'\n'
        continue
      fi
      if [[ "$line" =~ ^\<!--[[:space:]]*end-codex-output ]]; then
        INBLOCK=0
        TRANSFORMED_CONTENT+="$line"$'\n'
        continue
      fi
      if [[ "$INBLOCK" -eq 1 ]] && \
         [[ "$line" =~ ^(C[0-9]+|[0-9]+)\.[[:space:]]\[(HIGH|MEDIUM|LOW)\][[:space:]](.+)$ ]]; then
        SEV="${BASH_REMATCH[2]}"
        TEXT="${BASH_REMATCH[3]}"
        VALIDATOR="${AGENTS_CONFIG_DIR}/bin/validate-hook-scope-concern"
        if [[ -x "$VALIDATOR" ]]; then
          REJECT_REASON=""
          if ! REJECT_REASON="$("$VALIDATOR" "$TEXT" 2>&1)"; then
            echo "run-codex-review-loop: auto-rejected concern ($(( ID_COUNTER + 1 ))): $REJECT_REASON" >&2
            TRANSFORMED_CONTENT+="<!-- auto-rejected: ${REJECT_REASON}: ${TEXT} -->"$'\n'
            continue
          fi
        fi
        ID_COUNTER=$((ID_COUNTER + 1))
        CN="C${ID_COUNTER}"
        printf '%s. [%s] %s\n' "$ID_COUNTER" "$SEV" "$TEXT" >> "$DELTA_SRC"
        TRANSFORMED_CONTENT+="${CN}. [${SEV}] ${TEXT}"$'\n'
      elif [[ "$INBLOCK" -eq 1 ]] && [[ "$line" =~ ^[0-9]+\.[[:space:]] ]]; then
        # Numbered line that did not match the full [HIGH|MEDIUM|LOW] format — format violation.
        echo "run-codex-review-loop: severity format violation in concern: $line" >&2
        exit 4
      else
        TRANSFORMED_CONTENT+="$line"$'\n'
      fi
    done < "$TMP_OUT"

    if [[ $ID_COUNTER -eq 0 ]]; then
      echo "run-codex-review-loop: NEEDS_REVISION with no parseable concerns" >&2
      exit 4
    fi

    # A round 1 that arrives on top of a live ledger is a new cycle, not a
    # collision: the previous cycle is archived rather than renumbered over.
    ledger_cli begin-round --round 1 >/dev/null 2>&1 || true
    PARSER="numbered"
    printf '%s' "$TRANSFORMED_CONTENT" > "$TMP_OUT"

  else
    # Round 2+: the reviewer may only speak about IDs the ledger already holds.
    [[ -f "$LEDGER" ]] || {
      echo "run-codex-review-loop: ledger missing for round ${ROUND} (expected at ${LEDGER})" >&2
      exit 4
    }

    declare -A LEDGER_IDS
    while IFS='|' read -r LID _; do
      case "$LID" in ''|'#'*) continue ;; esac
      LEDGER_IDS["$LID"]=1
    done < "$LEDGER"

    DISCARDED=()
    RETAINED_CONTENT=""
    INBLOCK=0

    while IFS= read -r line; do
      if [[ "$line" =~ ^\<!--[[:space:]]*begin-codex-output ]]; then
        INBLOCK=1
        RETAINED_CONTENT+="$line"$'\n'
        continue
      fi
      if [[ "$line" =~ ^\<!--[[:space:]]*end-codex-output ]]; then
        INBLOCK=0
        RETAINED_CONTENT+="$line"$'\n'
        continue
      fi
      if [[ "$INBLOCK" -eq 1 ]] && [[ "$line" =~ ^(C[0-9]+):[[:space:]]*(.*)$ ]]; then
        CID="${BASH_REMATCH[1]}"
        STATUS="${BASH_REMATCH[2]}"
        if [[ -v LEDGER_IDS["$CID"] ]]; then
          RETAINED_CONTENT+="$line"$'\n'
          # Only the lines that report a concern as still open become delta
          # records; an entry nobody restates is closed out by its absence.
          if [[ ! "$STATUS" =~ ^resolved($|[[:space:]]) ]]; then
            printf '%s\n' "$line" >> "$DELTA_SRC"
          fi
        else
          DISCARDED+=("$CID")
        fi
      else
        RETAINED_CONTENT+="$line"$'\n'
      fi
    done < "$TMP_OUT"

    if (( ${#DISCARDED[@]} > 0 )); then
      DISCARDED_STR=$(printf '%s\n' "${DISCARDED[@]}" | sort -V | paste -sd ',' - | sed 's/,/, /g')
      printf 'run-codex-review-loop: discarded new concern IDs in round %s: %s\n' \
        "$ROUND" "$DISCARDED_STR" >&2
    fi

    PARSER="cnref"
    printf '%s' "$RETAINED_CONTENT" > "$TMP_OUT"
  fi

  if ! ledger_cli stage --round "$ROUND" --producer "$CL_PRODUCER_NAME" \
        --exec PERFORMED --parser "$PARSER" --from-report "$DELTA_SRC" >/dev/null 2>&1; then
    echo "run-codex-review-loop: failed to write ledger to $LEDGER" >&2
    rm -f "$DELTA_SRC"
    exit 4
  fi
  ledger_cli reduce --round "$ROUND" >/dev/null 2>&1 || true
  rm -f "$DELTA_SRC"
  if [[ ! -s "$LEDGER" ]]; then
    echo "run-codex-review-loop: failed to write ledger to $LEDGER" >&2
    exit 4
  fi

  # The tally the verdict reads is the ledger's own view of what is still open,
  # not a count of this round's bullets: an entry the reviewer stopped
  # mentioning has been resolved, and one it re-raised is still one concern.
  TALLY="$(ledger_cli tally 2>/dev/null || true)"
  for _kv in $TALLY; do
    case "$_kv" in
      open_high=*)   HIGH_N="${_kv#*=}" ;;
      open_medium=*) MED_N="${_kv#*=}" ;;
      open_low=*)    LOW_N="${_kv#*=}" ;;
    esac
  done
  [[ "$HIGH_N" =~ ^[0-9]+$ ]] || HIGH_N=0
  [[ "$MED_N"  =~ ^[0-9]+$ ]] || MED_N=0
  [[ "$LOW_N"  =~ ^[0-9]+$ ]] || LOW_N=0

  VERDICT_BIN="${AGENTS_CONFIG_DIR}/bin/review-loop-verdict"
  [[ -x "$VERDICT_BIN" ]] || {
    echo "run-codex-review-loop: review-loop-verdict not found or not executable: $VERDICT_BIN" >&2
    exit 4
  }
  BUDGET_REMAINING=$(( MAX_EXT - EXT_USED ))
  VERDICT_ARGS=("$ROUND" "$HIGH_N" "$MED_N" "$LOW_N" "--budget-remaining" "$BUDGET_REMAINING")
  [[ -n "$RISK_SIGNAL" ]] && VERDICT_ARGS+=("--risk-signal" "$RISK_SIGNAL")
  VERDICT_DECISION=$("$VERDICT_BIN" "${VERDICT_ARGS[@]}")
  VERDICT_RC=$?
  : "${VERDICT_DECISION:=}"

  case "$VERDICT_RC" in
    0)
      rm -f "$LEDGER"
      FINAL_EXIT=0
      ;;
    1)
      if declare -f codex_core_hard_cap_check > /dev/null 2>&1; then
        _LOG="$PLANS_DIR/$SID-plan.jsonl"
        if ! codex_core_hard_cap_check "$_LOG" "$SID" "$FORMAT" "$CAP" "$EXT_USED" "$MAX_EXT" > /dev/null 2>&1; then
          finalize_ledger escalate "hard round cap reached without convergence" 2
          FINAL_EXIT=2
        else
          FINAL_EXIT=1
        fi
      else
        FINAL_EXIT=1
      fi
      ;;
    2)
      finalize_ledger escalate "risk signal present at the budget ceiling" 2
      FINAL_EXIT=2
      ;;
    3)
      # LAND: silent land — absorbed as approved
      rm -f "$LEDGER"
      FINAL_EXIT=0
      ;;
    4)
      echo "run-codex-review-loop: review-loop-verdict argument error (round=$ROUND high=$HIGH_N med=$MED_N low=$LOW_N)" >&2
      exit 4
      ;;
    5)
      # AUTO_EXTEND: keep ledger — loop continues
      FINAL_EXIT=5
      ;;
    *)
      echo "run-codex-review-loop: review-loop-verdict unexpected exit: $VERDICT_RC" >&2
      exit 4
      ;;
  esac

  # The last round the caller is allowed to run has ended unresolved: there is
  # no next round to carry the ledger, so this is where it is finalized.
  if [[ "$FINAL_EXIT" == "1" ]] && (( ROUND >= CAP )); then
    finalize_ledger terminal "round cap reached without convergence" 1
  fi
else
  rm -f "$LEDGER"
  FINAL_EXIT=0
fi
# --- END concern-ID ledger + verdict-script block ---

cat "$TMP_OUT"
exit "$FINAL_EXIT"
