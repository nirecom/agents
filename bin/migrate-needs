#!/usr/bin/env node
"use strict";
// bin/migrate-needs [--root <dir>] — what /migrate still has to run in the target repo.
// Prints NEEDED=<comma-separated migrate-* skills, in run order>, UNCOMMITTED=0|1 (.agents.json is
// untracked or changed), UNPUSHED=0|1 (a commit of .agents.json is ahead of origin/<branch>) and
// HOST=github|gitlab|unknown (empty unless tracker or issues is needed) and MALFORMED=0|1
// (.agents.json exists but is not a JSON object; bin/repo-settings --reset-malformed repairs it).
// Exit: 0 printed, 1 the target is not a git checkout, 2 bad arguments. Judgments: bin/lib/migrate-needs.js.

const path = require("path");
const { collect } = require(path.join(__dirname, "lib", "migrate-needs.js"));

const argv = process.argv.slice(2);
let root = process.cwd();
if (argv.length > 0) {
  if (argv.length !== 2 || argv[0] !== "--root" || !argv[1]) {
    process.stderr.write("usage: migrate-needs [--root <dir>]\n");
    process.exit(2);
  }
  root = argv[1];
}

let r;
try {
  r = collect(root);
} catch (e) {
  process.stderr.write(`migrate-needs: ${e.message}\n`);
  process.exit(1);
}
process.stdout.write(`NEEDED=${r.needed.map((k) => `migrate-${k}`).join(",")}\nUNCOMMITTED=${r.uncommitted}\nUNPUSHED=${r.unpushed}\nHOST=${r.host}\nMALFORMED=${r.malformed}\n`);
