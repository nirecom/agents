#!/usr/bin/env node
"use strict";
// bin/review-rounds — CLI of the step-wide review record (#2938 D5). Dispatch only: the record
// lives in bin/lib/codex-review-loop/review-rounds-store.js, classification in review-rounds.js.
// Exit: 0 ok, 2 usage / rejected value, 3 cannot derive (derive-ext), 4 HALT, 5 row parked (append;
// append --no-park parks nothing and is 4), 6 pm-review round cap reached (append --request writes nothing).

const fs = require("fs");
const path = require("path");
const { spawnSync } = require("child_process");
const LIB = path.join(__dirname, "lib", "codex-review-loop");
const store = require(path.join(LIB, "review-rounds-store"));
const rounds = require(path.join(LIB, "review-rounds"));
const { readInterval } = require(path.join(LIB, "state-interval"));
const PMW = () => require(path.join(__dirname, "..", "hooks", "lib", "pm-review-writer"));

// Flags that take no value.
const SWITCHES = new Set(["no-park", "request", "high"]);
const EXIT_PM_REVIEW_CAP = 6;
const PM_VERDICTS = ["OK", "NOT_OK"];

function parse(argv) {
  const o = {};
  for (let i = 0; i < argv.length; i++) {
    const m = /^--([a-z-]+)$/.exec(argv[i]);
    if (!m) throw new store.StoreError(2, `unexpected argument: ${argv[i]}`);
    if (SWITCHES.has(m[1])) { o[m[1]] = true; continue; }
    o[m[1]] = argv[i + 1];
    i += 1;
  }
  return o;
}

const need = (o, ...keys) => {
  for (const k of keys) if (o[k] === undefined || o[k] === "") throw new store.StoreError(2, `--${k} is required`);
};
const int = (v, name) => {
  if (!/^-?\d+$/.test(String(v))) throw new store.StoreError(2, `--${name} must be an integer: ${v}`);
  return Number(v);
};
const optInt = (v, name) => (v === undefined || v === "" ? null : int(v, name));
const base = (o) => ({ sid: o.session, format: o.format });

// pm-review rows (#3144 S1-4): the CLI decides counter_round and source; a caller's value is never used.
// The caller is this process's session (CLAUDE_CODE_SESSION_ID); the judge runs before the lock and again
// under it (skipIf), so a row two writers race for is written once.
function pmReviewAppend(o) {
  const W = PMW();
  const caller = process.env.CLAUDE_CODE_SESSION_ID || ""; // session-id-ssot: waived (cli-entry-point) — the writing session is the caller, not --session
  const refused = (code, reason) => { throw new store.StoreError(code, `pm-review append refused: ${reason}`); };
  const rowBase = { sid: o.session, format: W.FORMAT, exit: null, state_sid: o.session, untilSeq: null };
  if (o.request === true) {
    const j = W.judgeRequestWrite({ callerSid: caller, targetSid: o.session, pmSid: o["pm-sid"], pr: o.pr === undefined ? "" : o.pr });
    if (!j.ok) refused(/^cap-reached/.test(j.reason) ? EXIT_PM_REVIEW_CAP : 2, j.reason);
    const head = spawnSync("git", ["rev-parse", "HEAD"], { cwd: process.cwd(), encoding: "utf8", timeout: 10000, windowsHide: true });
    const fp = head.status === 0 ? String(head.stdout).trim() : "";
    if (!W.FP_RE.test(fp)) refused(2, "the HEAD SHA of the current directory cannot be read");
    const row = store.appendRow(Object.assign(rowBase, {
      counter_round: j.round, verdict: W.VERDICT_REQUESTED, source: W.SOURCE_REQUEST_PREFIX + j.pmSid,
      run_id: W.PR_RUN_PREFIX + Number(o.pr), fingerprint: fp, writer_sid: caller,
      skipIf: (parsed) => { const n = W.nextRoundAllowed(parsed.filter(Boolean)); return n.ok && n.round + 1 === j.round ? null : { skipped: n.reason || "round-moved" }; },
    }));
    if (row.skipped) refused(EXIT_PM_REVIEW_CAP, row.skipped);
    return `counter_round=${row.counter_round}`;
  }
  if (!PM_VERDICTS.includes(o.verdict)) refused(2, `--verdict must be one of ${PM_VERDICTS.join("|")}`);
  const target = { round: o.round, fingerprint: o.fingerprint, pr: o.pr };
  const j = W.judgePmWrite({ callerSid: caller, targetSid: o.session, kind: W.FORMAT, target });
  if (!j.ok) refused(2, j.reason);
  const round = Number(o.round);
  const verdict = o.verdict === "NOT_OK" && o.high === true && round === rounds.PM_REVIEW_CAP ? W.VERDICT_AUTO_EXTEND : o.verdict;
  const row = store.appendRow(Object.assign(rowBase, {
    counter_round: round, verdict, source: W.SOURCE_PM, run_id: W.PR_RUN_PREFIX + Number(o.pr), fingerprint: o.fingerprint,
    writer_sid: caller,
    skipIf: (parsed) => { const s = W.roundState(parsed.filter(Boolean)); return s.round === round && s.request && !s.pmRow && !s.userRow ? null : { skipped: "round-moved" }; },
  }));
  if (row.skipped) refused(2, row.skipped);
  return `counter_round=${row.counter_round} verdict=${row.verdict}`;
}

const COMMANDS = {
  append: (o) => {
    if (o.format === "pm-review") return pmReviewAppend(o);
    need(o, "counter-round", "exit", "verdict", "source", "run-id");
    store.appendFromWrapper(Object.assign(base(o), {
      counter_round: int(o["counter-round"], "counter-round"), exit: int(o.exit, "exit"), verdict: o.verdict,
      source: o.source, run_id: o["run-id"], fingerprint: o.fingerprint || null, noPark: o["no-park"] === true,
    }));
  },
  "has-run": (o) => { need(o, "run-id"); return `recorded=${store.hasRun(Object.assign(base(o), { runId: o["run-id"] })) ? 1 : 0}`; },
  "inflight-close": (o) => { need(o, "run-id"); store.closeInflight(Object.assign(base(o), { runId: o["run-id"] })); },
  "accept-gap": (o) => { need(o, "reason"); return `accepted=${store.acceptGap(Object.assign(base(o), { reason: o.reason }))}`; },
  preflight: (o) => store.preflight(base(o)),
  summary: (o) => {
    const s = rounds.summarize({ sid: o.session, format: o.format });
    const lines = ["rows", "current_cycle", "extensions_used", "duplicate_rows", "unreadable_rows"].map((k) => `${k}=${s[k]}`);
    lines.push(`explore=${s.by_kind.explore}`, `confirm=${s.by_kind.confirm}`, `codex=${s.by_source.codex}`, `cc_fallback=${s.by_source.cc_fallback}`);
    for (const f of s.fingerprints) lines.push(`fingerprint ${f.loop_cycle} ${f.row_no} ${f.counter_round} ${f.fingerprint}`);
    return lines.join("\n");
  },
  "derive-ext": (o) => {
    need(o, "counter-round");
    const v = rounds.deriveExtensions(o.session, o.format, int(o["counter-round"], "counter-round"));
    if (v === null) throw new store.StoreError(3, "the review record cannot derive EXTENSIONS_USED for this cycle");
    return `extensions_used=${v}`;
  },
  "older-input": (o) => {
    need(o, "ledger");
    const text = fs.existsSync(o.ledger) ? fs.readFileSync(o.ledger, "utf8") : "";
    return rounds.olderInput(store.readRows(o.session, o.format).parsed, text, o.fingerprint || null)
      .map((c) => `${c.id} ${c.round}`).join("\n");
  },
  interval: (o) => {
    const iv = readInterval(o.session, optInt(o["since-seq"], "since-seq") || 0, optInt(o["until-seq"], "until-seq"),
      o.format ? { format: o.format, sinceAt: o["since-at"] || null } : {});
    return ["state", "head_seq", "has_reset", "has_write_code", "has_audit_block"]
      .map((k) => `${k}=${typeof iv[k] === "boolean" ? Number(iv[k]) : iv[k]}`).concat(`kinds=${iv.kinds.join(",")}`).join("\n");
  },
};

function main(argv) {
  const cmd = COMMANDS[argv[0]];
  if (!cmd) throw new store.StoreError(2, `usage: review-rounds <${Object.keys(COMMANDS).join("|")}> --session S --format F ...`);
  const o = parse(argv.slice(1));
  need(o, "session");
  if (argv[0] !== "interval") need(o, "format");
  const out = cmd(o);
  if (out) process.stdout.write(`${out}\n`);
}

try {
  main(process.argv.slice(2));
} catch (e) {
  process.stderr.write(`review-rounds: ${e.message}\n`);
  process.exit(e instanceof store.StoreError ? e.code : 4);
}
