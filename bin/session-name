#!/usr/bin/env node
"use strict";
// bin/session-name — print the session name for a manual /rename (#2668).
//
// Usage:
//   session-name --kind work|none [--session <sid>] -- <args>
//   session-name --kind pm [--session <sid>]
//
//   work  <args> are issue refs (#A #B …); the title of #A is fetched.
//   pm    no <args> (they exit 2). The name is built from the session's PM state and its issue-title
//         record the way the UserPromptSubmit hook builds it (the recorded title first); the record
//         is never written. --session defaults to CLAUDE_CODE_SESSION_ID.
//   none  <args> are ignored; the repo name comes from the origin of the cwd (else its basename).
// --session adds the " sid-xxxxxxxx" suffix of a UUID session id. Keep the suffix on a /rename:
// find-peer matches the name by it.
//
// Prints the name on one line and exits 0. Exits 2 on a malformed request, 1 when no name can be
// made (no ref, the title cannot be fetched, no PM mark, or no confirmed record); the reason goes to stderr.

const path = require("path");
const HOOKS = path.join(__dirname, "..", "hooks");
const SN = require(path.join(HOOKS, "lib", "session-name"));
const { parseIssueTokens } = require(path.join(HOOKS, "lib", "parse-closes-issues"));
const { resolveSessionId } = require(path.join(HOOKS, "workflow-state", "session-id"));
const TOOL = "session-name";

function fail(code, message) {
  process.stderr.write(`${TOOL}: ${message}\n`);
  process.exit(code);
}

function parseArgs(argv) {
  const o = { kind: null, session: null, rest: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--") { o.rest = argv.slice(i + 1); break; }
    if (a === "--kind") o.kind = argv[++i] || null;
    else if (a === "--session") o.session = argv[++i] || null;
    else fail(2, `unknown argument: ${a}`);
  }
  if (!SN.KINDS.includes(o.kind)) fail(2, `--kind must be one of ${SN.KINDS.join("|")}`);
  if (o.kind === "pm") {
    if (o.rest.length > 0) fail(2, "--kind pm takes no arguments after --");
    if (o.session === null) o.session = resolveSessionId() || null;
    if (!o.session) fail(2, "--kind pm needs --session <sid> or CLAUDE_CODE_SESSION_ID");
  }
  if (o.session !== null && !/^[A-Za-z0-9_-]+$/.test(o.session)) fail(2, "--session must match /^[A-Za-z0-9_-]+$/");
  return o;
}

function main() {
  const o = parseArgs(process.argv.slice(2));
  const { toWindowsPath } = require(path.join(HOOKS, "lib", "branch-diff"));
  const T = require(path.join(HOOKS, "user-prompt-submit-issue-title", "title"));
  const cwd = toWindowsPath(process.cwd());
  if (o.kind === "none") {
    const repo = T.repoFor(cwd);
    if (!repo) fail(1, "no repo name: neither an origin nor a cwd basename");
    process.stdout.write(`${SN.composeSessionName({ kind: "none", repo, sessionId: o.session })}\n`);
    return;
  }
  if (o.kind === "pm") {
    process.stdout.write(`${pmName(o.session, cwd, T)}\n`);
    return;
  }
  const refs = parseIssueTokens(o.rest.join(" "));
  if (refs.length === 0) fail(1, "no issue ref in the arguments");
  const rec = { v: 1, last_emitted: null, titles: {}, failures: {} };
  const title = T.titleFor(refs[0], rec, {}, cwd, Date.now());
  if (!title) fail(1, `the title of ${SN.refLabel(refs[0])} could not be fetched`);
  process.stdout.write(`${SN.composeSessionName({ kind: "work", refs, title, sessionId: o.session })}\n`);
}

// pmName(sid, cwd, T) -> the hook's PM name for sid, from the same inputs as title.run; never writes.
function pmName(sid, cwd, T) {
  const { readState } = require(path.join(HOOKS, "workflow-state"));
  const { hasPmMark } = require(path.join(HOOKS, "pm-session", "schema"));
  const { targetFor } = require(path.join(HOOKS, "user-prompt-submit-issue-title", "target"));
  const { recordSid, readRecord } = require(path.join(HOOKS, "user-prompt-submit-issue-title", "record"));
  const state = readState(sid);
  if (!hasPmMark(state)) fail(1, `session ${sid} has no PM mark`);
  const recSid = recordSid(sid, state);
  if (!recSid) fail(1, `session ${sid} has no confirmed root, so the hook names it neither`);
  const name = T.candidateFor(targetFor(sid, state, ""), readRecord(recSid), {}, cwd, Date.now(), sid);
  if (!name) fail(1, "no name: the title of the first issue could not be fetched and there is no objective");
  return name;
}

main();
