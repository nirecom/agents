#!/usr/bin/env bash
":" //; : <<'AGENTS_NODE_GUARD'
// #1532 node-misinvocation guard -- keep intact; never write */ in this file.
// Why it is shaped this way, and how to edit it: docs/agents-repo-dev.md
const msg = process.argv[1] + ": this is a bash script, not a Node program." +
  " Re-run it as: bash " + process.argv[1] + " [args...]\n";
for (let i = 0; i < 100; i++) {
  try { require("fs").writeSync(2, msg); break; }
  catch (err) { if (err.code !== "EAGAIN") break; }
}
process.exitCode = 70;
/*
AGENTS_NODE_GUARD
# Usage:
#   get-config-var <NAME> [<default>]
#       Prints the raw resolved value to stdout (or nothing). Exits 0.
#       Value mode never interprets the value: for an on/off flag use
#       `get-config-var --is-off <NAME> <default>` or bin/confirm-off instead.
#       <default> applies only when NAME has no export and no .env value.
#   get-config-var --is-off <NAME> [<default>]
#       Exit 0 (OFF) | 1 (explicit ON) | 2 (unset, no default given) |
#       3 (unrecognized value, stderr warning) | 4 (internal failure, including
#       node cannot start or hooks/lib/config-flag.js cannot be loaded).
#       The '&& echo OFF || echo ON' shell idiom is one possible caller convention —
#       fail-safe-ON, mapping exit 0 → OFF and 1/2/3/4 → ON. Callers wanting
#       fail-safe-OFF instead should check $? explicitly and treat ONLY exit code 1
#       as ON, every other code as OFF. This repo's SESSION_SYNC call sites use the
#       fail-safe-OFF pattern deliberately.
#   Usage error (missing NAME arg): exit 64.
#
# The resolution and the on/off classification are owned by hooks/lib/config-flag.js,
# always the one beside this script (symlinks followed); bin/confirm-off is a sibling
# wrapper over the same module. Process env wins over .env (parity with load-env.js).
# This is the opposite of bin/env-effective-kv, which never reads process.env — callers
# resolving a prompt-bound value (e.g. PROJECT_NFR) that must not be forgeable by an
# inline `VAR=x` shell prefix should use env-effective-kv instead of this script.

set -u

CF_MODE="value"
CF_REPO_ROOT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --is-off) CF_MODE="kind"; shift ;;
    --repo-root)
      if [ $# -lt 2 ]; then
        printf 'usage: get-config-var [--is-off] [--repo-root <path>] <NAME> [<default>]\n' >&2
        exit 64
      fi
      CF_REPO_ROOT="$2"; shift 2 ;;
    *) break ;;
  esac
done

CF_NAME="${1:-}"
CF_DEFAULT="${2:-}"

if [ -z "$CF_NAME" ]; then
  printf 'usage: get-config-var [--is-off] <NAME> [<default>]\n' >&2
  exit 64
fi

# config-flag bootstrap: begin
CF_OUT="$(CONFIG_FLAG_MODE="$CF_MODE" CONFIG_FLAG_NAME="$CF_NAME" CONFIG_FLAG_DEFAULT="$CF_DEFAULT" CONFIG_FLAG_REPO_ROOT="$CF_REPO_ROOT" node -e '
  const fs = require("fs"); const path = require("path"); const e = process.env;
  const a = { mode: e.CONFIG_FLAG_MODE || "value", name: e.CONFIG_FLAG_NAME || "", defaultValue: e.CONFIG_FLAG_DEFAULT || "", repoRoot: e.CONFIG_FLAG_REPO_ROOT || "" };
  for (const k of ["CONFIG_FLAG_MODE", "CONFIG_FLAG_NAME", "CONFIG_FLAG_DEFAULT", "CONFIG_FLAG_REPO_ROOT"]) delete e[k];
  function toNative(p) {
    if (process.platform !== "win32" || p.charAt(0) !== "/") return p;
    const m = /^\/([A-Za-z])\//.exec(p);
    if (m) return m[1] + ":/" + p.slice(3);
    // MSYS_NO_PATHCONV=1 left an MSYS mount path: map the prefix env PWD shares with the native cwd.
    let px = String(e.PWD || ""); let wd = process.cwd();
    while (px.length > 1 && path.basename(px) === path.basename(wd) && path.dirname(wd) !== wd) { px = path.posix.dirname(px); wd = path.dirname(wd); }
    if (px.charAt(0) !== "/") return p;
    if (px === "/") return path.join(wd, p);
    return p === px || p.startsWith(px + "/") ? path.join(wd, p.slice(px.length)) : p;
  }
  let lib = null;
  try {
    const self = fs.realpathSync(toNative(String(process.argv[1] || "")));
    lib = require(path.join(path.dirname(self), "..", "hooks", "lib", "config-flag.js"));
  } catch (_e) { lib = null; }
  if (lib) lib.runCli(a);
  else if (a.mode === "kind") process.stdout.write("failed lib-missing");
  else if (a.mode === "verdict") process.stdout.write("ERROR lib-missing");
  else { const x = e[a.name]; process.stdout.write(x && x.length ? x : a.defaultValue); }
' "${BASH_SOURCE[0]}")"
# config-flag bootstrap: end

if [ "$CF_MODE" = "kind" ]; then
  case "$CF_OUT" in
    off) exit 0 ;;
    on) exit 1 ;;
    unset) exit 2 ;;
    unrecognized) exit 3 ;;
    *) exit 4 ;;
  esac
fi

printf '%s' "$CF_OUT"
# End of the #1532 node-misinvocation guard envelope -- docs/agents-repo-dev.md
# */
