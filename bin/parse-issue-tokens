#!/usr/bin/env node
'use strict';
const path = require('path');
try {
  const { parseIssueTokens } = require(
    path.join(path.dirname(__dirname), 'hooks', 'lib', 'parse-closes-issues.js')
  );
  console.log(JSON.stringify(parseIssueTokens(process.argv.slice(2).join(' '))));
} catch (e) {
  process.stderr.write('[parse-issue-tokens] ' + e.message + '\n');
  console.log('[]');
  process.exit(0); // never-abort
}
