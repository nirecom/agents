#!/usr/bin/env node
"use strict";

const {
  resolveSessionId,
  readState,
  VALID_STEPS,
  isLookaheadOnlyInFlightState,
  isEffectivelyPendingStep,
} = require("../hooks/workflow-state");
const { LOOKAHEAD_PREINIT_STEP } = require("../hooks/lib/step-in-flight-policy");
const { USAGE, parseResumeArgs } = require("./lib/resume-session/args");

const STEP_TO_SKILL = Object.freeze({
  workflow_init:  "workflow-init",
  clarify_intent: "clarify-intent",
  outline:        "make-outline-plan",
  detail:         "make-detail-plan",
  write_tests:    "write-tests",
  run_tests:      "run-tests",
  docs:           "update-docs",
  cleanup:        "worktree-end",
});

// The WI-10 lookahead can only ever synthesize LOOKAHEAD_PREINIT_STEP, and only on
// a session that has recorded nothing else. Any OTHER step carrying the same
// origin is #2013's mark on a genuinely interrupted dispatch, which still resumes.
function isPreInitLookaheadArtifact(state, step) {
  if (step !== LOOKAHEAD_PREINIT_STEP) return false;
  if (!isLookaheadOnlyInFlightState(state, step)) return false;
  for (const other of VALID_STEPS) {
    if (other !== step && !isEffectivelyPendingStep(state, other)) return false;
  }
  return true;
}

function detect() {
  const sessionId = resolveSessionId();
  if (!sessionId) return { type: "none", reason: "session_id_unresolved" };

  const state = readState(sessionId);
  if (!state || !state.steps) return { type: "none", reason: "no_state" };

  for (const step of VALID_STEPS) {
    const s = (state.steps[step] || {}).status;
    if (s === "in_progress") {
      if (isPreInitLookaheadArtifact(state, step)) continue;
      if (STEP_TO_SKILL[step]) return { type: "skill", step, skill: STEP_TO_SKILL[step] };
      return { type: "sentinel-wait", step, hint: step };
    }
  }
  return { type: "none", reason: "no_in_progress" };
}

function emit(result) {
  process.stdout.write(JSON.stringify(result) + "\n");
}

// Exit 3 — not 1 — for an unknown upstream id: the caller must distinguish
// "that session left nothing behind" from "this command was called wrongly".
function runFrom(from) {
  const { buildUpstreamView } = require("./lib/resume-session/upstream-view");
  const view = buildUpstreamView({ heirSid: resolveSessionId(), upstreamSid: from });
  emit(view);
  process.exit(view.availability === "none" ? 3 : 0);
}

function runList(query, limit) {
  const { listUpstreamCandidates } =
    require("../hooks/workflow-state/upstream-search");
  const { heirContextOf } = require("./lib/resume-session/upstream-view");
  const sid = resolveSessionId();
  // Same resolver as the `--from` path, so both agree on the heir's cwd/branch.
  const ctx = heirContextOf({ heirSid: sid });
  const candidates = listUpstreamCandidates({ heirSid: sid, ctx, query, limit });
  emit({ type: "list", query: query || "", candidates });
  process.exit(0);
}

function main() {
  const parsed = parseResumeArgs(process.argv.slice(2));
  if (parsed.mode === "help") {
    process.stdout.write(USAGE);
    process.exit(0);
  }
  if (parsed.mode === "version") {
    process.stdout.write("resume-session-detect 2\n");
    process.exit(0);
  }
  if (parsed.mode === "error") {
    process.stderr.write(parsed.error + "\n");
    process.exit(1);
  }
  if (parsed.mode === "from") return runFrom(parsed.from);
  if (parsed.mode === "list") return runList(parsed.query, parsed.limit);
  emit(detect());
  process.exit(0);
}

if (require.main === module) {
  main();
}

module.exports = { STEP_TO_SKILL, resolveSessionId, detect };
