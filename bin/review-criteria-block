#!/usr/bin/env bash
# CLI wrapper so CC reviewers can call codex_core_review_criteria_block via a single
# Bash tool invocation. Output is byte-equal to the direct codex-path call.
set -euo pipefail
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/codex-core.sh
source "$_dir/lib/codex-core.sh"
codex_core_review_criteria_block "${1:-}" || exit 1
