#!/usr/bin/env bash
# Inline procedure block review (rules/prompt.md §1.3).
# Usage: check-inline-procedures [--base <ref>] [--all]
#
# Thin adapter over bin/check-prompt-extraction (issue #1642). That CLI is the
# single owner of detection semantics, the target set and the thresholds (CPR-2);
# this script only preserves the historical output contract for existing callers.
#
# Always emits one of:
#   ## Inline Procedure Review: PERFORMED
#   ## Inline Procedure Review: PERFORMED (all-scan mode)
#   ## Inline Procedure Review: SKIPPED — <reason>
#
# Advisory only — always exits 0 (WARN findings do not block).
set -uo pipefail

HEADER="## Inline Procedure Review"
BASE_REF="origin/main"
BASE_EXPLICIT=0
ALL_SCAN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL_SCAN=1; shift ;;
    --base)
      if [[ $# -lt 2 ]]; then
        echo "$HEADER: SKIPPED (--base requires an argument)"; exit 0
      fi
      BASE_REF="$2"; BASE_EXPLICIT=1; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; shift ;;
  esac
done

if [[ "$ALL_SCAN" -eq 1 && "$BASE_EXPLICIT" -eq 1 ]]; then
  echo "$HEADER: SKIPPED — --base and --all are mutually exclusive"; exit 0
fi

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _target="$(readlink "$_self")"
  case "$_target" in
    /*) _self="$_target" ;;
    *) _self="$(dirname "$_self")/$_target" ;;
  esac
done
ENGINE="$(cd "$(dirname "$_self")" && pwd)/check-prompt-extraction"

if [[ ! -f "$ENGINE" ]]; then
  echo "$HEADER: SKIPPED — engine not found"; exit 0
fi

if [[ "$ALL_SCAN" -eq 1 ]]; then
  ENGINE_ARGS=(--all)
else
  ENGINE_ARGS=(--base "$BASE_REF")
fi

RC=0
OUT="$(bash "$ENGINE" --kind inline-procedure --advisory "${ENGINE_ARGS[@]}" 2>/dev/null)" || RC=$?

if [[ "$RC" -ne 0 ]]; then
  echo "$HEADER: SKIPPED — engine exited $RC (base: $BASE_REF)"; exit 0
fi

printf '%s\n' "$OUT" \
  | sed -e 's/^## Prompt Extraction Review:/## Inline Procedure Review:/' -e 's/^HARD:/WARN:/'
exit 0
