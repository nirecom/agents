#!/usr/bin/env bash
# Code file size review. Usage: review-code-size [--base <ref>] [--all] [--staged]
# bin/size-check owns counting, target filtering and the limits (SSOT hooks/lib/size-limits.js).
# --staged judges the staged blobs against HEAD (a commit that performs a split passes); diff mode
# judges the working tree against the merge-base. Over HARD exits 1 unless the file shrinks;
# --all always exits 0. --staged excludes --all/--base. Extensions: CODE_FILE_EXTENSIONS ("js;sh;py").
# Emits "## Code-size Review: PERFORMED[ (all-scan mode| staged mode)]" or "...: SKIPPED — <reason>";
# a bin/size-check infrastructure error emits "## Code-size Review: ERROR" and exits 2.

set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib/review-size.sh"

HDR="## Code-size Review"
HARD_HIT=0
_EXTS="${CODE_FILE_EXTENSIONS:-js;sh;py}"

BASE_REF="origin/main"
BASE_EXPLICIT=0
ALL_SCAN=0
STAGED_ONLY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL_SCAN=1; shift ;;
    --staged) STAGED_ONLY=1; shift ;;
    --base)
      if [[ $# -lt 2 ]]; then
        echo "$HDR: SKIPPED (--base requires an argument)"; exit 0
      fi
      BASE_REF="$2"; BASE_EXPLICIT=1; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; shift ;;
  esac
done

if [[ "$ALL_SCAN" -eq 1 && "$BASE_EXPLICIT" -eq 1 ]]; then
  echo "$HDR: SKIPPED — --base and --all are mutually exclusive"; exit 0
fi

if [[ "$STAGED_ONLY" -eq 1 && ( "$ALL_SCAN" -eq 1 || "$BASE_EXPLICIT" -eq 1 ) ]]; then
  echo "$HDR: SKIPPED — --staged is mutually exclusive with --all/--base"; exit 0
fi

report_records() {
  local verdict value pre warn hard unit file
  echo ""
  echo "[Line counts]"
  while IFS=$'\t' read -r verdict value pre warn hard unit file; do
    case "$verdict" in
      HARD)
        echo "  HARD: $file — $value lines total (exceeds ${hard}-line hard limit; split into <name>/ sibling folder — see rules/coding/file-split.md)"
        HARD_HIT=1 ;;
      SHRINK) echo "SHRINK: $file — $value lines (over the ${hard}-line hard limit, down from $pre; reducing changes pass)" ;;
      WARN) echo "WARN: $file — $value lines (exceeds ${warn}-line warn threshold)" ;;
      OK) echo "INFO: $file — $value lines" ;;
    esac
  done <<< "$RS_RECORDS"
  echo ""
  echo "  HARD findings block the workflow (exit 1) in diff mode. WARN/INFO are advisory."
}

if [[ "$ALL_SCAN" -eq 1 ]]; then
  review_size_check "$HDR" code none worktree < <(find . -type f \
    -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | sort | review_size_worktree_nul)
  if [[ "$RS_TARGETS" -eq 0 ]]; then
    echo "$HDR: SKIPPED — no code files found"; exit 0
  fi
  echo "$HDR: PERFORMED (all-scan mode)"
  echo ""
  echo "All code files scanned: $RS_TARGETS (extensions: $_EXTS)"
  report_records
  exit 0
fi

if [[ "$STAGED_ONLY" -eq 1 ]]; then
  # -z + core.quotePath=false: non-ASCII and special-char paths arrive as raw NUL-separated bytes.
  review_size_check "$HDR" code "$(review_size_pre_head)" index < <(git -c core.quotePath=false diff -z \
    --name-only --cached --diff-filter=ACMRT 2>/dev/null || true)
  if [[ "$RS_TARGETS" -eq 0 ]]; then
    echo "$HDR: SKIPPED — no code files staged"; exit 0
  fi
  echo "$HDR: PERFORMED (staged mode)"
  echo ""
  echo "Changed code files: $RS_TARGETS (extensions: $_EXTS)"
  report_records
  [[ "$HARD_HIT" -eq 1 ]] && exit 1 || exit 0
fi

BASE_SHA=$(git merge-base "$BASE_REF" HEAD 2>/dev/null) || {
  echo "$HDR: SKIPPED (merge-base unresolved: $BASE_REF)"; exit 0
}

ERR=$(mktemp)
trap 'rm -f "$ERR"' EXIT
git diff --name-only --diff-filter=ACMRT "$BASE_SHA"...HEAD >/dev/null 2>"$ERR" || true
if [[ -s "$ERR" ]]; then
  echo "$HDR: SKIPPED (git diff failed: $(cat "$ERR"))"; exit 0
fi

review_size_check "$HDR" code "rev:$BASE_SHA" worktree < <(review_size_changed_nul "$BASE_SHA")
if [[ "$RS_TARGETS" -eq 0 ]]; then
  echo "$HDR: SKIPPED — no code files changed"; exit 0
fi

echo "$HDR: PERFORMED"
echo ""
echo "Changed code files: $RS_TARGETS (extensions: $_EXTS)"
report_records

[[ "$HARD_HIT" -eq 1 ]] && exit 1 || exit 0
