#!/usr/bin/env node
// bin/plan-link [--session <sid>] [--stage intent|outline|detail]
// Prints the plan-link line of each plan stage, one line per stage (hooks/lib/plan-link.js
// entryLine): the blob URL with the local path, the local path with a reason word, or
// "<stage>: (unavailable: <reason>)" when the plan file is absent. The session defaults to
// the current session (hooks/workflow-state resolveSessionId). Read-only and network-free: it never fetches, pushes or writes.
// Exit: 0 at least one plan file resolved; 1 no plan file, or no usable session; 2 usage error.
"use strict";
const path = require("path");

const PL = require(path.join(__dirname, "..", "hooks", "lib", "plan-link.js"));
const { resolveSessionId } = require(path.join(__dirname, "..", "hooks", "workflow-state"));

function die(code, msg) {
  process.stderr.write(`plan-link: ${msg}\n`);
  process.exit(code);
}

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a !== "--session" && a !== "--stage") die(2, `unknown argument: ${a}`);
    if (i + 1 >= argv.length || argv[i + 1].startsWith("--")) die(2, `${a} needs a value`);
    const v = argv[++i];
    if (a === "--session") out.session = v;
    else if (!PL.STAGES.includes(v)) die(2, `--stage must be one of ${PL.STAGES.join(", ")}`);
    else out.stage = v;
  }
  return out;
}

const args = parseArgs(process.argv.slice(2));
const sid = args.session !== undefined ? args.session : resolveSessionId() || "";
if (!sid) die(1, "no session (pass --session <id>, or run inside a session with CLAUDE_CODE_SESSION_ID set)");
if (!PL.isSessionId(sid)) die(1, "not a session id");

let plansDir;
try {
  plansDir = require(path.join(__dirname, "..", "hooks", "lib", "workflow-plans-dir.js")).getWorkflowPlansDir();
} catch (_) {
  die(1, "cannot resolve the plans dir");
}

const links = (args.stage ? [args.stage] : PL.STAGES).map((stage) => ({ stage, ...PL.resolvePlanLink(sid, stage, { plansDir }) }));
process.stdout.write(links.map(PL.entryLine).join("\n") + "\n");
process.exit(links.some((l) => l.path) ? 0 : 1);
