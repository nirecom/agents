#!/usr/bin/env bash
# bin/github-issues/issue-provenance — classify HOW the current issue creation was asked for.
#
#   issue-provenance --consume
#     stdout : user-explicit | mid-workflow      (one word, the classification)
#     stderr : layer: A|B|C|none                 (which observation point fired)
#     exit   : always 0                          (a classifier never blocks the caller)
#
#   issue-provenance --result
#     Read-only replay of the decision --consume already reached for this turn.
#     Consumes nothing, so any number of downstream gates may ask independently
#     instead of trusting a value handed to them. An absent, expired, malformed or
#     never-written record answers mid-workflow.
#
# Three observation points, all of them observations of a USER turn — never a
# self-report by the model:
#   A  a provenance token minted by hooks/issue-provenance-mint.js at turn boundary
#   B  a re-scan of the newest HUMAN transcript entry (same pattern module)
#   C  the workflow is not active, so "mid-workflow" is false by definition
#
# All three share ONE single-use consumption record, so a user turn authorizes at
# most one creation. Anything unreadable, unwritable or unresolvable degrades to
# mid-workflow: the unprivileged answer is always the safe answer here.
#
# ISSUE_PROVENANCE=off disables the whole mechanism: both modes answer mid-workflow
# without touching disk. `off` therefore lowers privilege, never raises it.

set -euo pipefail

AGENTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if command -v cygpath >/dev/null 2>&1; then
    AGENTS_DIR_NODE="$(cygpath -m "$AGENTS_DIR")"
else
    AGENTS_DIR_NODE="$AGENTS_DIR"
fi

MODE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --consume) MODE="consume"; shift ;;
        --result) MODE="result"; shift ;;
        -h|--help)
            sed -n '2,26p' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        *) shift ;;
    esac
done

unprivileged() {
    printf 'mid-workflow\n'
    printf 'layer: none\n' >&2
    exit 0
}

[[ "$MODE" == "consume" || "$MODE" == "result" ]] || unprivileged

# The kill switch, resolved the same way every other switch in this repo is
# (process env wins over .env). Unreadable config degrades to `on`, which only
# means the classifier still runs — it never grants anything by itself.
SWITCH="$("$AGENTS_DIR/bin/get-config-var" ISSUE_PROVENANCE on 2>/dev/null || printf 'on')"
SWITCH="$(printf '%s' "$SWITCH" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
if [[ "$SWITCH" == "off" ]]; then
    unprivileged
fi

# The whole decision is one node program: every input it needs (marker paths, the
# request patterns, the workflow state reader) already has a module in hooks/lib,
# and re-deriving any of them in shell would fork the SSOT.
CLASSIFY_JS='
"use strict";
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const root = process.argv[1];
const mode = process.argv[2] === "result" ? "result" : "consume";
const lib = (m) => require(path.join(root, "hooks", "lib", m));

// The decided verdict is replayable for as long as the token that could have
// produced it would have been valid.
const RESULT_TTL_MS = 15 * 60 * 1000;

let paths = null;
let fingerprint = null;

// The decision record (#1763 G3). Downstream gates must be able to ask "what was
// decided for this turn?" without either consuming the turn a second time or
// believing a value the model typed. Writing it is best-effort: a decision that
// cannot be recorded simply is not replayable, and unreplayable reads mid-workflow.
function writeResult(verdict, layer) {
  if (mode !== "consume" || paths === null) return;
  const now = Date.now();
  const tmp = paths.result + ".tmp";
  try {
    fs.writeFileSync(
      tmp,
      JSON.stringify({
        provenance: verdict,
        layer: layer,
        fingerprint: fingerprint,
        decided_at: new Date(now).toISOString(),
        expires_at: new Date(now + RESULT_TTL_MS).toISOString(),
      }) + "\n",
      { mode: 0o600 }
    );
    fs.renameSync(tmp, paths.result);
  } catch (e) {
    try { fs.unlinkSync(tmp); } catch (e2) {}
  }
}

function out(verdict, layer) {
  writeResult(verdict, layer);
  process.stdout.write(verdict + "\n");
  process.stderr.write("layer: " + layer + "\n");
  process.exit(0);
}

let sid = null;
try {
  sid = require(path.join(root, "hooks", "workflow-state")).resolveSessionId({});
} catch (e) {
  sid = null;
}

const { provenanceKeys, provenancePaths } = lib("issue-provenance-keys");
const keys = provenanceKeys(sid);
if (keys.length === 0) out("mid-workflow", "none");
const key = keys[0];

try {
  paths = provenancePaths(key);
} catch (e) {
  paths = null;
  out("mid-workflow", "none");
}

// --- read-only replay --------------------------------------------------------
if (mode === "result") {
  let rec = null;
  try {
    rec = JSON.parse(fs.readFileSync(paths.result, "utf8"));
  } catch (e) {
    rec = null;
  }
  if (rec && typeof rec === "object" && rec.provenance === "user-explicit") {
    const exp = Date.parse(rec.expires_at);
    if (Number.isFinite(exp) && exp > Date.now()) {
      out("user-explicit", /^[ABC]$/.test(rec.layer) ? rec.layer : "none");
    }
  }
  out("mid-workflow", "none");
}

// --- the turn fingerprint (the single-use unit) ------------------------------
// "<lineIndex>:<sha256(rawLine)>" of the newest HUMAN entry. Absent transcript,
// absent pointer, or no human entry at all → no fingerprint, and without one
// nothing can be consumed, so nothing may be issued.

// `type:"user"` is not the same thing as "the user said this": tool results, meta
// injections and slash-command stdout are all recorded under it. Taking the newest
// such entry blindly would fingerprint a tool call rather than a turn — which both
// breaks per-turn single use and means layer B re-scans machine text.
function isHumanTurn(entry) {
  if (!entry || entry.type !== "user") return false;
  if (entry.isMeta === true) return false;
  if (entry.toolUseResult !== undefined) return false;
  const content = entry.message ? entry.message.content : null;
  if (typeof content === "string") return content.trim().length > 0;
  if (!Array.isArray(content)) return false;
  let hasText = false;
  for (const block of content) {
    if (!block || typeof block !== "object") continue;
    if (block.type === "tool_result") return false;
    if (block.type === "text" && typeof block.text === "string" && block.text.trim()) {
      hasText = true;
    }
  }
  return hasText;
}

function latestHumanEntry() {
  let transcriptPath;
  try {
    transcriptPath = fs.readFileSync(paths.transcript, "utf8").trim();
  } catch (e) {
    return null;
  }
  if (!transcriptPath) return null;
  let lines;
  try {
    lines = fs.readFileSync(transcriptPath, "utf8").split(/\r?\n/);
  } catch (e) {
    return null;
  }
  for (let i = lines.length - 1; i >= 0; i--) {
    const raw = lines[i];
    if (!raw || !raw.trim()) continue;
    let entry;
    try {
      entry = JSON.parse(raw);
    } catch (e) {
      continue;
    }
    if (!isHumanTurn(entry)) continue;
    const text = entryText(entry);
    // A replay of command stdout is not an utterance.
    if (/^\s*<local-command-stdout>/.test(text)) continue;
    const fp = i + ":" + crypto.createHash("sha256").update(raw).digest("hex");
    return { fingerprint: fp, text: text };
  }
  return null;
}

function entryText(entry) {
  const content = entry && entry.message ? entry.message.content : null;
  if (typeof content === "string") return content;
  if (Array.isArray(content)) {
    return content
      .map((b) => (b && typeof b.text === "string" ? b.text : ""))
      .join("\n");
  }
  return "";
}

let latest = null;
try {
  latest = latestHumanEntry();
} catch (e) {
  latest = null;
}
fingerprint = latest ? latest.fingerprint : null;

const { isConsumed, recordConsumed } = lib("issue-provenance-consumed");

// consume(layer): the record IS the single-use boundary for every layer, so a
// record that cannot be written means the turn cannot be spent — and an unspendable
// turn may not be elevated either.
function consume(layer) {
  if (!fingerprint) {
    // Layer A is the one layer whose evidence is itself single-use: the token was
    // minted at the turn boundary by a hook and has just been unlinked, so it cannot
    // be presented a second time even when the turn cannot be fingerprinted (no
    // transcript pointer, unreadable transcript). One turn still authorizes one
    // creation. B and C own no such artifact — with no fingerprint they have nothing
    // to spend, and an unspendable turn may not be elevated.
    if (layer !== "A") out("mid-workflow", "none");
    out("user-explicit", layer);
  }
  if (isConsumed(key, fingerprint)) return false;
  if (!recordConsumed(key, fingerprint)) out("mid-workflow", "none");
  out("user-explicit", layer);
}

// --- layer A: the minted token ----------------------------------------------
// Read, then unlink UNCONDITIONALLY: a token that failed validation must not be
// left on disk for a later attempt to retry.
const markers = lib("session-markers");
let token = null;
try {
  token = markers.readIssueProvenance(key);
} catch (e) {
  token = null;
}
let unlinked = true;
try {
  fs.unlinkSync(paths.token);
} catch (e) {
  // ENOENT is the normal case (no token, or already spent). Anything else means a
  // token we cannot remove — i.e. one that could be presented again — so it must
  // not be honoured now either.
  unlinked = !!(e && e.code === "ENOENT");
}
let tokenValid = false;
try {
  tokenValid = markers.evaluateIssueProvenance(token, "issue-create", key);
} catch (e) {
  tokenValid = false;
}
if (tokenValid && unlinked) {
  // Same boundary as layers B and C (CPR-5): the turn must be spendable, and it
  // must actually be spent, before the token means anything.
  consume("A");
}

// --- layer B: re-scan of the newest human entry ------------------------------
if (fingerprint && !isConsumed(key, fingerprint)) {
  let matched = false;
  try {
    matched = lib("issue-request-patterns").isIssueCreationRequest(latest.text);
  } catch (e) {
    matched = false;
  }
  if (matched) consume("B");
}

// --- layer C: no workflow is in flight ---------------------------------------
let active = true;
try {
  active = lib("workflow-activity").isWorkflowActive();
} catch (e) {
  active = true;
}
if (!active) consume("C");

out("mid-workflow", "none");
'

if ! node -e "$CLASSIFY_JS" "$AGENTS_DIR_NODE" "$MODE"; then
    # node missing, or an unforeseen throw: the classifier still has to answer.
    printf 'mid-workflow\n'
    printf 'layer: none\n' >&2
fi
exit 0
