#!/usr/bin/env bash
# Entry point for the prompt-extraction gate (issue #1642).
# Thin delegator: bin/lib/prompt-extraction/cli.js owns every decision (CPR-2).
#
# AGENTS_CONFIG_DIR is deliberately NOT consulted here. The engine lives next to
# this script, so the script location is the only correct resolver: a fixture or
# foreign repo may export AGENTS_CONFIG_DIR at some other checkout while invoking
# this exact file (CPR-8 — no implicit environment branching).
set -euo pipefail

_pe_self="${BASH_SOURCE[0]}"
while [[ -L "$_pe_self" ]]; do
  _pe_target="$(readlink "$_pe_self")"
  case "$_pe_target" in
    /*) _pe_self="$_pe_target" ;;
    *) _pe_self="$(dirname "$_pe_self")/$_pe_target" ;;
  esac
done
_pe_root="$(cd "$(dirname "$_pe_self")/.." && pwd)"

exec node "$_pe_root/bin/lib/prompt-extraction/cli.js" "$@"
