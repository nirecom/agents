#!/usr/bin/env node
// bin/cc-session-title — VS Code session title CLI
// Subcommands:
//   set-issue [cwd] <plansDir>      → writeSetIssue
//   add-pr [cwd] <prNumber>         → writeAddPr
//   mark-complete [cwd]             → writeMarkComplete
//
// <cwd> is optional and defaults to process.cwd(): the callers are prompt
// procedures, and requiring it forced every one of them to issue `"$(pwd)"` —
// a command substitution the bash-guard denies (#2132).
//
// Session ID is resolved via the shared resolveSessionId() (hooks/workflow-state/
// session-id.js) — single source of truth for the resolution chain, which reads
// CLAUDE_CODE_SESSION_ID before the JSONL mtime scan (#1082).
//
// All errors are silently swallowed. Exit code always 0.

"use strict";

const path = require("path");

try {
  const agentsDir = path.join(__dirname, "..");
  const { writeSetIssue, writeAddPr, writeMarkComplete } = require(
    path.join(agentsDir, "hooks", "lib", "session-title")
  );
  const { resolveSessionId } = require(
    path.join(agentsDir, "hooks", "workflow-state", "session-id")
  );

  // When invoked from Claude Code's Bash tool, CLAUDE_CODE_CHILD_SESSION=1 is
  // inherited, causing _isChildSession() in session-title.js to suppress all
  // writes. Unset it here so the CLI operates as a top-level caller.
  delete process.env.CLAUDE_CODE_CHILD_SESSION;

  const [, , subcmd, ...args] = process.argv;

  if (!subcmd) process.exit(0);

  // One optional leading <cwd>: two tokens mean the caller passed it, one means
  // it omitted it and the process CWD is already the directory it meant.
  const withCwd = (a) => (a.length >= 2 ? [a[0], a[1]] : [process.cwd(), a[0]]);

  switch (subcmd) {
    case "set-issue": {
      const [cwd, plansDir] = withCwd(args);
      if (!cwd || !plansDir) process.exit(0);
      const sessionId = resolveSessionId();
      if (sessionId) {
        writeSetIssue(sessionId, cwd, plansDir);
      }
      break;
    }
    case "add-pr": {
      const [cwd, prNumber] = withCwd(args);
      if (!cwd || !prNumber) process.exit(0);
      const sessionId = resolveSessionId();
      if (sessionId) {
        writeAddPr(sessionId, cwd, String(prNumber));
      }
      break;
    }
    case "mark-complete": {
      const cwd = args[0] || process.cwd();
      if (!cwd) process.exit(0);
      const sessionId = resolveSessionId();
      if (sessionId) {
        writeMarkComplete(sessionId, cwd);
      }
      break;
    }
    default:
      // Unknown subcommand — exit 0 (fail-open)
      break;
  }
} catch (_) {
  // Fail-open: any error is silently swallowed
}

process.exit(0);
